{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M-EXRxResult",
  "type": "object",
  "required": ["case_id", "system", "status", "plan", "trace"],
  "properties": {
    "case_id": { "type": "string" },
    "system": { "type": "string" },
    "status": { "enum": ["answered", "partial_answer", "ask_clarification", "refused"] },
    "plan": { "type": "string" },
    "trace": { "$ref": "../rule_spec/trace_schema.json" }
  }
}
