               <rdf:li>Accelerometry</rdf:li>
               <rdf:li>Co-physical activity</rdf:li>
               <rdf:li>Moderate-to-vigorous physical activity</rdf:li>
               <rdf:li>Self-determination theory</rdf:li>
               <rdf:li>Hierarchical linear models</rdf:li>
               <rdf:li>Health-related quality of life</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Improving childrenâ€™s fundamental movement skills through a family-based physical activity program: results from the â€œActive 1â€‰+â€‰FUNâ€ randomized controlled trial</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Amy S. Ha</rdf:li>
               <rdf:li>Chris Lonsdale</rdf:li>
               <rdf:li>David R. Lubans</rdf:li>
               <rdf:li>Florrie F. Ng</rdf:li>
               <rdf:li>Johan Y. Y. Ng</rdf:li>
            </rdf:Seq>
         </dc:creator>
