y caused by tran-\nsient strain or altered myocyte metabolism instead of\nirreversible cardiac myocyte necrosis or ischem", "language": "en", "quality_tier": "peer_reviewed_study", "domain_pack": "injury_prevention_and_rehab", "review_status": "auto_classified", "needs_review": false, "prescription_permission": "explanation_only", "evidence_weight": "moderate", "auto_classification_basis": "quality_tier", "can_write_core": false}
