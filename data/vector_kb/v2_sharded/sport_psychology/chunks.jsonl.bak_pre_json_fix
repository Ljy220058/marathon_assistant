{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_psych_interventions_meta_2024_0001", "source_registry_id": "src_sport_psychology_psych_interventions_meta_2024", "source_file": "psychological_interventions_sport_performance_meta_2024.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_label": "Psychological interventions for sports performance systematic review and meta-analysis", "quality_tier": "systematic_review_meta_analysis", "page": 1, "paragraph_index": 1, "keywords_en": ["sport psychology", "psychological intervention", "performance", "mental skills"], "text": "Psychological interventions for sport performance should be treated as explanatory mental-skills support. The review evidence supports using structured psychological techniques to influence performance-related outcomes, but these techniques do not authorize changes to running volume, intensity, injury decisions, or nutrition prescriptions. Use for confidence, attention, coping, and preparation notes only."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_self_talk_imagery_goal_setting_2024_0002", "source_registry_id": "src_sport_psychology_psych_interventions_meta_2024", "source_file": "psychological_interventions_sport_performance_meta_2024.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_label": "Psychological interventions for sports performance systematic review and meta-analysis", "quality_tier": "systematic_review_meta_analysis", "page": 1, "paragraph_index": 2, "keywords_en": ["self-talk", "imagery", "goal setting", "mental skills", "visualization"], "text": "Common mental-skills categories in sport psychology include self-talk, imagery or visualization, goal setting, relaxation or arousal regulation, and attentional strategies. In a marathon assistant these can be surfaced as brief coping scripts, process-goal reminders, or race-preparation prompts, while remaining separate from planner and executor training prescriptions."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_ioc_mental_health_boundary_2019_0003", "source_registry_id": "src_ioc_mental_health_elite_athletes_2019", "source_file": "ioc_consensus_mental_health_elite_athletes_2019.url", "source_path": "https://bjsm.bmj.com/content/53/11/667", "source_url": "https://bjsm.bmj.com/content/53/11/667", "source_label": "IOC consensus statement on mental health in elite athletes", "quality_tier": "consensus_statement", "page": 1, "paragraph_index": 1, "keywords_en": ["mental health", "athlete", "clinical boundary", "referral", "psychology"], "text": "The IOC consensus statement frames athlete mental health as a clinical and safeguarding domain when symptoms are persistent, severe, or impairing. The psychologist role in this system must not diagnose anxiety, depression, or other clinical states; it should provide non-clinical sport psychology references and recommend professional mental-health support when distress is ongoing or outside training-preparation scope."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_goal_setting_oxford_2019_0004", "source_registry_id": "src_goal_setting_sport_performance_oxford_2019", "source_file": "goal_setting_sport_performance_oxford_2019.url", "source_path": "https://oxfordre.com/psychology/display/10.1093/acrefore/9780190236557.001.0001/acrefore-9780190236557-e-152", "source_url": "https://oxfordre.com/psychology/display/10.1093/acrefore/9780190236557.001.0001/acrefore-9780190236557-e-152", "source_label": "Goal Setting and Performance in Sport and Exercise Settings", "quality_tier": "expert_review", "page": 1, "paragraph_index": 1, "keywords_en": ["goal setting", "process goals", "performance goals", "motivation"], "text": "Goal-setting literature in sport and exercise distinguishes outcome, performance, and process goals. For running plans, the psychology role should favor process goals and controllable execution cues because they support adherence and focus without altering the training prescription generated by planner and executor."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_attentional_focus_framework_1977_0005", "source_registry_id": "src_attentional_focus_endurance_running_review_2014", "source_file": "attentional_focus_endurance_running_review_2014.url", "source_path": "https://www.semanticscholar.org/paper/Associative-and-dissociative-cognitive-strategies-Masters-Ogles/0b6318c8ff819907d9a8f3412d13fa10c9342c97", "source_url": "https://www.semanticscholar.org/paper/Associative-and-dissociative-cognitive-strategies-Masters-Ogles/0b6318c8ff819907d9a8f3412d13fa10c9342c97", "source_label": "Associative and Dissociative Cognitive Strategies in Exercise and Running: 20 Years Later, What Do We Know? — Masters & Ogles (1998)", "quality_tier": "peer_reviewed_review", "page": 1, "paragraph_index": 1, "keywords_en": ["attentional focus", "associative", "dissociative", "marathon", "pacing"], "text": "Morgan and Pollock (1977) introduced the foundational distinction between associative and dissociative attentional strategies in marathon runners. Elite runners predominantly used associative strategies — monitoring bodily sensations such as breathing rate, muscular tension, and perceived effort — while non-elite runners more often used dissociative strategies to distract themselves from discomfort. In a marathon assistant context, this research supports offering attention-management cues that match the runner's training stage and experience level."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_attentional_focus_elite_vs_novice_0006", "source_registry_id": "src_attentional_focus_endurance_running_review_2014", "source_file": "attentional_focus_endurance_running_review_2014.url", "source_path": "https://www.semanticscholar.org/paper/Associative-and-dissociative-cognitive-strategies-Masters-Ogles/0b6318c8ff819907d9a8f3412d13fa10c9342c97", "source_url": "https://www.semanticscholar.org/paper/Associative-and-dissociative-cognitive-strategies-Masters-Ogles/0b6318c8ff819907d9a8f3412d13fa10c9342c97", "source_label": "Associative and Dissociative Cognitive Strategies in Exercise and Running: 20 Years Later, What Do We Know? — Masters & Ogles (1998)", "quality_tier": "peer_reviewed_review", "page": 1, "paragraph_index": 2, "keywords_en": ["attentional focus", "elite runners", "novice runners", "experience", "pacing"], "text": "Research consistently finds that attentional strategy use is related more to running experience than to sex or baseline fitness. Experienced recreational runners are more adept at diverting attention away from unpleasant bodily cues, while inexperienced runners report more focus on internal body sensations and find this monitoring distressing rather than useful. The psychologist node should calibrate its attention-management suggestions to the runner's stated experience level in their profile."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_attentional_focus_performance_link_0007", "source_registry_id": "src_attentional_focus_endurance_running_review_2014", "source_file": "attentional_focus_endurance_running_review_2014.url", "source_path": "https://www.semanticscholar.org/paper/Associative-and-dissociative-cognitive-strategies-Masters-Ogles/0b6318c8ff819907d9a8f3412d13fa10c9342c97", "source_url": "https://www.semanticscholar.org/paper/Associative-and-dissociative-cognitive-strategies-Masters-Ogles/0b6318c8ff819907d9a8f3412d13fa10c9342c97", "source_label": "Associative and Dissociative Cognitive Strategies in Exercise and Running: 20 Years Later, What Do We Know? — Masters & Ogles (1998)", "quality_tier": "peer_reviewed_review", "page": 1, "paragraph_index": 3, "keywords_en": ["attentional focus", "performance", "pacing", "RPE", "running economy"], "text": "Multiple studies report that associative attentional strategies correlate with faster marathon performance because continuous monitoring of perceived effort enables more accurate real-time pacing. Dissociative strategies correlate with lower rating of perceived exertion (RPE) and can improve running economy in the short term, but may lead to pacing errors over long distances. For runners targeting a specific finish time, associative attention cues may be more beneficial in the final race phase."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_attentional_focus_external_novice_2016_0008", "source_registry_id": "src_frontiers_attentional_focus_endurance_2019", "source_file": "frontiers_attentional_focus_endurance_2019.url", "source_path": "https://frontiersin.org/articles/10.3389/fpsyg.2019.00535/full", "source_url": "https://frontiersin.org/articles/10.3389/fpsyg.2019.00535/full", "source_label": "Action Monitoring Through External or Internal Focus of Attention Does Not Impair Endurance Performance — Frontiers in Psychology 2019", "quality_tier": "peer_reviewed_study", "page": 1, "paragraph_index": 1, "keywords_en": ["external focus", "dissociative", "novice runners", "running economy", "attention"], "text": "A ScienceDirect (2016) study found that for inexperienced runners, directing attention to an external environmental target — scenery, music, a point ahead — produced the lowest oxygen consumption and RPE compared with focusing on breathing or stride mechanics. The finding challenges the assumption that beginners should focus on form cues; for early-stage runners, external dissociative attention may reduce perceived effort and sustain motivation. Marathon assistant psychologist suggestions should reflect this distinction when the runner is in early base-building phases."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_attentional_focus_two_dimensions_1998_0009", "source_registry_id": "src_attentional_focus_endurance_running_review_2014", "source_file": "attentional_focus_endurance_running_review_2014.url", "source_path": "https://www.semanticscholar.org/paper/Associative-and-dissociative-cognitive-strategies-Masters-Ogles/0b6318c8ff819907d9a8f3412d13fa10c9342c97", "source_url": "https://www.semanticscholar.org/paper/Associative-and-dissociative-cognitive-strategies-Masters-Ogles/0b6318c8ff819907d9a8f3412d13fa10c9342c97", "source_label": "Associative and Dissociative Cognitive Strategies in Exercise and Running: 20 Years Later, What Do We Know? — Masters & Ogles (1998)", "quality_tier": "peer_reviewed_review", "page": 2, "paragraph_index": 1, "keywords_en": ["attentional focus", "internal", "external", "associative", "dissociative", "taxonomy"], "text": "Stevinson and Biddle (1998) proposed a two-dimensional taxonomy of attentional focus in running: internal vs. external, and task-related vs. non-task-related. This refined the original associative/dissociative binary and better captures how runners actually shift their attention during a race. Practical application: a runner might use internal-associative focus (monitoring leg fatigue) in final miles but benefit from external-dissociative focus (crowd energy) when motivation is flagging at mid-race."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_attentional_focus_chunking_race_0010", "source_registry_id": "src_attentional_focus_endurance_running_review_2014", "source_file": "attentional_focus_endurance_running_review_2014.url", "source_path": "https://www.semanticscholar.org/paper/Associative-and-dissociative-cognitive-strategies-Masters-Ogles/0b6318c8ff819907d9a8f3412d13fa10c9342c97", "source_url": "https://www.semanticscholar.org/paper/Associative-and-dissociative-cognitive-strategies-Masters-Ogles/0b6318c8ff819907d9a8f3412d13fa10c9342c97", "source_label": "Associative and Dissociative Cognitive Strategies in Exercise and Running: 20 Years Later, What Do We Know? — Masters & Ogles (1998)", "quality_tier": "peer_reviewed_review", "page": 2, "paragraph_index": 2, "keywords_en": ["attentional focus", "chunking", "race segmentation", "distance management", "pacing strategy"], "text": "A practical application of attentional focus research for marathon runners is race segmentation or 'chunking': mentally dividing the race into smaller, manageable units and applying specific attentional strategies to each segment. Elite runners commonly adopt an associative internal focus for the first half to establish correct pacing, then shift to external dissociative strategies in the difficult middle miles, and return to internal associative monitoring in the final 10 km. This tiered approach is supported by applied sport psychology literature."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_attentional_focus_practical_cues_0011", "source_registry_id": "src_frontiers_attentional_focus_endurance_2019", "source_file": "frontiers_attentional_focus_endurance_2019.url", "source_path": "https://frontiersin.org/articles/10.3389/fpsyg.2019.00535/full", "source_url": "https://frontiersin.org/articles/10.3389/fpsyg.2019.00535/full", "source_label": "Action Monitoring Through External or Internal Focus of Attention Does Not Impair Endurance Performance — Frontiers in Psychology 2019", "quality_tier": "peer_reviewed_study", "page": 1, "paragraph_index": 2, "keywords_en": ["attentional cues", "running form", "breath", "rhythm", "focus keyword"], "text": "Practical attention-focus cues for marathon runners include: (1) associative cues — 'check in with your breathing every 10 minutes', 'scan for unnecessary tension in shoulders and hands', 'notice your cadence'; (2) external dissociative cues — 'look at the horizon rather than your feet', 'use crowd energy as fuel in the final 5 km'. The psychologist node should offer these as brief preparation scripts or in-training reminders, not as instructions to modify pace or volume."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_attentional_focus_mental_fatigue_0012", "source_registry_id": "src_frontiers_attentional_focus_endurance_2019", "source_file": "frontiers_attentional_focus_endurance_2019.url", "source_path": "https://frontiersin.org/articles/10.3389/fpsyg.2019.00535/full", "source_url": "https://frontiersin.org/articles/10.3389/fpsyg.2019.00535/full", "source_label": "Action Monitoring Through External or Internal Focus of Attention Does Not Impair Endurance Performance — Frontiers in Psychology 2019", "quality_tier": "peer_reviewed_study", "page": 2, "paragraph_index": 1, "keywords_en": ["mental fatigue", "attentional focus", "cognitive load", "performance decrement", "endurance"], "text": "Mental fatigue before exercise measurably reduces endurance running speed and time-to-exhaustion, independent of physiological readiness. Research demonstrates this effect operates through increased perception of effort — the brain interprets tasks as harder when cognitively depleted. Practical implication: a runner who has had a cognitively demanding workday should receive attention management suggestions that include a brief pre-session mental reset routine rather than assuming the same focus strategy will work every day."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_self_talk_endurance_overview_2014_0013", "source_registry_id": "src_selftalk_endurance_blanchfield_2014", "source_file": "selftalk_endurance_blanchfield_2014.url", "source_path": "https://pubmed.ncbi.nlm.nih.gov/24121242/", "source_url": "https://pubmed.ncbi.nlm.nih.gov/24121242/", "source_label": "Talking yourself out of exhaustion: the effects of self-talk on endurance performance — Blanchfield et al. 2014, MSSE", "quality_tier": "randomized_controlled_trial", "page": 1, "paragraph_index": 1, "keywords_en": ["self-talk", "endurance", "perceived effort", "performance", "fatigue"], "text": "Blanchfield et al. (2014) conducted a randomized controlled trial demonstrating that motivational self-talk interventions significantly improved endurance performance and time to exhaustion in a cycling task. The mechanism operates through reduced perception of effort: self-talk does not change physiological capacity but alters how difficult the effort feels. For marathon planning, the psychologist node may provide self-talk prompt suggestions per training phase or per race segment without prescribing training changes."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_self_talk_second_person_2019_0014", "source_registry_id": "src_selftalk_second_person_hardy_2019", "source_file": "selftalk_second_person_hardy_2019.url", "source_path": "https://pubmed.ncbi.nlm.nih.gov/31067183/", "source_url": "https://pubmed.ncbi.nlm.nih.gov/31067183/", "source_label": "To me, to you: How you say things matters for endurance performance — Hardy, Thomas & Blanchfield 2019, Journal of Sports Sciences", "quality_tier": "randomized_controlled_trial", "page": 1, "paragraph_index": 1, "keywords_en": ["self-talk", "second person", "you", "self-distancing", "endurance performance"], "text": "Hardy, Thomas, and Blanchfield (2019) found that second-person self-talk ('You can do this.') produced superior endurance outcomes compared with first-person self-talk ('I can do this.'). The mechanism is self-distancing: speaking to oneself as if from the perspective of a supportive coach reduces emotional reactivity and does not require inherent self-belief to be effective. Marathon runners in a mentally demanding training block or anxiety-prone pre-race phase may particularly benefit from scripted second-person mantras."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_self_talk_motivational_vs_instructional_0015", "source_registry_id": "src_sport_psychology_psych_interventions_meta_2024", "source_file": "psychological_interventions_sport_performance_meta_2024.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_label": "Psychological interventions for sports performance systematic review and meta-analysis — PMC 2024", "quality_tier": "systematic_review_meta_analysis", "page": 2, "paragraph_index": 1, "keywords_en": ["self-talk", "motivational", "instructional", "performance", "skill execution"], "text": "Sport psychology distinguishes motivational self-talk (e.g., 'Keep going, you've trained for this') from instructional self-talk (e.g., 'Relax shoulders, increase cadence'). Meta-analytic evidence shows both types improve performance, but their optimal application differs: motivational self-talk is most effective for endurance tasks requiring sustained effort, while instructional self-talk benefits technique-sensitive tasks. For marathon running, motivational self-talk is the priority application for psychologist annotations, especially during high-intensity workouts and in race contexts."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_self_talk_mantra_design_0016", "source_registry_id": "src_selftalk_endurance_blanchfield_2014", "source_file": "selftalk_endurance_blanchfield_2014.url", "source_path": "https://pubmed.ncbi.nlm.nih.gov/24121242/", "source_url": "https://pubmed.ncbi.nlm.nih.gov/24121242/", "source_label": "Talking yourself out of exhaustion: the effects of self-talk on endurance performance — Blanchfield et al. 2014, MSSE", "quality_tier": "randomized_controlled_trial", "page": 1, "paragraph_index": 2, "keywords_en": ["mantra", "self-talk", "simplicity", "rhythm", "personalization"], "text": "Effective marathon mantras share several evidence-informed characteristics: brevity (4–8 syllables), rhythmic alignment with cadence, positive framing (approach-oriented rather than avoidance-oriented), and personal relevance to the runner's values or race goal. Examples of approach-oriented mantras: 'Strong and steady', 'Forward motion', 'You trained for this mile'. The psychologist node should suggest 2–3 personalized mantra options based on the runner profile, particularly any stated race motivation or personal meaning they have attached to the goal."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_self_talk_negative_reframing_0017", "source_registry_id": "src_selftalk_second_person_hardy_2019", "source_file": "selftalk_second_person_hardy_2019.url", "source_path": "https://pubmed.ncbi.nlm.nih.gov/31067183/", "source_url": "https://pubmed.ncbi.nlm.nih.gov/31067183/", "source_label": "To me, to you: How you say things matters for endurance performance — Hardy, Thomas & Blanchfield 2019, Journal of Sports Sciences", "quality_tier": "randomized_controlled_trial", "page": 1, "paragraph_index": 2, "keywords_en": ["negative self-talk", "reframing", "cognitive restructuring", "running", "anxiety"], "text": "Negative self-talk during marathon training or racing ('I can't do this', 'My legs are dying') reliably increases perceived effort and reduces time to exhaustion. Cognitive reframing techniques involve replacing negative statements with neutral or positive alternatives — not through denial of difficulty, but through accurate reinterpretation: 'My legs feel heavy because I'm working hard — that's the training stimulus.' The psychologist node should provide per-session reframing scripts as an annotation layer on executor-generated workouts, not as instructions to modify the workout itself."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_self_talk_ultra_marathon_review_0018", "source_registry_id": "src_pain_coping_ultra_endurance_pmc_2025", "source_file": "pain_coping_ultra_endurance_pmc_2025.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12476407/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12476407/", "source_label": "Human Resilience and Pain Coping Strategies — Elite Ultra-Endurance Athletes Review, PMC 2025", "quality_tier": "systematic_review_meta_analysis", "page": 1, "paragraph_index": 1, "keywords_en": ["self-talk", "ultra marathon", "motivation", "confidence", "pain tolerance"], "text": "A systematic literature review on ultra-marathon runners found that self-talk served as a primary source of motivation during extreme fatigue states. Runners who had prepared specific self-talk scripts for anticipated low points — rather than improvising in the moment — reported greater confidence and more consistent forward movement during crisis points. This pre-planned approach transfers directly to marathon preparation: psychologist annotations should include crisis-point self-talk cues that runners can rehearse during training."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_self_talk_pain_tolerance_0019", "source_registry_id": "src_selftalk_endurance_blanchfield_2014", "source_file": "selftalk_endurance_blanchfield_2014.url", "source_path": "https://pubmed.ncbi.nlm.nih.gov/24121242/", "source_url": "https://pubmed.ncbi.nlm.nih.gov/24121242/", "source_label": "Talking yourself out of exhaustion: the effects of self-talk on endurance performance — Blanchfield et al. 2014, MSSE", "quality_tier": "randomized_controlled_trial", "page": 2, "paragraph_index": 1, "keywords_en": ["self-talk", "pain tolerance", "discomfort", "endurance", "effort perception"], "text": "Self-talk interventions have been shown to improve tolerance to exercise-induced pain and muscular discomfort, with effects mediated by improvements in self-efficacy and reduced catastrophizing. In a marathon context, runners who experienced high degrees of leg fatigue and used prepared motivational self-talk maintained higher overall performance consistency than those who did not. The psychologist node can include brief pain-management self-talk scripts as part of race-day preparation notes for runners who have flagged concern about late-race fatigue in their profile."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_self_talk_identity_0020", "source_registry_id": "src_selftalk_second_person_hardy_2019", "source_file": "selftalk_second_person_hardy_2019.url", "source_path": "https://pubmed.ncbi.nlm.nih.gov/31067183/", "source_url": "https://pubmed.ncbi.nlm.nih.gov/31067183/", "source_label": "To me, to you: How you say things matters for endurance performance — Hardy, Thomas & Blanchfield 2019, Journal of Sports Sciences", "quality_tier": "randomized_controlled_trial", "page": 2, "paragraph_index": 1, "keywords_en": ["identity", "self-talk", "runner identity", "adherence", "motivation"], "text": "Research in motivational psychology finds that identity-based self-talk — framing oneself as 'a runner' rather than 'someone who runs' — is associated with greater long-term adherence to training. The identity framing shifts motivation from extrinsic (goal achievement) to intrinsic (expression of self), which predicts better recovery from setbacks and more consistent training behavior. Psychologist annotations during early training blocks can reinforce identity language as a structural adherence support."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_visualization_neural_basis_0021", "source_registry_id": "src_visualization_imagery_sport_performance_review", "source_file": "visualization_imagery_sport_performance_review.url", "source_path": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_url": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_label": "Visualisation techniques in sport — the mental road map for success (ResearchGate review)", "quality_tier": "expert_review", "page": 1, "paragraph_index": 1, "keywords_en": ["visualization", "mental imagery", "neural", "motor cortex", "fMRI"], "text": "fMRI studies have demonstrated that mental imagery of athletic movement activates the same neural pathways as physical execution of that movement. This parallel activation provides the neurological basis for visualization as a training tool: systematic mental rehearsal strengthens motor programs and cognitive representations of a skill or route without physical wear. For marathon runners, visualization can be used to mentally rehearse race day without requiring additional physiological stress during taper periods."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_visualization_marathon_application_0022", "source_registry_id": "src_visualization_imagery_sport_performance_review", "source_file": "visualization_imagery_sport_performance_review.url", "source_path": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_url": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_label": "Visualisation techniques in sport — the mental road map for success (ResearchGate review)", "quality_tier": "expert_review", "page": 1, "paragraph_index": 2, "keywords_en": ["visualization", "marathon", "race rehearsal", "course", "mental simulation"], "text": "Applied sport psychology recommends that marathon runners visualize the race in a multi-sensory manner: not just seeing the course but feeling the road surface, hearing the crowd at key points, sensing the temperature and humidity, experiencing the physical sensations of effort at each stage. A full race visualization covering the start, each major split, the halfway mental check-in, the difficult mid-race miles, and the finish should ideally take 3–5 minutes in abbreviated form. The psychologist node can include visualization scripts tailored to the runner's target race, if available in their profile."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_visualization_confidence_building_0023", "source_registry_id": "src_visualization_imagery_sport_performance_review", "source_file": "visualization_imagery_sport_performance_review.url", "source_path": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_url": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_label": "Visualisation techniques in sport — the mental road map for success (ResearchGate review)", "quality_tier": "expert_review", "page": 2, "paragraph_index": 1, "keywords_en": ["visualization", "confidence", "self-efficacy", "past success", "mental rehearsal"], "text": "Visualization techniques in sport can target two distinct outcomes: performance improvement (rehearsing a skill or strategy) and confidence building (replaying successful past performances). Confidence-focused visualization involves re-experiencing previous strong training sessions or races in vivid detail to anchor the neurological and emotional memory of being capable. For runners experiencing pre-race anxiety or mid-training-block confidence dips, confidence-focused visualization scripts are a high-value psychologist annotation."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_visualization_adversity_rehearsal_0024", "source_registry_id": "src_visualization_imagery_sport_performance_review", "source_file": "visualization_imagery_sport_performance_review.url", "source_path": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_url": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_label": "Visualisation techniques in sport — the mental road map for success (ResearchGate review)", "quality_tier": "expert_review", "page": 2, "paragraph_index": 2, "keywords_en": ["visualization", "adversity", "crisis rehearsal", "wall", "contingency planning"], "text": "Beyond positive performance rehearsal, adversity visualization — mentally rehearsing how to respond to anticipated difficulties such as hitting the wall, weather changes, or early cramping — is particularly valuable for marathon runners. Research on marathon runners shows that those who had mentally rehearsed specific adversity scenarios and planned their responses performed more consistently than those relying on improvised crisis management. The psychologist node may include 'what if' scenario scripts per training phase, particularly as race day approaches."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_visualization_best_practices_0025", "source_registry_id": "src_visualization_imagery_sport_performance_review", "source_file": "visualization_imagery_sport_performance_review.url", "source_path": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_url": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_label": "Visualisation techniques in sport — the mental road map for success (ResearchGate review)", "quality_tier": "expert_review", "page": 3, "paragraph_index": 1, "keywords_en": ["visualization", "technique", "PETTLEP", "five senses", "mental rehearsal guide"], "text": "The PETTLEP model (Physical, Environment, Task, Timing, Learning, Emotion, Perspective) provides an evidence-based framework for high-quality mental imagery in sport. Key principles: (1) physical — adopt the body position you would be in during the activity; (2) environment — visualize in or near the actual performance environment when possible; (3) timing — use real-time duration, not speeded imagery; (4) emotion — include the emotional experience of the event, both challenge and confidence. The psychologist node should reference these principles in the brief visualization guidelines provided to runners."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_visualization_taper_period_0026", "source_registry_id": "src_visualization_imagery_sport_performance_review", "source_file": "visualization_imagery_sport_performance_review.url", "source_path": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_url": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_label": "Visualisation techniques in sport — the mental road map for success (ResearchGate review)", "quality_tier": "expert_review", "page": 3, "paragraph_index": 2, "keywords_en": ["visualization", "taper", "pre-race", "mental preparation", "readiness"], "text": "During the taper period before a marathon, when physical training volume deliberately decreases, mental skills training can fill the gap in structured preparation. Sport psychology practitioners recommend increasing visualization frequency in the two weeks before a marathon, with daily mental rehearsals of the race course, start-line routine, and key race segments. This sustained mental rehearsal reduces taper anxiety and maintains neuromuscular preparation without adding physical stress. The psychologist node should flag taper-phase mental preparation as a distinct annotation block."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_visualization_injury_recovery_0027", "source_registry_id": "src_visualization_imagery_sport_performance_review", "source_file": "visualization_imagery_sport_performance_review.url", "source_path": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_url": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_label": "Visualisation techniques in sport — the mental road map for success (ResearchGate review)", "quality_tier": "expert_review", "page": 4, "paragraph_index": 1, "keywords_en": ["visualization", "injury", "rehabilitation", "mental rehearsal", "return to sport"], "text": "Mental imagery has documented benefits during injury rehabilitation: athletes who use visualization during periods when physical training is restricted maintain motor skill representation and return to full performance more quickly than those relying on rest alone. Meta-analyses confirm that imagery training during rehabilitation reduces anxiety about return-to-sport and maintains movement confidence. When the therapist node identifies an injury scenario, the psychologist node can coordinate by providing visualization scripts that support rehabilitation adherence and mental readiness for return."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_visualization_outcome_vs_process_0028", "source_registry_id": "src_visualization_imagery_sport_performance_review", "source_file": "visualization_imagery_sport_performance_review.url", "source_path": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_url": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_label": "Visualisation techniques in sport — the mental road map for success (ResearchGate review)", "quality_tier": "expert_review", "page": 4, "paragraph_index": 2, "keywords_en": ["visualization", "outcome goals", "process goals", "focus", "imagery type"], "text": "Sport psychology differentiates between outcome imagery (visualizing a finish time or placing) and process imagery (visualizing correct execution of pace, breathing, and form). Research suggests process imagery produces greater performance benefits for complex endurance tasks because it reinforces controllable behaviors rather than outcome uncertainty. For marathon runners, psychologist visualization scripts should emphasize process imagery — the feeling of running smoothly, the experience of maintaining pace — rather than exclusively visualizing the finish time or placement."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_goal_setting_theory_locke_latham_0029", "source_registry_id": "src_goal_setting_sport_exercise_locke_latham_2002", "source_file": "goal_setting_sport_exercise_locke_latham_2002.url", "source_path": "https://med.stanford.edu/content/dam/sm/s-spire/documents/PD.locke-and-latham-retrospective_Paper.pdf", "source_url": "https://med.stanford.edu/content/dam/sm/s-spire/documents/PD.locke-and-latham-retrospective_Paper.pdf", "source_label": "Building a Practically Useful Theory of Goal Setting and Task Motivation — Locke & Latham 2002, American Psychologist", "quality_tier": "peer_reviewed_study", "page": 1, "paragraph_index": 1, "keywords_en": ["goal setting", "Locke", "Latham", "specific goals", "challenging goals", "motivation"], "text": "Locke and Latham's goal-setting theory (1990, 2002) establishes that specific and challenging goals produce higher performance than vague ('do your best') goals. The theory identifies five key goal-setting principles: clarity, challenge, commitment, feedback, and task complexity. In marathon training, psychologist annotations can reference these principles when reminding runners why their prescribed training targets serve a purpose, and why tracking completion matters for motivational coherence."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_goal_types_outcome_performance_process_0030", "source_registry_id": "src_goal_setting_sport_exercise_locke_latham_2002", "source_file": "goal_setting_sport_exercise_locke_latham_2002.url", "source_path": "https://med.stanford.edu/content/dam/sm/s-spire/documents/PD.locke-and-latham-retrospective_Paper.pdf", "source_url": "https://med.stanford.edu/content/dam/sm/s-spire/documents/PD.locke-and-latham-retrospective_Paper.pdf", "source_label": "Building a Practically Useful Theory of Goal Setting and Task Motivation — Locke & Latham 2002, American Psychologist", "quality_tier": "peer_reviewed_study", "page": 1, "paragraph_index": 2, "keywords_en": ["goal types", "outcome goal", "performance goal", "process goal", "marathon", "adherence"], "text": "Sport psychology distinguishes three goal types: outcome goals (finish sub-3:30), performance goals (achieve negative splits in the long run), and process goals (maintain 170 bpm cadence for the first 30 km). Research shows that athletes who rely exclusively on outcome goals are more vulnerable to motivation collapse when conditions change, while athletes with strong process goal structures remain more consistent. The psychologist node should emphasize process goals in its annotations, particularly for runners in volatile training phases where outcome targets may shift."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_goal_setting_tiered_marathon_0031", "source_registry_id": "src_goal_setting_self_regulation_marathon_2023", "source_file": "goal_setting_self_regulation_marathon_2023.url", "source_path": "https://www.sciencedirect.com/science/article/pii/S1469029223001401", "source_url": "https://www.sciencedirect.com/science/article/pii/S1469029223001401", "source_label": "Self-regulatory processes in goal striving during excellent distance-running performances — ScienceDirect 2023", "quality_tier": "peer_reviewed_study", "page": 1, "paragraph_index": 1, "keywords_en": ["tiered goals", "goal hierarchy", "A goal", "B goal", "C goal", "marathon flexibility"], "text": "Applied sport psychology for marathon racing recommends a tiered goal structure: an A goal (ideal performance under perfect conditions), a B goal (solid performance given moderate challenge), and a C goal (completion or execution of the plan regardless of time). Research on self-regulatory processes during excellent distance-running performances found that athletes who had pre-committed to tiered goals made faster and more effective in-race adjustments when their A goal became unachievable. The psychologist node can surface tiered goal reminders in race-week preparation notes."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_goal_setting_SMART_0032", "source_registry_id": "src_goal_setting_sport_exercise_locke_latham_2002", "source_file": "goal_setting_sport_exercise_locke_latham_2002.url", "source_path": "https://med.stanford.edu/content/dam/sm/s-spire/documents/PD.locke-and-latham-retrospective_Paper.pdf", "source_url": "https://med.stanford.edu/content/dam/sm/s-spire/documents/PD.locke-and-latham-retrospective_Paper.pdf", "source_label": "Building a Practically Useful Theory of Goal Setting and Task Motivation — Locke & Latham 2002, American Psychologist", "quality_tier": "peer_reviewed_study", "page": 2, "paragraph_index": 1, "keywords_en": ["SMART goals", "specific", "measurable", "achievable", "relevant", "time-bound", "training adherence"], "text": "The SMART goal framework (Specific, Measurable, Achievable, Relevant, Time-bound) is widely applied in endurance sport coaching. For marathon training, poorly specified goals such as 'get faster' are less motivationally effective than 'complete the 30 km long run at 5:45/km pace by week 14'. The psychologist node does not modify training prescription but can reinforce goal clarity and motivational rationale in its annotations, explaining why each training block's objectives matter in context of the runner's stated marathon goal."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_goal_setting_intrinsic_motivation_0033", "source_registry_id": "src_goal_setting_self_regulation_marathon_2023", "source_file": "goal_setting_self_regulation_marathon_2023.url", "source_path": "https://www.sciencedirect.com/science/article/pii/S1469029223001401", "source_url": "https://www.sciencedirect.com/science/article/pii/S1469029223001401", "source_label": "Self-regulatory processes in goal striving during excellent distance-running performances — ScienceDirect 2023", "quality_tier": "peer_reviewed_study", "page": 1, "paragraph_index": 2, "keywords_en": ["intrinsic motivation", "self-determination theory", "autonomy", "competence", "relatedness", "adherence"], "text": "Self-determination theory (Deci & Ryan) identifies three psychological needs — autonomy, competence, and relatedness — as the foundation of intrinsic motivation in sport. When marathon training goals feel externally imposed or misaligned with the runner's personal values, motivation erodes and burnout risk increases. Psychologist annotations can support intrinsic motivation by connecting training demands to the runner's stated personal meaning: 'This long run represents your commitment to the goal you described — [runner's stated reason for the marathon]'."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_goal_adjustment_mid_race_0034", "source_registry_id": "src_goal_setting_self_regulation_marathon_2023", "source_file": "goal_setting_self_regulation_marathon_2023.url", "source_path": "https://www.sciencedirect.com/science/article/pii/S1469029223001401", "source_url": "https://www.sciencedirect.com/science/article/pii/S1469029223001401", "source_label": "Self-regulatory processes in goal striving during excellent distance-running performances — ScienceDirect 2023", "quality_tier": "peer_reviewed_study", "page": 2, "paragraph_index": 1, "keywords_en": ["goal adjustment", "mid-race", "goal disengagement", "re-engagement", "performance"], "text": "Research on excellent distance-running performances using the Mental Contrasting with Implementation Intentions (MCII) framework found that athletes who periodically contrasted their current state against their goal — and were willing to disengage from an unachievable goal and reengage with a realistic alternative — finished races more successfully than those who rigidly maintained an unrealistic goal. In practice, the psychologist can include race-phase mental check-in prompts ('At km 30, assess and adjust your target if needed') as preparation notes before race day."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_goal_setting_self_concordance_0035", "source_registry_id": "src_goal_setting_sport_exercise_locke_latham_2002", "source_file": "goal_setting_sport_exercise_locke_latham_2002.url", "source_path": "https://med.stanford.edu/content/dam/sm/s-spire/documents/PD.locke-and-latham-retrospective_Paper.pdf", "source_url": "https://med.stanford.edu/content/dam/sm/s-spire/documents/PD.locke-and-latham-retrospective_Paper.pdf", "source_label": "Building a Practically Useful Theory of Goal Setting and Task Motivation — Locke & Latham 2002, American Psychologist", "quality_tier": "peer_reviewed_study", "page": 3, "paragraph_index": 1, "keywords_en": ["self-concordant goals", "values", "burnout prevention", "well-being", "intrinsic"], "text": "Research by Koestner and Ryan found that individuals pursuing self-concordant goals — goals that align with personal values rather than external pressure — show greater persistence, more positive affect, and lower dropout rates under setbacks. For marathon runners who are training for reasons that deeply matter to them personally, self-concordant framing is protective during difficult training blocks. Psychologist annotations can include brief prompts that reconnect the runner's current week's effort to their stated motivational anchor (race meaning, personal significance)."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_goal_setting_short_long_term_0036", "source_registry_id": "src_goal_setting_sport_exercise_locke_latham_2002", "source_file": "goal_setting_sport_exercise_locke_latham_2002.url", "source_path": "https://med.stanford.edu/content/dam/sm/s-spire/documents/PD.locke-and-latham-retrospective_Paper.pdf", "source_url": "https://med.stanford.edu/content/dam/sm/s-spire/documents/PD.locke-and-latham-retrospective_Paper.pdf", "source_label": "Building a Practically Useful Theory of Goal Setting and Task Motivation — Locke & Latham 2002, American Psychologist", "quality_tier": "peer_reviewed_study", "page": 3, "paragraph_index": 2, "keywords_en": ["short-term goals", "long-term goals", "milestone", "motivation", "training adherence"], "text": "Long-term goals alone are insufficient to sustain training motivation over a 16–20 week marathon preparation block. Sport psychology research recommends nested goal structures: weekly process goals nested within monthly performance goals nested within the race outcome goal. Reaching each nested milestone provides motivational momentum and self-efficacy reinforcement. The psychologist node can provide milestone recognition scripts — brief affirmations when the runner has completed a key training milestone — as an annotation layer on completed sessions."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_pain_tolerance_endurance_athletes_0037", "source_registry_id": "src_pain_coping_ultra_endurance_pmc_2025", "source_file": "pain_coping_ultra_endurance_pmc_2025.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12476407/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12476407/", "source_label": "Human Resilience and Pain Coping Strategies — Elite Ultra-Endurance Athletes Review, PMC 2025", "quality_tier": "systematic_review_meta_analysis", "page": 1, "paragraph_index": 2, "keywords_en": ["pain tolerance", "endurance athletes", "pain threshold", "conditioned pain modulation"], "text": "Meta-analytic research confirms that endurance athletes demonstrate significantly higher pain threshold and tolerance than non-athlete controls, with stronger conditioned pain modulation (CPM) responses. This elevated pain tolerance is partially trainable through both physical training and psychological skill development, particularly cognitive reappraisal. The marathon psychologist node can communicate this evidence to runners experiencing late-training-block physical discomfort, framing muscular fatigue sensations as an expected and normal component of the adaptive process."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_cognitive_reappraisal_pain_0038", "source_registry_id": "src_pain_coping_ultra_endurance_pmc_2025", "source_file": "pain_coping_ultra_endurance_pmc_2025.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12476407/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12476407/", "source_label": "Human Resilience and Pain Coping Strategies — Elite Ultra-Endurance Athletes Review, PMC 2025", "quality_tier": "systematic_review_meta_analysis", "page": 2, "paragraph_index": 1, "keywords_en": ["cognitive reappraisal", "pain", "reframing", "meaning", "endurance"], "text": "Cognitive reappraisal — reinterpreting the meaning or implication of a challenging stimulus — is one of the most evidence-supported psychological strategies for managing exercise-induced pain. Ultra-endurance athletes who framed pain as 'part of the reward system' and evidence of productive effort reported higher pain tolerance and performance consistency than those who interpreted pain as a threat signal. Psychologist annotations can include reappraisal scripts: 'The discomfort in your legs at mile 22 is not a warning — it is evidence of your preparation.'"}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_pain_catastrophizing_performance_0039", "source_registry_id": "src_pain_coping_ultra_endurance_pmc_2025", "source_file": "pain_coping_ultra_endurance_pmc_2025.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12476407/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12476407/", "source_label": "Human Resilience and Pain Coping Strategies — Elite Ultra-Endurance Athletes Review, PMC 2025", "quality_tier": "systematic_review_meta_analysis", "page": 2, "paragraph_index": 2, "keywords_en": ["pain catastrophizing", "rumination", "anxiety", "performance decrement", "cognitive"], "text": "Pain catastrophizing — a maladaptive cognitive pattern involving magnification of pain, helplessness, and ruminative focus on pain — is among the strongest predictors of reduced pain tolerance and performance impairment in endurance athletes. Runners who catastrophize ('This pain means something is wrong', 'I can't take this anymore') experience pain as more intense and slow down more dramatically than those who use neutral or approach-oriented appraisals. The psychologist node should flag catastrophizing thought patterns and offer reappraisal alternatives when runners have reported high distress in their training log."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_pain_acceptance_vs_suppression_0040", "source_registry_id": "src_mindfulness_distress_tolerance_athlete_2025", "source_file": "mindfulness_distress_tolerance_athlete_2025.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11939238/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11939238/", "source_label": "Mindfulness and Athletes' Distress Tolerance: Cognitive Reappraisal and Mental Toughness — PMC 2025", "quality_tier": "peer_reviewed_study", "page": 1, "paragraph_index": 1, "keywords_en": ["pain acceptance", "suppression", "ACT", "mindfulness", "endurance performance"], "text": "Acceptance-based approaches to pain in endurance sport (rooted in ACT and mindfulness traditions) distinguish acceptance — acknowledging pain without judgment and continuing forward — from both suppression (denying pain) and catastrophizing (magnifying it). Research shows that acceptance of discomfort is associated with better endurance performance and lower post-race distress than suppression strategies. The psychologist node can include acceptance-oriented pain scripts: 'Your legs are telling you this is hard. It is hard. Keep moving.'"}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_pain_experience_wall_mile20_0041", "source_registry_id": "src_marathon_hitting_wall_mental_strategies_2026", "source_file": "marathon_hitting_wall_mental_strategies_2026.url", "source_path": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_url": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_label": "Marathon Mindset: Proven Strategies to Survive the Wall and Cross the Finish Line — Runlovers 2026", "quality_tier": "practitioner_review", "page": 1, "paragraph_index": 1, "keywords_en": ["pain", "hitting the wall", "mile 20", "glycogen", "perception of effort", "Marcora"], "text": "Professor Samuele Marcora's research at Kent University demonstrates that when marathoners slow or stop, residual muscular glycogen remains — the decision is generated by the brain's perception of effort rather than muscular failure. This psychophysiological finding reframes the experience of hitting the wall: the barrier is primarily cognitive and manageable, not purely physiological. Understanding this mechanism gives runners evidence-based reason to trust that forward movement remains possible even when perception says otherwise."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_pain_distraction_methods_0042", "source_registry_id": "src_marathon_hitting_wall_mental_strategies_2026", "source_file": "marathon_hitting_wall_mental_strategies_2026.url", "source_path": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_url": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_label": "Marathon Mindset: Proven Strategies to Survive the Wall and Cross the Finish Line — Runlovers 2026", "quality_tier": "practitioner_review", "page": 1, "paragraph_index": 2, "keywords_en": ["dissociation", "distraction", "pain management", "crowd", "external focus", "mental arithmetic"], "text": "Research-supported distraction techniques for pain management during a marathon include: (1) external focus on crowd energy or scenery, (2) mental arithmetic (calculating splits, counting markers), (3) positive dissociation — running for a specific person or cause rather than oneself. Dissociative distraction is most effective for non-elite runners and correlates with later onset of severe fatigue perception. The psychologist node can include race-phase distraction options as part of race-day preparation notes, particularly for the challenging 25–35 km segment."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_pain_mindfulness_tolerance_2025_0043", "source_registry_id": "src_mindfulness_distress_tolerance_athlete_2025", "source_file": "mindfulness_distress_tolerance_athlete_2025.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11939238/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11939238/", "source_label": "Mindfulness and Athletes' Distress Tolerance: Cognitive Reappraisal and Mental Toughness — PMC 2025", "quality_tier": "peer_reviewed_study", "page": 1, "paragraph_index": 2, "keywords_en": ["mindfulness", "pain tolerance", "distress tolerance", "mental toughness", "cognitive reappraisal"], "text": "A 2025 PMC study found significant positive correlations between mindfulness, cognitive reappraisal, and mental toughness in athletes, with cognitive reappraisal mediating the relationship between mindfulness and distress tolerance. Athletes higher in mindfulness were better able to reappraise painful sensations as non-threatening, sustaining effort more effectively. Regular mindfulness practice during training — even brief 5-minute body scan sessions — appears sufficient to produce measurable improvements in pain tolerance over a training block."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_pain_self_efficacy_link_0044", "source_registry_id": "src_pain_coping_ultra_endurance_pmc_2025", "source_file": "pain_coping_ultra_endurance_pmc_2025.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12476407/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12476407/", "source_label": "Human Resilience and Pain Coping Strategies — Elite Ultra-Endurance Athletes Review, PMC 2025", "quality_tier": "systematic_review_meta_analysis", "page": 3, "paragraph_index": 1, "keywords_en": ["self-efficacy", "pain self-efficacy", "confidence", "tolerance", "injury recovery"], "text": "Pain self-efficacy — a runner's belief in their ability to manage or cope with pain — is a distinct predictor of pain tolerance beyond baseline fitness or pain threshold. High pain self-efficacy correlates with faster return-to-sport after injury, higher completion rates in difficult training sessions, and reduced pain interference with performance. The psychologist node can support pain self-efficacy through confidence-building scripts referencing the runner's own training history: 'You have tolerated comparable discomfort in previous long runs and continued — this is evidence of your capacity.'"}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_prerace_routine_theory_0045", "source_registry_id": "src_prerace_routine_psychological_effects_2025", "source_file": "prerace_routine_psychological_effects_2025.url", "source_path": "https://www.researchgate.net/publication/395585347_Pre-Game_Routines_and_Their_Psychological_Effects_on_Performance_Consistency", "source_url": "https://www.researchgate.net/publication/395585347_Pre-Game_Routines_and_Their_Psychological_Effects_on_Performance_Consistency", "source_label": "Pre-Game Routines and Their Psychological Effects on Performance Consistency — ResearchGate 2025", "quality_tier": "peer_reviewed_study", "page": 1, "paragraph_index": 1, "keywords_en": ["pre-race routine", "psychological preparation", "arousal regulation", "consistency", "confidence"], "text": "Pre-performance routines are among the best-supported psychological tools in sport psychology, with consistent evidence across team sports, individual sports, and endurance contexts. Routines provide two key benefits: (1) they automate the pre-competition period, preserving cognitive resources for performance; (2) they allow the athlete to regulate arousal to their individual optimal zone. For marathon runners, a pre-race routine spanning the final 48 hours through the starting corral is a psychologically coherent preparation structure."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_prerace_arousal_zone_0046", "source_registry_id": "src_prerace_routine_psychological_effects_2025", "source_file": "prerace_routine_psychological_effects_2025.url", "source_path": "https://www.researchgate.net/publication/395585347_Pre-Game_Routines_and_Their_Psychological_Effects_on_Performance_Consistency", "source_url": "https://www.researchgate.net/publication/395585347_Pre-Game_Routines_and_Their_Psychological_Effects_on_Performance_Consistency", "source_label": "Pre-Game Routines and Their Psychological Effects on Performance Consistency — ResearchGate 2025", "quality_tier": "peer_reviewed_study", "page": 1, "paragraph_index": 2, "keywords_en": ["arousal", "optimal zone", "individual zone of optimal functioning", "IZOF", "anxiety", "performance"], "text": "Hanin's Individual Zone of Optimal Functioning (IZOF) model establishes that each athlete has a personal optimal arousal range for peak performance — not a universal level but an individually calibrated state. Pre-race anxiety below this zone leads to flat, underperforming execution; anxiety above the zone leads to tight, error-prone running. Pre-race routines should be designed to bring the runner's arousal level into their personal optimal zone by race start. The psychologist node can include a brief arousal self-check prompt in race-week preparation notes: 'On a scale of 1–10, where do you feel most focused and ready — that is your target on race morning.'"}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_prerace_controllables_0047", "source_registry_id": "src_prerace_anxiety_runners_guide_2025", "source_file": "prerace_anxiety_runners_guide_2025.url", "source_path": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_url": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_label": "Beat Pre Race Anxiety: The Runner's Guide to Managing Performance Nerves — Runners Connect 2025", "quality_tier": "practitioner_review", "page": 1, "paragraph_index": 1, "keywords_en": ["controllable", "uncontrollable", "pre-race anxiety", "control focus", "race preparation"], "text": "A major driver of pre-race anxiety is allocation of attention to uncontrollable race variables: weather, course conditions, competitor performance. Sport psychology consistently recommends a 'control the controllables' intervention: systematically redirecting planning and attention toward things entirely within the runner's control — kit preparation, sleep routine, nutrition timing, warm-up sequence, and self-talk readiness. The psychologist node can include a pre-race 'controllables checklist' as a race-week annotation, providing a structured focus redirect that reduces anxiety arousal."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_prerace_self_efficacy_building_0048", "source_registry_id": "src_prerace_anxiety_runners_guide_2025", "source_file": "prerace_anxiety_runners_guide_2025.url", "source_path": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_url": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_label": "Beat Pre Race Anxiety: The Runner's Guide to Managing Performance Nerves — Runners Connect 2025", "quality_tier": "practitioner_review", "page": 1, "paragraph_index": 2, "keywords_en": ["self-efficacy", "confidence", "evidence review", "training history", "pre-race"], "text": "Low self-efficacy — underestimating one's capacity to handle the race — is a primary predictor of pre-race anxiety and underperformance. Bandura's self-efficacy theory identifies four sources: past performance accomplishments, vicarious experience, verbal persuasion, and physiological interpretation. Pre-race confidence is most powerfully built through a structured review of past performance accomplishments: revisiting completed training sessions, key long runs, and prior race splits provides concrete evidence of readiness. The psychologist node should generate a 'training evidence summary' in the race-week annotation, citing the runner's actual training data."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_prerace_cognitive_restructuring_0049", "source_registry_id": "src_prerace_anxiety_runners_guide_2025", "source_file": "prerace_anxiety_runners_guide_2025.url", "source_path": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_url": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_label": "Beat Pre Race Anxiety: The Runner's Guide to Managing Performance Nerves — Runners Connect 2025", "quality_tier": "practitioner_review", "page": 2, "paragraph_index": 1, "keywords_en": ["cognitive restructuring", "CBT", "pre-race", "anxiety", "worry", "evidence-based"], "text": "Cognitive-behavioral approaches to pre-race anxiety involve identifying specific worry thoughts and examining the evidence for and against them — rather than suppressing the thoughts or accepting them uncritically. A systematic review by Bühlmayer et al. confirmed that cognitive restructuring techniques significantly reduced competitive anxiety in endurance athletes. Common pre-race cognitive restructuring example: worry thought — 'I haven't trained enough'; reframe — 'I completed 14 of 16 scheduled long runs and all interval sessions; my preparation is solid'."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_prerace_breathing_relaxation_0050", "source_registry_id": "src_prerace_routine_psychological_effects_2025", "source_file": "prerace_routine_psychological_effects_2025.url", "source_path": "https://www.researchgate.net/publication/395585347_Pre-Game_Routines_and_Their_Psychological_Effects_on_Performance_Consistency", "source_url": "https://www.researchgate.net/publication/395585347_Pre-Game_Routines_and_Their_Psychological_Effects_on_Performance_Consistency", "source_label": "Pre-Game Routines and Their Psychological Effects on Performance Consistency — ResearchGate 2025", "quality_tier": "peer_reviewed_study", "page": 2, "paragraph_index": 1, "keywords_en": ["breathing", "box breathing", "arousal regulation", "activation", "pre-race calm"], "text": "Controlled breathing techniques are among the most accessible and evidence-based tools for arousal regulation before a marathon. Box breathing (inhale 4 counts, hold 4, exhale 4, hold 4) activates the parasympathetic nervous system within 2–3 minutes, reliably reducing heart rate and subjective anxiety. Activation breathing (short, sharp inhales, forceful exhales) can raise arousal from an under-activated state. The psychologist node can provide breathing protocol scripts matched to the runner's pre-race arousal pattern: calming protocol for high-anxiety runners, activating protocol for flat or under-motivated runners."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_prerace_ritual_vs_superstition_0051", "source_registry_id": "src_prerace_routine_psychological_effects_2025", "source_file": "prerace_routine_psychological_effects_2025.url", "source_path": "https://www.researchgate.net/publication/395585347_Pre-Game_Routines_and_Their_Psychological_Effects_on_Performance_Consistency", "source_url": "https://www.researchgate.net/publication/395585347_Pre-Game_Routines_and_Their_Psychological_Effects_on_Performance_Consistency", "source_label": "Pre-Game Routines and Their Psychological Effects on Performance Consistency — ResearchGate 2025", "quality_tier": "peer_reviewed_study", "page": 2, "paragraph_index": 2, "keywords_en": ["ritual", "superstition", "pre-performance", "automaticity", "psychological control"], "text": "Sport psychology distinguishes strategic pre-race rituals from performance-impeding superstition. A strategic ritual is explainable and replicable: 'I do box breathing because it regulates my arousal state.' A superstition is arbitrary: 'I must wear my left sock first or the race will go badly.' Rituals work because they create controllable, predictable sequences that signal psychological readiness; superstitions create fragility and anxiety when the arbitrary condition cannot be met. Psychologist annotations should encourage runners to build transparent, rationale-driven routines."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_prerace_sleep_mental_0052", "source_registry_id": "src_prerace_anxiety_runners_guide_2025", "source_file": "prerace_anxiety_runners_guide_2025.url", "source_path": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_url": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_label": "Beat Pre Race Anxiety: The Runner's Guide to Managing Performance Nerves — Runners Connect 2025", "quality_tier": "practitioner_review", "page": 2, "paragraph_index": 2, "keywords_en": ["sleep", "pre-race night", "anxiety", "insomnia", "race performance", "sleep deprivation"], "text": "Pre-race night insomnia is extremely common in marathon runners and is not predictive of performance impairment when the preceding training block included adequate sleep. Research shows that a single night of poor sleep before a race has minimal impact on endurance performance, provided the athlete has been well-rested during the training taper. Psychologist notes for race week should proactively include this evidence to reduce anxiety about sleep: knowing that one poor sleep night will not significantly harm performance breaks the anxiety-insomnia spiral."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_wall_definition_epidemiology_0053", "source_registry_id": "src_marathon_hitting_wall_mental_strategies_2026", "source_file": "marathon_hitting_wall_mental_strategies_2026.url", "source_path": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_url": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_label": "Marathon Mindset: Proven Strategies to Survive the Wall and Cross the Finish Line — Runlovers 2026", "quality_tier": "practitioner_review", "page": 2, "paragraph_index": 1, "keywords_en": ["hitting the wall", "bonk", "marathon", "glycogen depletion", "prevalence"], "text": "Research indicates that 43–53% of marathon runners experience hitting the wall — characterized by four features: generalized fatigue beyond expected tiredness, unintentional pace reduction, strong desire to walk, and a psychological shift from performance focus to pure survival. Understanding the prevalence and phenomenology of the wall normalizes the experience for runners and supports a proactive preparation mindset. The psychologist node should include a brief description of the wall in race-week notes for runners completing their first or second marathon."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_wall_brain_effort_perception_0054", "source_registry_id": "src_marathon_hitting_wall_mental_strategies_2026", "source_file": "marathon_hitting_wall_mental_strategies_2026.url", "source_path": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_url": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_label": "Marathon Mindset: Proven Strategies to Survive the Wall and Cross the Finish Line — Runlovers 2026", "quality_tier": "practitioner_review", "page": 2, "paragraph_index": 2, "keywords_en": ["perception of effort", "Marcora", "brain", "central governor", "effort", "psychobiological model"], "text": "Marcora's psychobiological model of endurance establishes that the decision to slow or stop is generated by the brain's perception of effort relative to its willingness to continue, not by muscular failure per se. This model predicts that psychological interventions — self-talk, distraction, reappraisal — can alter the brain's effort perception independently of physiological state. The implication for marathon runners: building a mental skills toolkit for the wall is a legitimate performance investment, not a psychological luxury."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_wall_acceptance_strategy_0055", "source_registry_id": "src_marathon_hitting_wall_mental_strategies_2026", "source_file": "marathon_hitting_wall_mental_strategies_2026.url", "source_path": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_url": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_label": "Marathon Mindset: Proven Strategies to Survive the Wall and Cross the Finish Line — Runlovers 2026", "quality_tier": "practitioner_review", "page": 3, "paragraph_index": 1, "keywords_en": ["acceptance", "wall", "discomfort", "psychological preparation", "pain normalization"], "text": "Acceptance is the foundational psychological strategy for managing the wall: beginning the race with the mental preparation that difficulty, fatigue, and psychological resistance will occur in the final third. Runners who start a marathon already having accepted that the last 10 km will be hard are better positioned cognitively than those who expect the race to feel consistently manageable. The psychologist node can include a 'race acceptance script' in final preparation notes: 'The last 10 km will be the hardest. That is the race. You are prepared for it.'"}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_wall_chunking_strategy_0056", "source_registry_id": "src_marathon_hitting_wall_mental_strategies_2026", "source_file": "marathon_hitting_wall_mental_strategies_2026.url", "source_path": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_url": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_label": "Marathon Mindset: Proven Strategies to Survive the Wall and Cross the Finish Line — Runlovers 2026", "quality_tier": "practitioner_review", "page": 3, "paragraph_index": 2, "keywords_en": ["chunking", "segmentation", "distance management", "mental units", "cognitive load"], "text": "Chunking — mentally dividing the remaining race distance into small, manageable units — is a well-supported strategy for managing the wall. When 6 miles feel impossible as a whole, 'run to the next aid station' is psychologically achievable. Research on endurance psychology confirms that chunking reduces the perceived cognitive burden of remaining distance and increases runners' sense of control. Practical chunk sizes: aid stations (~1.5 miles), kilometer markers, or time-based units (the next 10 minutes)."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_wall_goal_adjustment_0057", "source_registry_id": "src_marathon_hitting_wall_mental_strategies_2026", "source_file": "marathon_hitting_wall_mental_strategies_2026.url", "source_path": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_url": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_label": "Marathon Mindset: Proven Strategies to Survive the Wall and Cross the Finish Line — Runlovers 2026", "quality_tier": "practitioner_review", "page": 4, "paragraph_index": 1, "keywords_en": ["goal adjustment", "B goal", "completion", "wall", "flexibility", "cognitive flexibility"], "text": "At the wall, rigid adherence to an A-goal time target when physiological and psychological resources are critically depleted produces the worst outcomes. Sport psychology recommends pre-committing to a goal adjustment protocol: at a defined struggle point, the runner explicitly releases the time goal and adopts a completion or execution goal. Research shows that this deliberate goal pivot — rather than gradual drift into despair — preserves more motivational energy and produces better finish times than clinging to an unachievable target. This protocol should be briefed explicitly in race-week psychologist notes."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_wall_social_motivation_0058", "source_registry_id": "src_marathon_hitting_wall_mental_strategies_2026", "source_file": "marathon_hitting_wall_mental_strategies_2026.url", "source_path": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_url": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_label": "Marathon Mindset: Proven Strategies to Survive the Wall and Cross the Finish Line — Runlovers 2026", "quality_tier": "practitioner_review", "page": 4, "paragraph_index": 2, "keywords_en": ["social motivation", "running for others", "positive dissociation", "charity", "motivation anchor"], "text": "When intrinsic motivation collapses at the wall, redirecting motivation to an external anchor — running for a specific person, cause, or commitment — provides a powerful alternative motivational source. This technique, sometimes called positive dissociation, shifts the emotional reference point from self-centered pain to outward-facing purpose. Runners who have identified a specific person they are running for before the race report greater resilience at the wall. The psychologist node can invite runners to identify their motivation anchor in the race preparation notes phase."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_wall_cognitive_engagement_0059", "source_registry_id": "src_marathon_hitting_wall_mental_strategies_2026", "source_file": "marathon_hitting_wall_mental_strategies_2026.url", "source_path": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_url": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_label": "Marathon Mindset: Proven Strategies to Survive the Wall and Cross the Finish Line — Runlovers 2026", "quality_tier": "practitioner_review", "page": 5, "paragraph_index": 1, "keywords_en": ["cognitive engagement", "decision-making", "active running", "wall", "mental dropout"], "text": "Research on wall experiences shows that passive cognitive dropout — allowing attention to spiral into pain catastrophizing or despairing thoughts — significantly worsens both the subjective experience and the objective pace outcome. Staying cognitively active at the wall — counting steps, actively choosing a focus strategy, engaging with the environment — prevents the passive negative spiral. The psychologist node can include a 'stay cognitively active at mile 20' script as part of race-phase mental preparation notes."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_wall_mantra_preparation_0060", "source_registry_id": "src_marathon_hitting_wall_mental_strategies_2026", "source_file": "marathon_hitting_wall_mental_strategies_2026.url", "source_path": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_url": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_label": "Marathon Mindset: Proven Strategies to Survive the Wall and Cross the Finish Line — Runlovers 2026", "quality_tier": "practitioner_review", "page": 5, "paragraph_index": 2, "keywords_en": ["mantra", "wall", "crisis point", "pre-planned", "self-talk preparation"], "text": "Runners who have pre-planned specific mantras for their anticipated wall moment — rather than improvising self-talk under stress — report greater confidence and more effective forward momentum during race crises. A wall-specific mantra should be: brief, honest (not denying difficulty), approach-oriented, and personally meaningful. Examples: 'This is the race', 'You know this feeling', 'One more minute'. The psychologist node should include wall-specific mantra suggestions in race-phase preparation notes, distinct from general training mantras."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_mindfulness_mbsr_sport_0061", "source_registry_id": "src_mindfulness_sport_mbi_umbrella_2025", "source_file": "mindfulness_sport_mbi_umbrella_2025.url", "source_path": "https://www.sciencedirect.com/science/article/pii/S1728869X2500053X", "source_url": "https://www.sciencedirect.com/science/article/pii/S1728869X2500053X", "source_label": "Impact of mindfulness-based interventions on sports performance and mental health: An umbrella review — ScienceDirect 2025", "quality_tier": "systematic_review_meta_analysis", "page": 1, "paragraph_index": 1, "keywords_en": ["mindfulness", "MBSR", "sport performance", "stress reduction", "mental health"], "text": "Mindfulness-Based Stress Reduction (MBSR) and sport-adapted mindfulness protocols have accumulated strong evidence for reducing psychological distress, competitive anxiety, and burnout in endurance athletes. An umbrella review (ScienceDirect 2025) confirms MBIs reliably lower cognitive and somatic anxiety and improve emotional resilience in distance runners. For marathon preparation, even brief daily mindfulness practice (5–10 minutes) during the training block produces measurable improvements in stress regulation by race week."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_mindfulness_present_moment_0062", "source_registry_id": "src_mindfulness_sport_mbi_umbrella_2025", "source_file": "mindfulness_sport_mbi_umbrella_2025.url", "source_path": "https://www.sciencedirect.com/science/article/pii/S1728869X2500053X", "source_url": "https://www.sciencedirect.com/science/article/pii/S1728869X2500053X", "source_label": "Impact of mindfulness-based interventions on sports performance and mental health: An umbrella review — ScienceDirect 2025", "quality_tier": "systematic_review_meta_analysis", "page": 1, "paragraph_index": 2, "keywords_en": ["mindfulness", "present moment", "rumination", "worry", "race focus"], "text": "Mindfulness training's core mechanism in sport is the development of present-moment focus: the ability to notice thoughts and sensations without being pulled into rumination about past performances or anxiety about future outcomes. In a marathon race context, present-moment awareness prevents the 'kilometer 20 catastrophe loop' — the recursive worry about remaining distance and pace viability. Psychologist annotations can include a brief mindfulness prompt for each race phase: 'Right now, notice only this kilometer. What is your body doing well?'"}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_mac_protocol_overview_0063", "source_registry_id": "src_act_mac_sport_gardner_moore", "source_file": "act_mac_sport_gardner_moore.url", "source_path": "https://dreddieoconnor.com/blog/acceptance-and-commitment-therapy/", "source_url": "https://dreddieoconnor.com/blog/acceptance-and-commitment-therapy/", "source_label": "Acceptance and Commitment Therapy (ACT) in Sport — Dr. Eddie O'Connor Sports Psychologist review", "quality_tier": "expert_review", "page": 1, "paragraph_index": 1, "keywords_en": ["MAC", "Mindfulness Acceptance Commitment", "Gardner", "Moore", "sport psychology protocol"], "text": "The Mindfulness-Acceptance-Commitment (MAC) protocol, developed by Gardner and Moore (2007), is the most empirically validated mindfulness-based intervention designed specifically for athletes. MAC integrates ACT principles — psychological flexibility, values clarification, committed action — with mindfulness training. It produces performance benefits through increasing the athlete's ability to stay present and engaged with valued action even while experiencing difficult thoughts and emotions. Case studies show marked performance improvements in elite athletes following 8-session MAC protocols."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_act_psychological_flexibility_0064", "source_registry_id": "src_act_mac_sport_gardner_moore", "source_file": "act_mac_sport_gardner_moore.url", "source_path": "https://dreddieoconnor.com/blog/acceptance-and-commitment-therapy/", "source_url": "https://dreddieoconnor.com/blog/acceptance-and-commitment-therapy/", "source_label": "Acceptance and Commitment Therapy (ACT) in Sport — Dr. Eddie O'Connor Sports Psychologist review", "quality_tier": "expert_review", "page": 1, "paragraph_index": 2, "keywords_en": ["ACT", "psychological flexibility", "defusion", "values", "committed action", "endurance"], "text": "ACT's key construct for endurance athletes is psychological flexibility: the ability to stay in contact with the present moment, open to difficult internal experiences, and committed to values-driven action regardless of uncomfortable thoughts or sensations. In a marathon context, psychological flexibility means continuing to run at target pace even when unhelpful thoughts arise ('I'm falling apart') — observing the thought without being controlled by it. This defusion from unhelpful thoughts is a trainable skill with direct performance implications."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_mindfulness_attention_regulation_0065", "source_registry_id": "src_mindfulness_sport_mbi_umbrella_2025", "source_file": "mindfulness_sport_mbi_umbrella_2025.url", "source_path": "https://www.sciencedirect.com/science/article/pii/S1728869X2500053X", "source_url": "https://www.sciencedirect.com/science/article/pii/S1728869X2500053X", "source_label": "Impact of mindfulness-based interventions on sports performance and mental health: An umbrella review — ScienceDirect 2025", "quality_tier": "systematic_review_meta_analysis", "page": 2, "paragraph_index": 1, "keywords_en": ["mindfulness", "attention regulation", "focus", "distraction", "performance"], "text": "Mindfulness training improves attention regulation — the ability to intentionally direct and sustain focus, and to notice when attention has wandered without judgment. For marathon runners, this translates directly to improved pacing accuracy (maintaining intended attention to effort rather than drifting into distraction-induced pace errors) and better recovery from adverse events during a race (refocusing after a fall or a missed split). Research from BMC Sports Science (2024) confirms a strong association between mindfulness and athletic mental skills, mediated by emotion regulation."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_mindfulness_pre_session_routine_0066", "source_registry_id": "src_mindfulness_sport_mbi_umbrella_2025", "source_file": "mindfulness_sport_mbi_umbrella_2025.url", "source_path": "https://www.sciencedirect.com/science/article/pii/S1728869X2500053X", "source_url": "https://www.sciencedirect.com/science/article/pii/S1728869X2500053X", "source_label": "Impact of mindfulness-based interventions on sports performance and mental health: An umbrella review — ScienceDirect 2025", "quality_tier": "systematic_review_meta_analysis", "page": 2, "paragraph_index": 2, "keywords_en": ["mindfulness", "pre-training", "body scan", "centering", "routine"], "text": "A 2–5 minute mindfulness body scan before key training sessions — noting physical sensations without judgment, releasing unnecessary tension, and setting an intentional focus for the session — supports both training quality and mental skill development. Research suggests this pre-session centering routine gradually reduces the training mental barrier and increases the athlete's sense of purposeful engagement with each workout. The psychologist node can include session-specific centering prompts as an annotation layer on high-intensity or long-run sessions."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_mindfulness_post_session_reflection_0067", "source_registry_id": "src_mindfulness_sport_mbi_umbrella_2025", "source_file": "mindfulness_sport_mbi_umbrella_2025.url", "source_path": "https://www.sciencedirect.com/science/article/pii/S1728869X2500053X", "source_url": "https://www.sciencedirect.com/science/article/pii/S1728869X2500053X", "source_label": "Impact of mindfulness-based interventions on sports performance and mental health: An umbrella review — ScienceDirect 2025", "quality_tier": "systematic_review_meta_analysis", "page": 3, "paragraph_index": 1, "keywords_en": ["mindfulness", "post-run", "reflection", "self-compassion", "growth mindset"], "text": "Post-session mindful reflection — briefly noting what went well, what was challenging, and what was learned, without evaluative self-judgment — supports both psychological recovery and skill development. Self-compassion, a component of mindfulness practice, predicts resilience after poor performances and prevents the negative rumination spiral that can impair motivation after a difficult session. Psychologist annotations for completed sessions can include a brief structured reflection prompt, particularly after sessions the runner has flagged as difficult."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_mindfulness_race_anxiety_rct_0068", "source_registry_id": "src_mindfulness_sport_mbi_umbrella_2025", "source_file": "mindfulness_sport_mbi_umbrella_2025.url", "source_path": "https://www.sciencedirect.com/science/article/pii/S1728869X2500053X", "source_url": "https://www.sciencedirect.com/science/article/pii/S1728869X2500053X", "source_label": "Impact of mindfulness-based interventions on sports performance and mental health: An umbrella review — ScienceDirect 2025", "quality_tier": "systematic_review_meta_analysis", "page": 3, "paragraph_index": 2, "keywords_en": ["mindfulness", "race anxiety", "randomized controlled trial", "distance runners", "intervention"], "text": "A randomized controlled trial in the MBI umbrella review (ScienceDirect 2025) specifically reported a significant decline in race-related anxiety for distance runners following an 8-week mindfulness-based intervention. The anxiety reduction was associated with improved pre-race self-efficacy and more consistent race execution. This evidence supports incorporating brief mindfulness practices throughout the marathon training plan rather than only in race week — the benefits accumulate over weeks of consistent practice."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_overtraining_burnout_definition_0069", "source_registry_id": "src_motivation_overtraining_burnout_sdt_2007", "source_file": "motivation_overtraining_burnout_sdt_2007.url", "source_path": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_url": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_label": "Motivation, overtraining, and burnout: Can self-determined motivation predict overtraining and burnout in elite athletes? — Taylor & Francis 2007", "quality_tier": "peer_reviewed_study", "page": 1, "paragraph_index": 1, "keywords_en": ["overtraining", "burnout", "psychology", "fatigue", "motivation loss"], "text": "Burnout in sport is defined as a psychological, physical, and emotional withdrawal from a formerly enjoyable and motivating activity resulting from prolonged or chronic stress. It is distinct from acute overtraining fatigue: overtraining is physiological and resolves with adequate rest, while burnout involves psychological disengagement that requires motivational and values-based recovery. The psychologist node should distinguish these two states in its explanatory annotations and recommend professional support for burnout presentations."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_overtraining_sdt_motivation_0070", "source_registry_id": "src_motivation_overtraining_burnout_sdt_2007", "source_file": "motivation_overtraining_burnout_sdt_2007.url", "source_path": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_url": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_label": "Motivation, overtraining, and burnout: Can self-determined motivation predict overtraining and burnout in elite athletes? — Taylor & Francis 2007", "quality_tier": "peer_reviewed_study", "page": 1, "paragraph_index": 2, "keywords_en": ["SDT", "self-determination theory", "autonomy", "overtraining", "burnout prediction"], "text": "Research (Lemyre et al., 2007 — Taylor & Francis) confirms that athletes with lower self-determined motivation are significantly more likely to develop overtraining syndrome and burnout. SDT predicts that when autonomy, competence, and relatedness needs are unmet — for example, when training feels externally controlled or disconnected from personal values — motivation erodes under training load. The psychologist node can include brief autonomy-support notes in high-load weeks: explaining the rationale for a demanding session reconnects it to the runner's stated goals and restores the autonomy-of-purpose that sustains motivation."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_overtraining_warning_signs_0071", "source_registry_id": "src_motivation_overtraining_burnout_sdt_2007", "source_file": "motivation_overtraining_burnout_sdt_2007.url", "source_path": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_url": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_label": "Motivation, overtraining, and burnout: Can self-determined motivation predict overtraining and burnout in elite athletes? — Taylor & Francis 2007", "quality_tier": "peer_reviewed_study", "page": 2, "paragraph_index": 1, "keywords_en": ["overtraining warning signs", "mood disturbance", "POMS", "motivation loss", "irritability"], "text": "Early psychological warning signs of overtraining syndrome overlap substantially with depression: persistent low motivation, irritability, sleep disturbance, elevated perceived exertion at submaximal efforts, and loss of enjoyment in previously motivating activities. The Profile of Mood States (POMS) measure detects early overtraining indicators via mood shifts, particularly vigor reduction and fatigue increase, before physiological markers become prominent. The psychologist node should flag combinations of these mood indicators in runner self-reports, recommending coach review before advancing training load."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_overtraining_prevention_load_0072", "source_registry_id": "src_motivation_overtraining_burnout_sdt_2007", "source_file": "motivation_overtraining_burnout_sdt_2007.url", "source_path": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_url": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_label": "Motivation, overtraining, and burnout: Can self-determined motivation predict overtraining and burnout in elite athletes? — Taylor & Francis 2007", "quality_tier": "peer_reviewed_study", "page": 2, "paragraph_index": 2, "keywords_en": ["overtraining prevention", "recovery", "periodization", "load management", "mental health"], "text": "Prevention of overtraining syndrome requires both physical periodization (planned recovery weeks and deload phases) and psychological monitoring. Research shows that cutting back on training load and intensity when early warning signs appear is associated with rapid recovery of positive mood states and motivation. The psychologist node should not prescribe load changes — that is the executor's role — but can provide evidence-based explanations for why scheduled recovery weeks serve both physiological and psychological protective functions."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_motivation_intrinsic_adherence_0073", "source_registry_id": "src_motivation_overtraining_burnout_sdt_2007", "source_file": "motivation_overtraining_burnout_sdt_2007.url", "source_path": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_url": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_label": "Motivation, overtraining, and burnout: Can self-determined motivation predict overtraining and burnout in elite athletes? — Taylor & Francis 2007", "quality_tier": "peer_reviewed_study", "page": 3, "paragraph_index": 1, "keywords_en": ["intrinsic motivation", "adherence", "long-term", "enjoyment", "values", "meaning"], "text": "Long-term training adherence in amateur marathon runners is primarily predicted by intrinsic motivation — running because it is personally meaningful, enjoyable, or identity-aligned — rather than extrinsic motivation (performance targets, social approval). Research consistently shows that intrinsic motivators sustain training through difficult periods while extrinsic motivators lose effectiveness under fatigue or setbacks. The psychologist node can support intrinsic motivation by periodically reconnecting training demands to the runner's stated personal meaning and values in its annotations."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_motivation_fun_and_variety_0074", "source_registry_id": "src_motivation_overtraining_burnout_sdt_2007", "source_file": "motivation_overtraining_burnout_sdt_2007.url", "source_path": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_url": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_label": "Motivation, overtraining, and burnout: Can self-determined motivation predict overtraining and burnout in elite athletes? — Taylor & Francis 2007", "quality_tier": "peer_reviewed_study", "page": 3, "paragraph_index": 2, "keywords_en": ["variety", "enjoyment", "training motivation", "monotony", "renewal", "adherence"], "text": "Sport psychology recommendations for preventing motivational burnout during long training blocks include incorporating variety — varying route, terrain, training partner, workout format — to maintain novelty and enjoyment. Monotony is an independent predictor of dropout and motivation loss even when physiological load remains appropriate. The psychologist node can suggest experiential variety as an annotation in multi-week training phases, particularly during mid-block phases when motivation characteristically dips."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_motivation_social_support_0075", "source_registry_id": "src_motivation_overtraining_burnout_sdt_2007", "source_file": "motivation_overtraining_burnout_sdt_2007.url", "source_path": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_url": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_label": "Motivation, overtraining, and burnout: Can self-determined motivation predict overtraining and burnout in elite athletes? — Taylor & Francis 2007", "quality_tier": "peer_reviewed_study", "page": 4, "paragraph_index": 1, "keywords_en": ["social support", "accountability", "community", "training partner", "motivation"], "text": "Social support is one of the strongest predictors of long-term exercise adherence in recreational athletes. Training with a partner or group increases accountability, provides relatedness need-satisfaction (per SDT), and buffers stress. Research confirms that joining a running group or having a virtual accountability partner through tracking apps significantly increases training completion rates. Psychologist annotations can acknowledge social training context in the runner's profile and include brief suggestions for community-based motivation strategies during solitary high-load blocks."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_motivation_milestone_recognition_0076", "source_registry_id": "src_goal_setting_sport_exercise_locke_latham_2002", "source_file": "goal_setting_sport_exercise_locke_latham_2002.url", "source_path": "https://med.stanford.edu/content/dam/sm/s-spire/documents/PD.locke-and-latham-retrospective_Paper.pdf", "source_url": "https://med.stanford.edu/content/dam/sm/s-spire/documents/PD.locke-and-latham-retrospective_Paper.pdf", "source_label": "Building a Practically Useful Theory of Goal Setting and Task Motivation — Locke & Latham 2002, American Psychologist", "quality_tier": "peer_reviewed_study", "page": 4, "paragraph_index": 1, "keywords_en": ["milestone", "recognition", "progress tracking", "self-efficacy", "motivation"], "text": "Regular recognition of training milestones — completing a long run PB, finishing the first back-to-back long run weekend, completing 6 consecutive weeks — provides self-efficacy reinforcement and motivational momentum. Research on goal-setting and motivation confirms that acknowledging progress toward intermediate milestones is critical for sustaining effort toward long-term goals. The psychologist node can generate brief milestone recognition annotations when runners complete significant training achievements, framing the accomplishment in terms of race readiness."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_anxiety_IZOF_optimal_0077", "source_registry_id": "src_prerace_anxiety_runners_guide_2025", "source_file": "prerace_anxiety_runners_guide_2025.url", "source_path": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_url": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_label": "Beat Pre Race Anxiety: The Runner's Guide to Managing Performance Nerves — Runners Connect 2025", "quality_tier": "practitioner_review", "page": 3, "paragraph_index": 1, "keywords_en": ["IZOF", "optimal anxiety", "performance", "individual zone", "facilitating anxiety"], "text": "Hanin's Individual Zone of Optimal Functioning (IZOF) model establishes that some anxiety is beneficial for marathon performance — it is the level and quality of anxiety that matters, not its presence. Anxiety within the individual's optimal zone facilitates performance; anxiety outside it (too high or too low) impairs it. A critical message for anxious runners: the goal is not to eliminate pre-race nerves but to understand them as a performance preparation signal, and to manage their intensity toward the optimal zone."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_anxiety_cognitive_vs_somatic_0078", "source_registry_id": "src_prerace_anxiety_runners_guide_2025", "source_file": "prerace_anxiety_runners_guide_2025.url", "source_path": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_url": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_label": "Beat Pre Race Anxiety: The Runner's Guide to Managing Performance Nerves — Runners Connect 2025", "quality_tier": "practitioner_review", "page": 3, "paragraph_index": 2, "keywords_en": ["cognitive anxiety", "somatic anxiety", "pre-race", "worry", "physical symptoms"], "text": "Pre-race anxiety has two distinguishable components: cognitive anxiety (worry thoughts about performance) and somatic anxiety (physical symptoms — heart rate, stomach distress, muscle tension). They respond to different interventions: cognitive anxiety is best managed with cognitive restructuring and attentional redirection; somatic anxiety responds to controlled breathing and progressive muscle relaxation. Psychologist annotations in race week should address both components, as runners often conflate the two and apply general 'calming' strategies that only address one."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_anxiety_PST_program_0079", "source_registry_id": "src_sport_psychology_psych_interventions_meta_2024", "source_file": "psychological_interventions_sport_performance_meta_2024.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_label": "Psychological interventions for sports performance systematic review and meta-analysis — PMC 2024", "quality_tier": "systematic_review_meta_analysis", "page": 3, "paragraph_index": 1, "keywords_en": ["PST", "psychological skills training", "marathon", "pre-race anxiety", "intervention"], "text": "Research has demonstrated the effectiveness of Psychological Skill Training (PST) programs to help amateur marathon runners manage excess pre-race anxiety and the disruptive negative thoughts that accompany it. A structured PST program for a 16-week marathon block includes: relaxation training (weeks 1–3), attentional skills (weeks 4–7), visualization (weeks 8–11), goal-setting refinement (weeks 12–14), and race simulation mental rehearsal (weeks 15–16). The psychologist node can frame its annotations as phase-aligned psychological skill development rather than one-off advice."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_anxiety_reappraisal_facilitating_0080", "source_registry_id": "src_prerace_anxiety_runners_guide_2025", "source_file": "prerace_anxiety_runners_guide_2025.url", "source_path": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_url": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_label": "Beat Pre Race Anxiety: The Runner's Guide to Managing Performance Nerves — Runners Connect 2025", "quality_tier": "practitioner_review", "page": 4, "paragraph_index": 1, "keywords_en": ["anxiety reappraisal", "facilitating", "performance", "arousal interpretation", "challenge response"], "text": "Research by Alison Wood Brooks (2014, Journal of Experimental Psychology) found that reappraising pre-performance anxiety as excitement ('I am excited') rather than attempting to calm down produced superior performance outcomes. The mechanism is arousal congruence: the physiological state of anxiety (high activation) is closer to excitement than to calm, making the transition to excitement more achievable and more motivating than suppression. For marathon runners, psychologist race-week scripts can include the reappraisal prompt: 'You are not nervous — you are ready.'"}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_anxiety_gender_differences_0081", "source_registry_id": "src_prerace_anxiety_runners_guide_2025", "source_file": "prerace_anxiety_runners_guide_2025.url", "source_path": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_url": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_label": "Beat Pre Race Anxiety: The Runner's Guide to Managing Performance Nerves — Runners Connect 2025", "quality_tier": "practitioner_review", "page": 4, "paragraph_index": 2, "keywords_en": ["gender", "anxiety", "women", "social support", "pre-race", "research"], "text": "Research consistently finds that female marathon runners report higher pre-race anxiety and greater reliance on social support coping strategies compared with male runners. Female runners may also benefit more from confidence-building visualization and social support activation strategies before races. The psychologist node should be aware of this evidence when interpreting runner self-reports — elevated anxiety in female runners is normative and does not necessarily indicate pathological distress, but it may call for more robust pre-race psychological preparation scaffolding."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_confidence_self_efficacy_sources_0082", "source_registry_id": "src_prerace_anxiety_runners_guide_2025", "source_file": "prerace_anxiety_runners_guide_2025.url", "source_path": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_url": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_label": "Beat Pre Race Anxiety: The Runner's Guide to Managing Performance Nerves — Runners Connect 2025", "quality_tier": "practitioner_review", "page": 5, "paragraph_index": 1, "keywords_en": ["self-efficacy", "confidence", "Bandura", "four sources", "performance accomplishments"], "text": "Bandura's theory identifies four sources of self-efficacy relevant to marathon running: (1) performance accomplishments — the most powerful source, based on the runner's own training history; (2) vicarious experience — observing similar others succeed; (3) verbal persuasion — encouragement from coaches or peers; (4) physiological interpretation — reading physical readiness signals correctly. The psychologist node draws primarily on source 1 (training history evidence) and source 4 (physiological interpretation reframing) in its pre-race confidence-building annotations."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_confidence_training_evidence_0083", "source_registry_id": "src_prerace_anxiety_runners_guide_2025", "source_file": "prerace_anxiety_runners_guide_2025.url", "source_path": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_url": "https://runnersconnect.net/beat-pre-race-anxiety-the-runners-guide-to-managing-performance-nerves-2025/", "source_label": "Beat Pre Race Anxiety: The Runner's Guide to Managing Performance Nerves — Runners Connect 2025", "quality_tier": "practitioner_review", "page": 5, "paragraph_index": 2, "keywords_en": ["training evidence", "confidence", "long run", "taper", "readiness assessment"], "text": "A structured training evidence review in race week — summarizing the runner's completed key sessions, long run distances, cumulative mileage, and any breakthrough training moments — is one of the most effective confidence-building interventions available to a marathon assistant's psychologist node. Research shows that runners who can explicitly recall evidence of their preparation enter race day with higher self-efficacy and lower anxiety. The psychologist annotation for race week should include a training evidence summary drawn from the runner's session history."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_boundary_clinical_referral_0084", "source_registry_id": "src_visualization_imagery_sport_performance_review", "source_file": "visualization_imagery_sport_performance_review.url", "source_path": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_url": "https://www.researchgate.net/publication/344587632_Visualisation_techniques_in_sport_-_the_mental_road_map_for_success", "source_label": "Visualisation techniques in sport — the mental road map for success (ResearchGate review)", "quality_tier": "expert_review", "page": 5, "paragraph_index": 1, "keywords_en": ["clinical boundary", "referral", "mental health", "anxiety disorder", "sport psychologist"], "text": "The psychologist node in a marathon assistant operates strictly within the non-clinical sport psychology domain. Performance anxiety, race nerves, and motivational dips are within scope; persistent generalized anxiety, depression, disordered eating, or clinical-level psychological distress are outside scope and require referral to a qualified mental health professional. The IOC consensus statement on mental health in elite athletes (2019) frames athlete mental health as a safeguarding domain when symptoms are persistent, severe, or impairing daily function."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_confidence_comeback_after_poor_race_0085", "source_registry_id": "src_sport_psychology_psych_interventions_meta_2024", "source_file": "psychological_interventions_sport_performance_meta_2024.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_label": "Psychological interventions for sports performance systematic review and meta-analysis — PMC 2024", "quality_tier": "systematic_review_meta_analysis", "page": 4, "paragraph_index": 1, "keywords_en": ["recovery", "poor performance", "resilience", "growth mindset", "self-compassion"], "text": "Recovery from a poor marathon performance — a DNF, a missed time goal, or a race derailed by injury or illness — requires psychological recovery alongside physical recovery. Sport psychology recommendations include: (1) allowing a period of honest disappointment without self-attack; (2) analyzing what was within vs. outside control; (3) identifying what was learned; (4) reframing the experience in terms of long-term athletic development. Self-compassion (treating oneself as one would a respected friend who failed) is a more effective recovery strategy than self-criticism."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_race_execution_focus_plan_0086", "source_registry_id": "src_prerace_routine_psychological_effects_2025", "source_file": "prerace_routine_psychological_effects_2025.url", "source_path": "https://www.researchgate.net/publication/395585347_Pre-Game_Routines_and_Their_Psychological_Effects_on_Performance_Consistency", "source_url": "https://www.researchgate.net/publication/395585347_Pre-Game_Routines_and_Their_Psychological_Effects_on_Performance_Consistency", "source_label": "Pre-Game Routines and Their Psychological Effects on Performance Consistency — ResearchGate 2025", "quality_tier": "peer_reviewed_study", "page": 3, "paragraph_index": 1, "keywords_en": ["race execution", "focus plan", "process focus", "distraction", "pre-race strategy"], "text": "A race focus plan — a pre-agreed structure for where to direct attention at each stage of the marathon — provides a cognitive anchor that prevents anxiety-driven attention drift on race day. Research on pre-performance routines confirms that athletes with explicit attention plans execute more consistently in competition than those without. A marathon focus plan typically specifies: start-line attention (breathing, posture, calm), first 10 km (controlled effort, resist surging), middle miles (process cues, form checks), final 10 km (effort-based attention, chunking, motivational self-talk)."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_race_phase_start_mental_0087", "source_registry_id": "src_prerace_routine_psychological_effects_2025", "source_file": "prerace_routine_psychological_effects_2025.url", "source_path": "https://www.researchgate.net/publication/395585347_Pre-Game_Routines_and_Their_Psychological_Effects_on_Performance_Consistency", "source_url": "https://www.researchgate.net/publication/395585347_Pre-Game_Routines_and_Their_Psychological_Effects_on_Performance_Consistency", "source_label": "Pre-Game Routines and Their Psychological Effects on Performance Consistency — ResearchGate 2025", "quality_tier": "peer_reviewed_study", "page": 3, "paragraph_index": 2, "keywords_en": ["race start", "arousal", "crowd", "adrenaline", "pacing risk", "mental start"], "text": "The marathon start is the highest-risk zone for pacing errors driven by psychological arousal: crowd energy, adrenaline, and the relief of race day combine to push pace 10–20 seconds per kilometer faster than planned. Research on marathon pacing failures identifies the first 10 km as the most common site of the pace errors that cause mid-race collapse. The psychologist node's race-week annotation should include a specific mental preparation for the start: 'Feel the crowd energy and release it — your pace plan was written for your fitness, not the crowd's enthusiasm.'"}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_race_phase_halfway_mental_0088", "source_registry_id": "src_marathon_hitting_wall_mental_strategies_2026", "source_file": "marathon_hitting_wall_mental_strategies_2026.url", "source_path": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_url": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_label": "Marathon Mindset: Proven Strategies to Survive the Wall and Cross the Finish Line — Runlovers 2026", "quality_tier": "practitioner_review", "page": 6, "paragraph_index": 1, "keywords_en": ["halfway", "km 21", "mental check-in", "goal assessment", "positive split risk"], "text": "The halfway point of a marathon is the optimal location for a structured mental check-in: assessing perceived effort versus actual pace, adjusting goal expectations if needed, and resetting attentional focus for the second half. Runners who perform a deliberate halfway mental check-in — rather than a continuous stream of undifferentiated effort — report better emotional regulation in the final third. Psychologist race-week notes can include a simple halfway check-in protocol: 'At km 21: pace check, energy assessment, B-goal review, and 3-breath reset.'"}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_race_phase_km30_mental_0089", "source_registry_id": "src_marathon_hitting_wall_mental_strategies_2026", "source_file": "marathon_hitting_wall_mental_strategies_2026.url", "source_path": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_url": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_label": "Marathon Mindset: Proven Strategies to Survive the Wall and Cross the Finish Line — Runlovers 2026", "quality_tier": "practitioner_review", "page": 6, "paragraph_index": 2, "keywords_en": ["km 30", "mental tough point", "challenge zone", "resilience", "commitment"], "text": "Kilometer 30 in a marathon is consistently identified as the most psychologically demanding phase — glycogen stores are depleting, residual fatigue is accumulating, and the finish remains 12 km away. Research on the marathon wall experience identifies this zone as where dissociation strategies tend to fail and runners require a shift to more cognitively active coping. Psychological preparation notes should specifically address the km 25–35 zone with a distinct set of mental strategies: chunking, wall acceptance, social motivation, and prepared mantras."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_race_phase_final5km_mental_0090", "source_registry_id": "src_marathon_hitting_wall_mental_strategies_2026", "source_file": "marathon_hitting_wall_mental_strategies_2026.url", "source_path": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_url": "https://runlovers.it/en/2026/marathon-mental-strategies-hitting-the-wall/", "source_label": "Marathon Mindset: Proven Strategies to Survive the Wall and Cross the Finish Line — Runlovers 2026", "quality_tier": "practitioner_review", "page": 7, "paragraph_index": 1, "keywords_en": ["final 5 km", "finish", "fatigue", "commitment cue", "emotional activation"], "text": "The final 5 km of a marathon presents a unique psychological dynamic: the finish is visible in concept, motivation often surges from proximity, and simultaneously fatigue is at its maximum. Sport psychology recommends transitioning from dissociative attention strategies to associative internal focus in the final 5 km to support accurate pace judgment, while using emotional activation cues (crowd noise, mental imagery of the finish line) to sustain effort. This final-phase attention shift should be explicitly rehearsed in visualization sessions before race day."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_weekly_psych_session_annotations_0091", "source_registry_id": "src_sport_psychology_psych_interventions_meta_2024", "source_file": "psychological_interventions_sport_performance_meta_2024.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_label": "Psychological interventions for sports performance systematic review and meta-analysis — PMC 2024", "quality_tier": "systematic_review_meta_analysis", "page": 5, "paragraph_index": 1, "keywords_en": ["weekly cycle", "annotations", "pre-workout", "post-workout", "psychology integration"], "text": "Effective integration of sport psychology into marathon training involves per-session annotation layers rather than isolated race-week preparation. Research on PST programs confirms that psychological skills — like physical fitness — develop through consistent practice across the training block. In a marathon assistant context, the psychologist node should provide: (1) pre-workout intentional focus prompts for key sessions; (2) brief post-workout reflection questions for long runs and interval sessions; (3) phase-aligned mental skill themes that evolve across the training plan macrocycle."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_training_block_periodization_mental_0092", "source_registry_id": "src_sport_psychology_psych_interventions_meta_2024", "source_file": "psychological_interventions_sport_performance_meta_2024.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_label": "Psychological interventions for sports performance systematic review and meta-analysis — PMC 2024", "quality_tier": "systematic_review_meta_analysis", "page": 5, "paragraph_index": 2, "keywords_en": ["mental periodization", "training block", "psychological skill development", "phase alignment"], "text": "Just as physical training is periodized across base, build, and peak phases, psychological skill development can be periodized to align with the physical demands of each training phase. Base phase: emphasis on motivation, identity, and goal clarity. Build phase: developing pain tolerance, self-talk skills, and attention strategies during increasing-intensity sessions. Peak phase: visualization, race-scenario rehearsal, anxiety management, and pre-race routine development. Taper phase: confidence maintenance, anxiety management, and race execution planning. This phase-aligned structure maximizes psychological readiness at race day."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_injury_mental_impact_0093", "source_registry_id": "src_pain_coping_ultra_endurance_pmc_2025", "source_file": "pain_coping_ultra_endurance_pmc_2025.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12476407/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12476407/", "source_label": "Human Resilience and Pain Coping Strategies — Elite Ultra-Endurance Athletes Review, PMC 2025", "quality_tier": "systematic_review_meta_analysis", "page": 4, "paragraph_index": 1, "keywords_en": ["injury psychology", "fear of re-injury", "confidence loss", "return to sport", "rehabilitation"], "text": "Injury interrupts marathon training not only physically but psychologically: research documents significant confidence loss, fear of re-injury, mood disturbance, and identity disruption in recreational runners following injury. Psychological recovery from injury should be considered a parallel process to physical rehabilitation. Key psychological tasks during recovery: maintaining training identity through adapted activity, using visualization to preserve motor representations, and gradually rebuilding confidence through progressive return-to-training milestones."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_sleep_performance_mental_0094", "source_registry_id": "src_motivation_overtraining_burnout_sdt_2007", "source_file": "motivation_overtraining_burnout_sdt_2007.url", "source_path": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_url": "https://www.tandfonline.com/doi/full/10.1080/17461390701302607", "source_label": "Motivation, overtraining, and burnout: Can self-determined motivation predict overtraining and burnout in elite athletes? — Taylor & Francis 2007", "quality_tier": "peer_reviewed_study", "page": 5, "paragraph_index": 1, "keywords_en": ["sleep", "mental recovery", "overtraining", "mood", "HRV", "recovery monitoring"], "text": "Sleep quality is the primary driver of psychological recovery from training stress. Research shows that sleep deprivation impairs mood, motivation, pain tolerance, and self-regulation — the exact psychological capacities required for marathon training adherence and race execution. In training periods with elevated load, sleep monitoring (quality, duration) is as important as HRV for detecting emerging psychological overreach. Psychologist annotations in high-load weeks should include sleep quality prompts and provide evidence-based sleep hygiene guidance as preparation support."}
{"domain_terms": ["sport_psychology"], "evidence_domain": "sport_psychology", "expert_domain": "sport_psychology", "domain_pack": "psychological_skills", "knowledge_layer": "document_index", "allowed_use": "explanation", "prescription_permission": "explanation_only", "exclude_from_training_generation": true, "display_mode": "verified_source", "evidence_source_type": "retrieval_evidence", "can_write_core": false, "explanation_only": true, "review_status": "approved", "needs_review": false, "language": "en", "section": "curated_summary", "has_full_text": true, "source_status": "ready", "chunk_id": "sport_psychology_post_race_recovery_mental_0095", "source_registry_id": "src_sport_psychology_psych_interventions_meta_2024", "source_file": "psychological_interventions_sport_performance_meta_2024.url", "source_path": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10933186/", "source_label": "Psychological interventions for sports performance systematic review and meta-analysis — PMC 2024", "quality_tier": "systematic_review_meta_analysis", "page": 6, "paragraph_index": 1, "keywords_en": ["post-race", "psychological recovery", "post-marathon blues", "meaning", "future goals"], "text": "Post-marathon psychological recovery includes managing 'post-marathon blues' — a well-documented mood dip in the 1–4 weeks following a marathon, characterized by reduced motivation, mild low mood, and identity disruption. The phenomenon is partly physiological (hormonal and inflammatory) and partly psychological (loss of goal structure). Research-supported strategies: acknowledging the blues as normal and expected, maintaining light activity for physical mood regulation, and beginning to develop future goals to restore motivational direction. The psychologist node should flag post-race recovery as a distinct phase."}
{"chunk_id": "sport_psychology_expand_0097", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Jackson & Csikszentmihalyi 1999 Flow in Sports; Jackson 1992 J Sport Exerc Psychol", "text": "Nine dimensions characterize the flow state as identified by Jackson and Csikszentmihalyi (1999): (1) challenge-skill balance — perceived challenge matches current ability; (2) action-awareness merging — doing and thinking unify; (3) clear goals — knowing what to do moment-to-moment; (4) unambiguous feedback — continuous sense of performance; (5) concentration on task — complete focus; (6) sense of control — feeling in command without trying; (7) loss of self-consciousness — reduced ego; (8) time transformation — time passes unusually; (9) autotelic experience — intrinsically rewarding. All nine need not be present simultaneously for a partial flow experience."}
{"chunk_id": "sport_psychology_expand_0098", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Stoll et al. 2010; Jackson et al. 1998 J Sport Exerc Psychol 20(4)", "text": "Research by Stoll et al. on marathon runners found that flow frequency increases significantly with running experience and training volume. Beginning marathon runners rarely report flow; experienced runners report flow in approximately 15–25% of training runs and in 35–50% of race experiences when conditions are favorable. The gateway condition for flow in distance running is typically challenge-skill balance: when the planned pace feels appropriately (but not overwhelmingly) demanding."}
{"chunk_id": "sport_psychology_expand_0099", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Jackson & Roberts 1992; Bernier et al. 2009 J Applied Sport Psychol", "text": "Four conditions reliably facilitate flow entry in marathon running: (1) a clear, attainable goal for the session or race (e.g., a specific target pace band); (2) a pre-run preparation routine that shifts attention from external concerns to the physical present; (3) the right perceived challenge level — a target that feels hard but achievable; (4) early-run positive feedback signals — feeling good through the first 2–3 km tends to facilitate deeper absorption."}
{"chunk_id": "sport_psychology_expand_0100", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Karageorghis & Priest 2012 Int Rev Sport Exerc Psychol; Laukka & Quick 2013", "text": "Music's relationship to flow in running is complex. Research by Karageorghis & Priest (2012) found music facilitates flow entry in moderate-intensity running but may interrupt it at race intensities because music competes for attentional resources. The most consistent finding is that pre-run music primes positive affect and reduces perceived difficulty, but during a race, self-selected internal attentional strategies (associative focus, monitoring body signals) are more compatible with flow than music-driven dissociation."}
{"chunk_id": "sport_psychology_expand_0101", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Crust & Swann 2013; Hutto et al. 2014 Percept Mot Skills", "text": "Social facilitation of flow in group running: research on pacemaker groups in marathon racing shows that runners embedded in a pacing group report higher flow frequency than solo runners at the same pace. The mechanism is dual: (1) the pacemaker reduces conscious effort monitoring, freeing attentional resources for absorption; (2) shared rhythmic movement (entrainment) creates collective focus that parallels individual flow. Training groups and running clubs structurally support more frequent flow states."}
{"chunk_id": "sport_psychology_expand_0102", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Jackson 1995 J Sport Exerc Psychol 17(1); Swann et al. 2012 Psychol Sport Exerc", "text": "Interruptions to flow in marathon racing most commonly occur at: (1) significant physiological shifts — sudden onset of GI distress, cramping, or abrupt pace changes; (2) external novelty — crowd density changes, course turns; (3) clock or split monitoring — brief re-emergence of self-consciousness; (4) pain threshold transitions where cognitive coping effort exceeds passive absorption capacity. Re-entry into flow after interruption typically requires 3–8 minutes of deliberate refocusing."}
{"chunk_id": "sport_psychology_expand_0103", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Fuss et al. 2015 PNAS; Dietrich & McDaniel 2004 Br J Sports Med", "text": "Deep flow in marathon running — sometimes called 'runner's high' — involves endocannabinoid system activation alongside norepinephrine release, producing euphoria and pain reduction. Research by Dietrich & McDaniel (2004) and Fuss et al. (2015) indicates endocannabinoids, not endorphins, are the primary driver: endocannabinoids cross the blood-brain barrier while endorphins cannot. The endocannabinoid release threshold for most recreational runners appears to be approximately 45–60 minutes of continuous aerobic effort at moderate-to-high intensity."}
{"chunk_id": "sport_psychology_expand_0104", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Bernier et al. 2009; Jackson & Csikszentmihalyi 1999", "text": "Practical strategies for increasing flow probability in training: (1) set a specific pace or effort goal before every session rather than running without structure; (2) use a 5-minute pre-run breathing or mental centering ritual; (3) plan key sessions at times of peak energy (typically late morning for most runners); (4) choose familiar routes for quality sessions — novelty requires attention that competes with absorption; (5) run with partners at matched ability for long runs."}
{"chunk_id": "sport_psychology_expand_0105", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Swann et al. 2017; Jackson & Csikszentmihalyi 1999 ch.7", "text": "Marathon race conditions that statistically increase flow frequency based on runners' self-reports: weather in the 8–15°C range, flat or gently rolling course, personally meaningful competition context, and positive early splits. Conversely, excessive crowd noise in the first 3 km, unfavorable weather, and pressure from running alongside significantly faster or slower competitors all reduce flow probability. Pre-race flow facilitation therefore includes selecting appropriate corral placement to ensure early-km challenge-skill balance."}
{"chunk_id": "sport_psychology_expand_0106", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Swann et al. 2012; Wiggins et al. 2017 Sport Psychol", "text": "Research distinguishes two types of flow in running: 'forced' flow (entering flow unintentionally, usually during a race) and 'cultivated' flow (deliberately induced through practice, pre-run routine, and attention management). Experienced runners can often cultivate flow reliably; beginners are more likely to encounter it accidentally. Training flow cultivation — practicing attentional focusing routines and pre-session rituals — is a learnable skill that increases in effectiveness over approximately 8–16 weeks of consistent practice."}
{"chunk_id": "sport_psychology_expand_0107", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Anderson 1995 Sociol Sport J; Brewer Cornelius 1993 Int J Sport Psychol", "text": "Runner identity — the degree to which 'being a runner' is central to one's self-concept — is one of the strongest predictors of long-term marathon training adherence. Research by Anderson (1995) and Brewer et al. (1993) found that athletes with high sport identity (score ≥4 on the Athletic Identity Measurement Scale, AIMS) show 3× higher training completion rates in 16-week marathon programs compared to runners with low identity scores. Identity-based interventions are more durable than external reward-based motivation."}
{"chunk_id": "sport_psychology_expand_0108", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Shipway & Holloway 2010 Leis Stud; Cook & Speraw 2006", "text": "Runner identity follows a typical developmental trajectory across the first year of marathon training: (1) novelty stage (0–8 weeks) — 'I am someone who runs'; (2) habituation stage (8–20 weeks) — running becomes routine, less identity-defining; (3) commitment stage (20+ weeks, especially after a race event) — 'I am a runner' becomes a core identity label; (4) consolidation stage (post first marathon) — the identity anchors permanently in most runners. Identity strength increases rapidly after the first race completion."}
{"chunk_id": "sport_psychology_expand_0109", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Oyserman et al. 2012 J Exp Psychol Gen; Kendzierski 1994 J Sport Exerc Psychol", "text": "Identity-based motivation operates differently from behavioral motivation: while external rewards (medals, Strava segments) drive behavior, identity drives persistent effort even in the absence of rewards. When a runner misses training because of weather, illness, or schedule conflict, the degree to which they feel bad about the disruption — and prioritize returning — is a direct reflection of identity strength. Prompting runners to articulate 'who do you want to be as a runner' rather than 'what do you want to achieve' activates identity-level motivation."}
{"chunk_id": "sport_psychology_expand_0110", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Brewer et al. 1993 Sociol Sport J; Sparkes 1998 J Sport Exerc Psychol", "text": "Negative consequences of excessive runner identity: when running identity is too central and other life domains are underrepresented in self-concept, injury creates disproportionate psychological distress. Brewer (1993) found that athletes with exclusive sport identity show stronger depressive symptoms following injury than those with balanced multi-domain identity. A healthy runner identity supports consistency without requiring running to be the only valid self-expression. Psychologically, this means encouraging runners to maintain non-running identity domains (family roles, professional identity, hobbies)."}
{"chunk_id": "sport_psychology_expand_0111", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Howe & Bonsall 2015 Sociol Sport J; Veal & Raykov 2018", "text": "Strava and social running platforms accelerate identity formation: research by Howe & Bonsall (2015) found that digital logging and social validation (kudos, comments) significantly strengthen runner identity. However, the same platforms create identity threat when performance is publicly shared and comparisons are unfavorable. Runners who primarily build identity around pace and rank are more vulnerable to motivational collapse after a disappointing race than those who build identity around the training process and community membership."}
{"chunk_id": "sport_psychology_expand_0112", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Crossley 2006 Body Society; Shipway & Holloway 2010", "text": "Gender differences in runner identity: research consistently finds that male recreational runners more commonly build identity around performance outcomes (time, pace, ranking), while female recreational runners more frequently build identity around community, health, and personal challenge. This difference has practical implications: female marathon runners show less performance anxiety but are more sensitive to social exclusion within running communities. Coaching approaches should be tailored accordingly."}
{"chunk_id": "sport_psychology_expand_0113", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Lane & Wilson 2011 J Clin Sport Psychol; Buman et al. 2008", "text": "Post-marathon identity crisis: a significant minority of first-time marathon runners (estimated 15–25%) experience an identity void after completing their first race. Having organized life around the training goal for 16–24 weeks, the absence of structure can produce low mood, aimlessness, and reduced training motivation. This 'post-marathon blues' psychological component is distinct from physical fatigue recovery and responds to immediate goal-setting — registering for the next race or a defined off-season activity — within 1–2 weeks of race completion."}
{"chunk_id": "sport_psychology_expand_0114", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Dawson 2013 J Leis Res; Funk et al. 2004 Sport Manag Rev", "text": "Community belonging and collective runner identity: running clubs and training groups function not only as social support systems but as identity communities. Research by Dawson (2013) found that running club membership doubles training adherence rates and significantly increases marathon completion probability for first-time marathon runners. The mechanism is identity: being recognized as part of a running community creates social accountability that extends the identity from individual belief to collective recognition."}
{"chunk_id": "sport_psychology_expand_0115", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Baker et al. 2010 Gerontol; Stevens et al. 2021 Int J Aging Hum Dev", "text": "Runner identity and aging: as athletes enter master's running (40+), sport identity shifts from performance-centered to health-and-meaning-centered for most runners. Research on master's runners finds they sustain training motivation longer than young runners even as pace declines, because their identity is less dependent on performance outcomes. Clinical implication: coaches and psychologists working with aging runners should actively validate the 'process identity' — the value of the practice itself — to maintain motivation through inevitable performance decline."}
{"chunk_id": "sport_psychology_expand_0116", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Chan & Yung 2017; Li et al. 2020 Asia Pac J Sport Soc Sci", "text": "Cultural and context-specific runner identity: in Asian running communities, research indicates marathon participation is increasingly linked to social status and aspiration identity ('successful professional who also runs marathons'). This extrinsic identity driver produces high initial engagement but is more vulnerable to dropout when training becomes demanding and the aspirational identity is threatened. Applied implication: early in training, working to anchor identity in genuine enjoyment and process engagement rather than status affiliation increases long-term retention."}
{"chunk_id": "sport_psychology_expand_0117", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Kendzierski 1994; Anderson 1995; practitioner synthesis", "text": "Practical runner identity-strengthening techniques used in marathon coaching contexts: (1) journaling — writing a brief training log after each session reinforces 'I am someone who trains'; (2) visible reminders — race bibs, medals, running photos in living spaces prime identity; (3) language auditing — shifting from 'I exercise' to 'I train' and 'I run' at identity level; (4) community participation — attending running group events even during low-motivation periods; (5) volunteering at races — maintaining connection to the running world during injury layoff preserves identity."}
{"chunk_id": "sport_psychology_expand_0118", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Ogles & Masters 2003 J Sport Behav; Krouse et al. 2011", "text": "First-time marathon runners face a distinct psychological challenge structure compared to experienced runners: the majority of their difficulties are anticipatory (fear of the unknown) rather than experiential. Research by Ogles & Masters (2003) found that fear of not finishing, fear of embarrassment, and fear of physical harm are the top three psychological barriers for first-time marathon entrants, and that these fears are substantially worse in the 4–6 weeks before the race than during the race itself."}
{"chunk_id": "sport_psychology_expand_0119", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Ogles & Masters 2003; Buman et al. 2009 J Sport Exerc Psychol", "text": "The novice marathon training arc has predictable psychological crisis points: (1) Week 3–4 — the 'reality check' when training becomes genuinely difficult for the first time and dropout risk peaks; (2) First long run above 16 km — many beginners hit the wall conceptually before experiencing it physically; (3) Week 8–10 — cumulative fatigue creates low motivation days; (4) Final 4 weeks before race — taper anxiety peaks. Having pre-prepared mental scripts for each crisis point ('this is normal and temporary') significantly improves program completion rates."}
{"chunk_id": "sport_psychology_expand_0120", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Buunk & Gibbons 2007 J Exp Soc Psychol; Cerin et al. 2009", "text": "Comparison orientation is especially damaging in beginner marathon runners. Research consistently shows that first-time runners who frequently compare their pace and distance to experienced runners or average finishing times demonstrate higher dropout rates and lower intrinsic motivation than those who define success relative to personal progress. Psychologically, coaching beginners involves actively redirecting comparison from social to personal standards: 'compared to your week 1, not compared to that person's week 12.'"}
{"chunk_id": "sport_psychology_expand_0121", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Beals & Manore 2002; practitioner synthesis", "text": "The first long run — typically in weeks 6–8 of a first marathon program — represents a significant psychological threshold for beginner runners. For most, 14–18 km is the longest distance they have ever run, and the psychological weight of the unknown creates disproportionate pre-run anxiety. Pre-run preparation for this session should include: (1) explicit normalization of the fact that the final kilometers will be uncomfortable; (2) a conservative starting pace target (30–45 seconds per km slower than comfortable pace); (3) permission framing — 'walk if you need to' removes shame from a normal adaptive strategy."}
{"chunk_id": "sport_psychology_expand_0122", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Ogles & Masters 2003; Stevinson et al. 2005 Sport Exerc Health", "text": "Completion versus performance orientation in beginners: first-time marathon runners who set a primary goal of completing the marathon (process/completion orientation) report 40% higher race-day satisfaction and 60% higher probability of training for a second marathon compared to those with primary time goals, even when the time-goal runners achieve their targets. Applied implication: for beginner coaching, strongly emphasize 'finishing is the goal' regardless of time aspirations, while keeping time targets as secondary stretch goals."}
{"chunk_id": "sport_psychology_expand_0123", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Clance & Imes 1978 (original IS framework); Cook & Speraw 2006 sport application", "text": "Imposter syndrome in marathon running is commonly reported by beginners who feel they are 'not real runners' despite consistent training. This manifests as reluctance to wear race gear, discomfort in running shops, and avoidance of running communities. Research on exercise psychology and social comparison theory suggests this self-perception gap closes rapidly after race completion — the first finish line crossing is a psychological identity anchor that reliably eliminates imposter syndrome for most runners."}
{"chunk_id": "sport_psychology_expand_0124", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Buman et al. 2009; Mann et al. 2007 Psychol Sport Exerc", "text": "Training plan adherence in beginner runners: research on training compliance in 16-week marathon programs shows 40–60% of beginner runners modify the plan significantly (skipping sessions, shortening runs) due to psychological rather than physical constraints. The primary psychological drivers of non-compliance are: (1) all-or-nothing thinking ('I can't do the full run so I won't run at all'); (2) perfectionism about specific session targets; (3) shame about slow pace or walk breaks. Psychoeducation about plan flexibility and the training effect of imperfect adherence addresses these barriers."}
{"chunk_id": "sport_psychology_expand_0125", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Borg 1998 Perceived Exertion; Hamlin et al. 2012 J Sci Med Sport", "text": "The psychophysical relationship in beginners: beginning runners are less reliable at interpreting body signals than experienced runners. Research by Borg (1998) and studies on RPE calibration show that beginners systematically misrate effort — typically overestimating effort at moderate intensities and underestimating pace capacity. This creates a catch-22: they often run too fast in training ('feels slow enough') and feel inadequate because they 'can't handle' what should be easy paces. RPE education in early training is a psychological as much as a physiological intervention."}
{"chunk_id": "sport_psychology_expand_0126", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Rapoport 2010 Sports Med; Buman et al. 2009", "text": "The beginner's wall experience is psychologically distinct from the experienced runner's wall. For beginners, hitting the wall at 28–35 km typically involves sudden recognition that the finish line is much further than anticipated capacity — often producing panic rather than acceptance and strategic adjustment. Pre-race wall education — explicitly telling first-time marathoners 'you will likely hit a very hard patch around km 28–32, here is exactly what to do when that happens' — reduces panic response and improves race completion rates."}
{"chunk_id": "sport_psychology_expand_0127", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Bandura 1977 self-efficacy; Latimer et al. 2008 Health Psychol", "text": "Social proof and role models for beginner runners: research on behavior change demonstrates that observing demographically similar others completing a marathon ('people like me can do this') is the single most powerful external motivator for first-time entrants. This explains the surge in marathon participation following media coverage of diverse finishers and the success of 'running for a cause' fundraising programs, which embed social proof into the participation structure. Coaches and running communities should actively share diverse finisher stories with beginner runners."}
{"chunk_id": "sport_psychology_expand_0128", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Stoeber & Otto 2006 Pers Soc Psychol Rev; Flett & Hewitt 2005 Curr Dir Psychol Sci", "text": "Sport psychology distinguishes adaptive from maladaptive perfectionism in athletes. Adaptive perfectionism — setting high standards while maintaining flexibility and self-compassion when standards are not met — is associated with higher performance, greater resilience, and better training adherence in marathon runners. Maladaptive perfectionism — attaching self-worth to performance outcomes and experiencing shame on failure — is associated with higher dropout, burnout, and pre-race anxiety even when performance is objectively good."}
{"chunk_id": "sport_psychology_expand_0129", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Hewitt & Flett 1991 MPS; Stoeber et al. 2007 Psychol Sport Exerc", "text": "The Multidimensional Perfectionism Scale (MPS) applied to marathon runners identifies three problematic patterns: (1) self-oriented perfectionism ('my performance must be perfect') — high motivation driver but produces extreme distress on suboptimal performance days; (2) other-oriented perfectionism ('my training must impress others') — particularly activated by Strava/social sharing; (3) socially prescribed perfectionism ('I must meet others' expectations for runners') — most strongly associated with dropout and avoidance of racing."}
{"chunk_id": "sport_psychology_expand_0130", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Gould et al. 2002 Sport Psychol; Gustafsson et al. 2007 J Clin Sport Psychol", "text": "Perfectionism and injury risk: research by Gould et al. found that athletes with high maladaptive perfectionism are more likely to train through pain, skip rest days, and return from injury prematurely, because rest feels like failure and modified training feels inadequate. This creates a direct pathway from psychological perfectionism to physical overtraining and chronic injury. Identifying perfectionism early in marathon coaching is therefore both a psychological and injury-prevention intervention."}
{"chunk_id": "sport_psychology_expand_0131", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Neff et al. 2011; Mosewich et al. 2011 Psychol Sport Exerc", "text": "Performance-process reframing for perfectionistic runners: cognitive-behavioral approaches reduce maladaptive perfectionism in sport through (1) behavioral experiments — testing the belief 'if I run 10 seconds per km slower today it will destroy my fitness' by actually doing so and observing outcomes; (2) process-metric substitution — recording 'effort quality,' 'enjoyment,' and 'consistency' alongside pace metrics; (3) self-compassion training — extending to oneself the understanding one would give a training partner in the same situation."}
{"chunk_id": "sport_psychology_expand_0132", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Laukkanen & Virtanen 2016; Withrow 2019 Int J Sport Exerc Psychol", "text": "The relationship between GPS/Strava and perfectionism activation: real-time pace display makes perfectionist cognitions about performance continuously available during a training run. Research on technology and performance anxiety in recreational runners finds that running without a GPS device at least once per week significantly reduces training perfectionism and increases enjoyment. 'Data-free' runs are increasingly recommended by sport psychologists as a regular training adjunct — they also support internal effort calibration rather than device dependence."}
{"chunk_id": "sport_psychology_expand_0133", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner synthesis; Freimuth et al. 2011 Int J Ment Health Addict", "text": "Training log perfectionism: many marathon runners develop a compulsive relationship to their training log — feeling strong negative emotion when a day is blank. This 'log perfectionism' can be adaptive (maintaining commitment) or maladaptive (running injured rather than leaving a day empty, or covering up skipped sessions with false entries). A healthy training log framework records both completed and modified sessions honestly, including rest days as intentional training decisions rather than failures."}
{"chunk_id": "sport_psychology_expand_0134", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Mosewich et al. 2011 Psychol Sport Exerc; Neff & Germer 2013 J Clin Psychol", "text": "Self-compassion as an alternative to perfectionism: research by Mosewich et al. (2011, 2013) demonstrated that brief self-compassion interventions (writing a self-compassionate letter after a disappointing run) measurably reduced rumination and negative affect in female athletes and improved motivation for the next training session more effectively than analytical self-criticism. Self-compassion does not reduce effort or standards; research shows self-compassionate athletes actually maintain higher long-term training loads than self-critical ones due to lower burnout rates."}
{"chunk_id": "sport_psychology_expand_0135", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Deci & Ryan 2000 Handbook Res Self-Det; Edmunds et al. 2006 J Sport Sci", "text": "Self-Determination Theory (SDT, Deci & Ryan) organizes motivation into a continuum from fully extrinsic (running only for external rewards) to fully intrinsic (running because the activity itself is valued). Marathon training motivation quality — not just quantity — predicts long-term adherence: runners with autonomous motivation (identified and intrinsic regulation) show markedly higher training consistency over 12-month periods than those with controlled motivation (external or introjected regulation), even when initial enthusiasm is equivalent."}
{"chunk_id": "sport_psychology_expand_0136", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Edmunds et al. 2006 J Sport Sci 24(5); Vallerand 2007 Exercise Sci", "text": "The three basic psychological needs in SDT — competence, autonomy, and relatedness — map directly onto marathon training structure. Competence need satisfaction comes from measurable progress (faster splits, longer distances); autonomy need satisfaction comes from flexible training that allows personal choice; relatedness satisfaction comes from running community connection. When training programs satisfy all three needs simultaneously, dropout rates drop dramatically. Rigid, performance-only programs often satisfy competence but starve autonomy and relatedness."}
{"chunk_id": "sport_psychology_expand_0137", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Gollwitzer & Sheeran 2006 Adv Exp Soc Psychol; Hagger & Luszczynska 2014", "text": "Implementation intentions — specific 'if-then' plans ('If it rains on Tuesday, then I will run on the treadmill at 6am Wednesday') — are one of the most effective interventions for improving training adherence in recreational runners. A meta-analysis by Gollwitzer & Sheeran (2006) found that implementation intentions increase health behavior adherence by an average of 28% compared to motivation-only interventions. Marathon training psychologists recommend creating specific if-then plans for the top 5 anticipated barriers at the start of each training cycle."}
{"chunk_id": "sport_psychology_expand_0138", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Milkman et al. 2014 J Pers Soc Psychol; Milkman et al. 2021 Nature", "text": "Temptation bundling — pairing intrinsically unrewarding (but valuable) training sessions with intrinsically enjoyable activities — is an evidence-supported motivation strategy. Research by Milkman et al. (2014, JPSP) found that participants who could only access favorite podcast episodes while exercising showed 51% higher gym visit rates. For marathon training applications: designating specific podcasts, music playlists, or phone calls with friends as available only during scheduled training runs creates a reliable anticipatory reward that sustains motivation through low-enjoyment training phases."}
{"chunk_id": "sport_psychology_expand_0139", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Lally et al. 2010 Eur J Soc Psychol 40(6); Gardner et al. 2012 Br J Health Psychol", "text": "Habit formation in running: research on habit development (Lally et al. 2010) found that the average time for a new behavior to become automatic is 66 days (range 18–254), not the commonly cited 21 days. For marathon training, this means the commitment to run is still effortful in early training cycles. Identifying and protecting the 'critical window' of weeks 6–10 — when habit formation is incomplete but pre-race excitement has faded — is psychologically the most important adherence intervention in first-time marathon preparation."}
{"chunk_id": "sport_psychology_expand_0140", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Frederick & Loewenstein 1999; Wilson & Gilbert 2008 Curr Dir Psychol Sci", "text": "Hedonic adaptation in marathon training: the pleasure gained from completing a run decreases as the activity becomes familiar. This 'hedonic adaptation' is a primary driver of motivation decline in established runners who have lost the novelty of early progress. Evidence-based strategies to counter hedonic adaptation include: (1) varying training routes and formats; (2) setting new and personally meaningful goals (different race distance, terrain, time of day); (3) introducing training partners; (4) tracking effort quality rather than only outcomes; (5) periodically revisiting 'why I run' journaling."}
{"chunk_id": "sport_psychology_expand_0141", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Deci et al. 1999 Psychol Bull; Pelletier et al. 2001 J Appl Sport Psychol", "text": "Extrinsic motivation and its limits: research consistently shows that over-emphasizing external rewards (medals, rankings, Strava kudos) as primary motivation drivers undermines intrinsic motivation through the 'overjustification effect.' Runners who initially ran for enjoyment and then introduce strong external reward systems report reduced enjoyment of running itself. Marathon coaches should maintain a ratio in goal conversations heavily weighted toward internal values ('what running gives you') versus external outcomes ('what running earns you')."}
{"chunk_id": "sport_psychology_expand_0142", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Zeelenberg & Pieters 2007 J Pers Soc Psychol; Carver & Scheier 2000", "text": "Regret-based motivation in marathon running: many runners initially enter marathon training driven by a 'someday I'll regret not having tried this' frame. Research on anticipatory regret (Zeelenberg & Pieters 2007) confirms this is a powerful but short-duration motivator — effective for initial sign-up but insufficient for sustaining 16–24 weeks of training. Coaches who identify regret-based enrollment should strategically develop intrinsic and social motivation scaffolding within the first 3 weeks, before the regret-based initial momentum fades."}
{"chunk_id": "sport_psychology_expand_0143", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Ames 1992 J Educ Psychol; Duda & Hall 2001 Handb Sport Psychol", "text": "The concept of 'motivational climate' in running contexts: research by Ames (1992) and Duda & Hall (2001) established that the training environment created by coaches, running groups, or digital platforms creates either a mastery climate (focused on personal improvement) or a performance climate (focused on comparison and ranking). Mastery climate training environments predict higher intrinsic motivation, lower anxiety, and lower dropout in recreational runners. Strava's default 'leaderboard' interface creates a performance climate; adjusting visibility settings toward personal-record tracking shifts it toward mastery climate."}
{"chunk_id": "sport_psychology_expand_0144", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Oettingen et al. 2001 J Pers Soc Psychol; Stadler et al. 2009 Health Psychol", "text": "Mental contrasting with implementation intentions (MCII): combining visualization of the desired outcome (running a marathon) with deliberate identification of the most likely obstacles and specific if-then plans to address them, produces stronger behavior change than positive thinking alone. Research by Oettingen (2012) found MCII outperforms pure positive outcome visualization and pure obstacle focus independently. For marathon training, a weekly 10-minute MCII session — visualizing the race, identifying next-week barriers, planning specific responses — is an evidence-supported adherence tool."}
{"chunk_id": "sport_psychology_expand_0145", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Allen Collinson 2008 Sociol Sport J; Shipway & Holloway 2010", "text": "Intrinsic motivation for social runners vs. solitary runners: research on running motivation typology identifies distinct profiles: 'social runners' (primarily motivated by community and shared experience) and 'solitary runners' (primarily motivated by personal challenge and contemplative solitude). These profiles respond to different intervention approaches: social runners benefit from group training structures, shared goal calendars, and team events; solitary runners are motivated by personal records, meditative attention to effort, and individual achievement recognition. Most runners are mixed-profile, with context-dependent motivational dominance."}
{"chunk_id": "sport_psychology_expand_0146", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Rees & Hardy 2000 J Sport Exerc Psychol; Wills & Ainette 2012", "text": "Social support in marathon training operates through three pathways: (1) informational support — advice, training guidance, course knowledge; (2) emotional support — empathy, encouragement, normalization; (3) instrumental support — training partners, carpool to events, shared childcare for long run days. Research on adherence in 16-week marathon programs found that the presence of at least one training partner who also commits to the program increases completion probability from 54% to 78% in first-time runners."}
{"chunk_id": "sport_psychology_expand_0147", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Zajonc 1965 Social facilitation; Strauss 2002 Psychol Sport Exerc", "text": "Social facilitation in group runs: runners pace 5–12% faster in group training at equivalent perceived effort compared to solo running. This 'co-action' effect is well established in sport psychology literature and is the primary explanation for why running clubs produce faster improvement rates than self-coached solo runners. However, group social facilitation can also push beginner runners to unsustainable paces on easy days — proper group management requires easy-day pace enforcement regardless of social dynamics."}
{"chunk_id": "sport_psychology_expand_0148", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Shipway & Holloway 2010 Leis Stud; Dawson 2013", "text": "Running clubs and running identity: research by Shipway & Holloway (2010) studying UK running communities found that club membership was the single strongest structural predictor of marathon training completion, stronger than training plan quality, coach access, or prior athletic background. The mechanism is multi-layered: clubs provide social support, identity community, accountability structure, and regular subcommunity events that renew motivation through celebration of milestones."}
{"chunk_id": "sport_psychology_expand_0149", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Wing & Jeffery 1999 J Consult Clin Psychol; Prestwich et al. 2012 Br J Health Psychol", "text": "Accountability partners: research on dyadic accountability (two people committing to support each other's training) shows strong adherence effects, particularly when accountability includes specific behavioral commitments ('I'll text you when I complete the run') rather than vague supportive intentions. For marathon training, digital accountability via messaging apps produces measurable adherence improvement even between geographically distant partners. The key mechanism is anticipated reporting — knowing you'll need to account for a session makes skipping it psychologically costly."}
{"chunk_id": "sport_psychology_expand_0150", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Buunk & Gibbons 2007 J Exp Soc Psychol; Marsh et al. 2012", "text": "Vicarious achievement and social comparison in marathon training communities: runners regularly derive motivation from observing training partners achieve milestones, but this process turns maladaptive when comparison is 'upward' (comparing to significantly faster runners) and standards are evaluated as performance rather than effort. Research by Buunk & Gibbons (2007) distinguishes 'social comparison orientation' — individual differences in how frequently and intensely people compare themselves to others — as a moderator: high comparison-oriented runners benefit from carefully managed training group composition."}
{"chunk_id": "sport_psychology_expand_0151", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Joel et al. 2018; Fitzsimons et al. 2015 J Pers Soc Psychol", "text": "Running as shared identity experience: couple and family running — training together for a marathon — creates strong shared identity bonds and increases completion rates for both partners. Research on 'unit identity' and shared goal pursuits shows that pursuing a hard goal together produces stronger relationship bonds than easier shared activities. Many marathon programs now explicitly encourage couple/friend team registrations, which exploit this social cohesion mechanism."}
{"chunk_id": "sport_psychology_expand_0152", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Hargreaves 1994; Dashper 2015 Sociol Sport J", "text": "Negative social dynamics in running groups: peer pressure to maintain faster paces than appropriate for recovery runs, social ridicule of slow runners, and competitive toxicity are documented negative social factors in some running communities. Research on social identity threat in sport shows these dynamics disproportionately affect female runners, older runners, and beginners. Psychologically safe running communities — where pace variation is explicitly normalized and multiple ability groups are genuinely equally valued — produce better long-term retention across all ability levels."}
{"chunk_id": "sport_psychology_expand_0153", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Samson & Solmon 2011; Pettitt et al. 2005 Appl Psychophysiol Biofeedback", "text": "Spectator support in marathon racing: research by Samson & Solmon (2011) found that spectator encouragement during marathon racing produced measurable pace improvement (1.7% faster in kilometers with dense spectator coverage) and significantly lower perceived effort at equivalent pace. Name-based encouragement (personalized cheering from strangers reading race bibs) produced stronger psychological response than generic crowd noise. Runners who know specific supporters will be present at specific course points show better pace discipline in the preceding kilometers, anticipating the motivational boost."}
{"chunk_id": "sport_psychology_expand_0154", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Beaumont et al. 2020; Stevens et al. 2021 Running in pandemic", "text": "Online running communities and virtual marathons: COVID-19 accelerated adoption of virtual running communities and events, with research indicating that well-structured virtual communities can partially replicate the social support and accountability functions of in-person clubs. Key features of effective virtual running communities include: regular structured challenges with defined completion milestones, asynchronous peer acknowledgment systems (kudos, comments), and identity-affirming community language ('our community', 'your achievement')."}
{"chunk_id": "sport_psychology_expand_0155", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Lupton 2017 Digital Health; Withrow 2019 Int J Sport Exerc Psychol", "text": "GPS watch dependency and running anxiety: research on exercise technology dependence finds that 30–40% of recreational marathon runners report significant negative affect when training without a GPS device, rating sessions as 'wasted' or 'not counting' regardless of actual physiological stimulus. This 'GPS anxiety' represents a form of performance monitoring obsession that can increase perfectionism and reduce intrinsic enjoyment. Periodic 'naked' runs without GPS devices are recommended to maintain internal effort calibration and psychological flexibility."}
{"chunk_id": "sport_psychology_expand_0156", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Laukkanen & Virtanen 2016; Ekkekakis et al. 2011 Psychol Sport Exerc", "text": "Heart rate monitoring and anxiety in recreational runners: continuous HR monitoring via wearable devices creates a paradox — runners who frequently glance at HR data during easy runs report higher effort perception, not lower, compared to non-monitoring conditions. The mechanism is attention: monitoring effort-related data redirects attention toward physiological signals that would otherwise be processed non-consciously, amplifying perceived discomfort. For anxiety-prone runners, restricting HR display to post-session review rather than real-time monitoring reduces training anxiety."}
{"chunk_id": "sport_psychology_expand_0157", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Howe & Bonsall 2015; Lupton 2017 Digital Health", "text": "Strava and social comparison anxiety: in running communities, Strava's segment leaderboard and relative effort features create frequent social comparison opportunities. Research on social comparison in digital sport environments finds that runners who set strict privacy controls (visible to friends only, no leaderboard participation) report significantly higher training enjoyment and lower anxiety than those with public profiles, at equivalent training volumes. 'Strava anxiety' — monitoring whether peers have logged runs before or after oneself, checking Kudos counts — is a documented form of social media anxiety in the running community."}
{"chunk_id": "sport_psychology_expand_0158", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Eppler & Mengis 2004 Inf Soc; practitioner synthesis", "text": "Training data overload: modern running watches generate heart rate variability, training load scores, VO2max estimates, race predictor times, and body battery indicators simultaneously. Research on cognitive load in decision-making suggests that data overload reduces training quality — when runners have too many metrics to process, they frequently second-guess decisions, discontinue sessions based on algorithmic recommendations rather than genuine body signals, and experience elevated pre-session anxiety. A data minimalism protocol — restricting real-time display to 2–3 key metrics — reduces decision fatigue and improves training adherence."}
{"chunk_id": "sport_psychology_expand_0159", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Baron et al. 2017 J Clin Sleep Med; Buman et al. 2010", "text": "Wearable technology and sleep anxiety: sleep tracking devices have created a phenomenon called 'orthosomnia' — anxiety about sleep quality data that paradoxically impairs sleep. Research by Baron et al. (2017, J Clin Sleep Med) found that patients who monitored sleep data obsessively reported worse subjective sleep quality than those who did not, even when objective measures were equivalent. For marathon runners using recovery-oriented sleep tracking (HRV, recovery scores), building in data-free nights weekly reduces this form of training anxiety."}
{"chunk_id": "sport_psychology_expand_0160", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Deci & Ryan 2000; Vallerand & Rousseau 2001 Psychol Sport Exerc", "text": "The paradox of performance-tracking technology: quantifying running performance increases commitment in the short term but reduces intrinsic motivation in the long term for a subset of runners. Research consistent with cognitive evaluation theory (Deci & Ryan) shows that when performance tracking is perceived as informational (confirming progress) it enhances intrinsic motivation; when perceived as controlling (evaluating adequacy) it undermines it. The difference is framing: 'You ran 42:15, that's 30 seconds faster than last week' versus 'Your pace was 5:05/km, which is X% below your target pace.'"}
{"chunk_id": "sport_psychology_expand_0161", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Kaplan 1995 Ann Behav Med; MacMahon et al. 2019 J Environ Psychol", "text": "Digital disconnection runs: research on nature exposure and psychological restoration (Attention Restoration Theory, Kaplan 1995) finds that running in natural environments without technology produces stronger psychological recovery effects than technology-assisted urban running. 'Wilderness' running even in urban parks, without GPS audio cues, without earphones, attending to natural sensory input, produces measurable improvements in attention, rumination reduction, and positive affect. One technology-free outdoor run per week is a clinically validated recovery tool for runners with high training stress."}
{"chunk_id": "sport_psychology_expand_0162", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Borg 1998 Perceived Exertion; Ekkekakis et al. 2011 Exerc Sport Sci Rev", "text": "Rating of Perceived Exertion (RPE) as a psychological construct: Borg's original RPE scale (6–20) and its subsequent CR10 revision capture the subjective sense of effort that integrates sensory signals from muscles, lungs, cardiovascular system, and motivational state. Critically, RPE is not a simple readout of physiological intensity — it is influenced by affective valence, self-efficacy, prior expectations, attentional focus, and social context. Two runners at identical physiological intensities can report RPE values 2–4 points apart based purely on psychological factors."}
{"chunk_id": "sport_psychology_expand_0163", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Marcora et al. 2009 J Appl Physiol; Marcora & Staiano 2010 Psychophysiology", "text": "Marcora's Psychobiological Model of endurance performance establishes that the decision to stop or slow down is driven by the gap between actual RPE and willingness to tolerate that RPE, not by peripheral physiological exhaustion. This model predicts that: (1) interventions reducing RPE (positive affect, music, teammate presence) extend endurance performance even without physiological change; (2) mental fatigue increases RPE at the same physiological intensity; (3) performance limits are psychological thresholds, not pure physiological ceilings for most recreational runners."}
{"chunk_id": "sport_psychology_expand_0164", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Marcora et al. 2015 Am J Physiol; Martin et al. 2018 Med Sci Sports Exerc", "text": "Brain endurance training (BET): a small but growing body of research investigates whether cognitive tasks performed before or during endurance exercise can increase mental fatigue tolerance. Marcora et al. (2015, AJP) found that 12 weeks of cognitive training performed alongside physical training improved cycling time-to-exhaustion by 126% compared to 42% for physical training alone. While BET research in marathon-specific populations is limited, the principle — training the brain's tolerance for cognitive effort under fatigue — is applied in high-performance marathon coaching."}
{"chunk_id": "sport_psychology_expand_0165", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Swart et al. 2012 Br J Sports Med; practitioner synthesis", "text": "'Effort shock' at race start: the mismatch between anticipated race-day feel and actual race-day sensation produces a common psychological pattern — runners who trained at goal pace in favorable conditions (cool weather, flat route, rested) and then race in challenging conditions (warm, humid, undulating) experience effort at goal pace as significantly harder than expected, triggering panic. The psychological preparation for effort shock involves: (1) acknowledging that race-day feel is variable; (2) establishing RPE-based rather than only pace-based targets; (3) pre-practicing 'harder than expected' scenarios in training."}
{"chunk_id": "sport_psychology_expand_0166", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Trubee et al. 2014 Int J Sports Physiol Perform; Santos-Lozano et al. 2014", "text": "Pace judgment and the first 5 km psychological trap: research on marathon pacing patterns (Trubee et al. 2014; Santos-Lozano et al. 2014) consistently shows that the most common pacing error in recreational marathons is running the first 5 km 3–12% faster than target pace. The mechanism is a well-documented psychological phenomenon: early race excitement, crowd energy, and adrenaline produce substantially reduced RPE at fast paces — the 'easy feeling' trap. Explicit pre-race cognitive instructions ('run the first 5 km 5–8% slower than goal pace; it will feel embarrassingly easy') significantly improve finishing pace distribution."}
{"chunk_id": "sport_psychology_expand_0167", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Hampson et al. 2001 Sports Med; Billat et al. 2009", "text": "Mid-race RPE drift: research shows that perceived exertion at a fixed pace increases over the course of a marathon even without physiological deterioration. By km 25–28, RPE at a maintained pace has typically increased 2–3 points on the Borg scale compared to the same pace at km 10. This 'RPE drift' is both physiological (glycogen depletion, thermoregulation cost) and psychological (attentional narrowing, cumulative discomfort). Psychological preparation should include explicit 'RPE contract' — accepting that the same feeling of effort will feel harder by km 25, and defining in advance what RPE level will trigger pacing adjustments."}
{"chunk_id": "sport_psychology_expand_0168", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Craig 2002 Nat Rev Neurosci; Birrer & Morgan 2010 J Clin Sport Psychol", "text": "Psychological dissociation from discomfort: distinguishing pain from harm. A critical psychological skill for marathon running is the ability to distinguish productive discomfort (effort-related fatigue that is reversible and training-appropriate) from warning-signal pain (injury or medical risk signals). Research on interoceptive awareness in endurance athletes shows that experienced runners have significantly better discriminative capacity between these signal types. Beginner runners tend to catastrophize effort discomfort; coaching interventions should explicitly teach this distinction, using body scan practice to develop interoceptive accuracy."}
{"chunk_id": "sport_psychology_expand_0169", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Abbiss & Laursen 2008 Sports Med; Renfree & Gibson 2013", "text": "Negative split psychology: most marathon world records and optimal recreational performances use negative splits (second half faster than first half). Research on negative split adoption shows that its main barrier is psychological rather than tactical: runners who achieve negative splits report being able to maintain faster second-half pacing because psychological confidence (having 'saved something') dominates over cumulative fatigue. Conversely, positive-split runners describe the second half as a fight against progressive pace decline, with hope of maintaining target pace replaced by damage limitation."}
{"chunk_id": "sport_psychology_expand_0170", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Carver & Scheier 1998 On the Self-Regulation; Buman et al. 2008", "text": "Effort monitoring and goal revision mid-race: research on goal striving under unexpected difficulty shows that the psychological ability to revise goals in real time — 'my original A-goal is no longer achievable; my new primary goal is X' — is a skilled behavior that distinguishes experienced from novice marathon runners. Goal revision preserves motivation and produces better finishing outcomes than rigid adherence to an unachievable target (which produces demoralization spirals). Psychological preparation should include pre-defined 'adjustment triggers' — specific conditions at which the runner has permission to shift goal priority."}
{"chunk_id": "sport_psychology_expand_0171", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Ogles & Masters 2003 J Sport Behav; Andersen et al. 2014 Gerontol", "text": "Master's marathon runners (40+) represent the fastest-growing demographic in mass-participation running events. Research by Ogles & Masters (2003) found that participation motivations shift dramatically with age: runners under 35 primarily cite performance goals; runners 40–55 increasingly cite health management and personal challenge; runners 55+ predominantly cite social connection and meaning-making. These motivational differences require age-specific psychological coaching approaches."}
{"chunk_id": "sport_psychology_expand_0172", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Baker et al. 2010 Sports Med; Tanaka & Seals 2008 J Appl Physiol", "text": "Age-related performance decline and psychological adaptation: research on masters athletes shows that performance-identity rigidity (tying self-worth to age-cohort performance comparisons) is a primary driver of dropout in the 45–55 age bracket, as pace decline becomes undeniable. Runners who successfully adapt maintain motivation by shifting from absolute pace comparison to age-graded performance, intrinsic process enjoyment, and health longevity goals. Age-graded calculators (showing equivalent performances across age groups) are a psychologically protective reframing tool."}
{"chunk_id": "sport_psychology_expand_0173", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Harridge & Lazarus 2017 Physiology; Tanaka & Seals 2008", "text": "Recovery psychology in masters runners: the extended recovery time required by masters runners (research indicates 48–96 hour full recovery vs. 24–36 hours in young adults) creates a recurring psychological friction — rest feels like inadequacy rather than appropriate training design. Psychoeducation specifically addressing the neuroscience of masters recovery (age-related reduction in growth hormone, slower satellite cell mobilization) is necessary to help masters runners develop psychological comfort with higher rest-to-training ratios."}
{"chunk_id": "sport_psychology_expand_0174", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Dijk & Duffy 1999 J Sleep Res; Bonnar et al. 2018 Sports Med", "text": "Sleep and recovery in masters athletes: sleep quality declines naturally with age, and poor sleep disproportionately impairs masters runners' training recovery compared to younger athletes. Research by Dijk & Duffy (1999) shows that total sleep time, slow-wave sleep, and melatonin secretion all decline significantly after age 40. Masters marathon runners therefore face compounding challenges: greater recovery needs simultaneously with lower sleep quality. Sleep hygiene interventions produce stronger performance-related benefits in masters runners than in younger athletes."}
{"chunk_id": "sport_psychology_expand_0175", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "McKinley et al. 2019; Ryff & Singer 1998 Psychol Inquiry", "text": "Purpose-driven running in older marathon runners: gerontological research on 'successful aging' consistently identifies purpose in life and engagement in challenging, growth-oriented activities as primary mediators of cognitive longevity and psychological wellbeing in older adults. Marathon training and racing provide a structured 'purpose scaffold' — 20+ weeks of daily meaningful activity, progressive challenge, and community engagement — that maps directly onto evidence-based frameworks for healthy aging. Older marathon runners show significantly lower depression scores than age-matched non-exercisers."}
{"chunk_id": "sport_psychology_expand_0176", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "van Mechelen et al. 1992; specific masters data: Wen et al. 1997", "text": "Injury psychology is amplified in masters runners: the fear of injury — and the psychological impact of injury when it occurs — is significantly greater in older runners than younger ones. Research by Mackenbach et al. found that masters runners report injury-related anxiety as their primary training inhibitor more frequently than performance or time concerns. This makes injury-prevention psychology (respecting rest, modifying training on warning signs, not running through pain) a specifically high-priority topic in masters runner coaching."}
{"chunk_id": "sport_psychology_expand_0177", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Greenberg et al. 1986 J Pers Soc Psychol; Becker 1973 Denial of Death", "text": "Mortality salience and marathon meaning for older runners: in existential psychology, marathon running for older athletes often carries an explicit connection to mortality awareness — running as an assertion of vitality and agency in the face of physical decline. Terror Management Theory research (Greenberg et al.) suggests that activities providing symbolic victory over bodily limits produce strong motivation sustenance. Framing marathon training as 'defying the expected trajectory of aging' is motivationally resonant for many older runners and should not be pathologized as denial."}
{"chunk_id": "sport_psychology_expand_0178", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Andersen et al. 2014; practitioner research synthesis", "text": "Masters runners and children/grandchildren motivation: research on family-motivated exercise shows that a significant proportion of masters marathon runners are primarily motivated by modeling health behavior for children or grandchildren ('I want to show them what's possible'). This 'health legacy' motivation is among the most durable long-term motivators in older athletes and is specifically resistant to the demoralization that follows performance decline, since the behavior itself (participating) is what carries motivational meaning, not the outcome."}
{"chunk_id": "sport_psychology_expand_0179", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Hooper et al. 1995 Med Sci Sports Exerc; Mujika & Padilla 2003 J Appl Physiol", "text": "Taper madness is the informal name for a predictable cluster of psychological symptoms that emerge during the 2–3 week taper phase before a marathon. Research by Hooper & Mackinnon (1995) and subsequent confirmatory studies document the following: 40–85% of marathon runners experience significant psychological disturbance during taper, including elevated anxiety, increased depression symptoms, perceived loss of fitness, heightened fatigue paradox (more rest but feeling worse), and increased somatic complaints. Critically, taper madness is psychologically real but physiologically benign — the body is adapting positively."}
{"chunk_id": "sport_psychology_expand_0180", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Mujika 2010 Med Sci Sports Exerc; Bosquet et al. 2007 Eur J Appl Physiol", "text": "The paradoxical fatigue of taper: runners who reduce training volume by 40–60% during taper consistently report feeling more tired than during peak training weeks. Research identifies two mechanisms: (1) without the adrenaline and structural engagement of heavy training, subjective fatigue becomes more prominent; (2) the removal of training stimulus produces withdrawal-like psychological effects — running functions as a mood regulator, and its reduction creates temporary dysphoric state. Knowledge that this is normal, temporary, and a sign that taper is working is the primary psychological intervention."}
{"chunk_id": "sport_psychology_expand_0181", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Mujika & Padilla 2003; practitioner synthesis; Hooper & Mackinnon 1995", "text": "Cognitive distortions during taper that runners should be educated to expect: (1) 'I'm losing fitness' — research confirms the opposite: fitness peaks during taper; (2) 'My legs feel terrible' — fatigue paradox; they will feel better on race day; (3) 'I should do an extra run to test my fitness' — the classic taper-break urge that undermines recovery; (4) 'I haven't trained enough' — hindsight bias activating anxiety about the entire 20-week cycle; (5) 'I'm injured' — normal taper niggles feel significant when anxiety is elevated."}
{"chunk_id": "sport_psychology_expand_0182", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Erlacher et al. 2011 Sleep Med; Doherty et al. 2019 Eur J Appl Physiol", "text": "Pre-race sleep anxiety: the night before a marathon is almost universally reported as poor sleep for both experienced and novice runners. Research by Erlacher et al. (2011) found 66% of athletes reported pre-competition sleep problems, and 58% believed these problems negatively affected performance — but research on actual performance effects shows no meaningful relationship between pre-race night sleep quality and marathon finishing time when prior nights' sleep (nights 2–4 before the race) has been adequate. One night of poor sleep does not impair endurance performance."}
{"chunk_id": "sport_psychology_expand_0183", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Baumeister & Tierney 2011 Willpower; practitioner synthesis", "text": "Race-week cognitive load management: in the week before a marathon, runners should be advised to reduce decision-making complexity wherever possible — pre-selecting race-day clothing, logistics, nutrition, and transportation removes cognitive burden that competes with focused psychological preparation. Research on decision fatigue (Baumeister & Tierney) shows that accumulated decision-making depletes self-regulatory resources, and high-stakes decisions made after many smaller ones produce more anxiety and poorer execution. A race-week 'decision holiday' reduces the cognitive tax on psychological readiness."}
{"chunk_id": "sport_psychology_expand_0184", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Mujika 2010; practitioner clinical synthesis", "text": "Taper week physical sensations and psychological reactivity: during taper, reduced daily training volume means the physical sensations of muscle soreness, tightness, and stiffness — normally processed as training information and not alarming — can feel amplified in the absence of competing physical stimulation. This is 'noise in an empty room' — the same signal at lower volume feels louder because there is less background sensation. Psychoeducation: taper-week physical sensations are not injury indicators; they are normal neuromuscular adjustments. Runners should be explicitly told not to modify race plans based on taper-week physical sensations alone."}
{"chunk_id": "sport_psychology_expand_0185", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Taylor & Wilson 2005 Applying Sport Psychol; Jackson & Csikszentmihalyi 1999", "text": "Psychological skills practice during taper: rather than adding physical training to reduce taper anxiety (the wrong response), sport psychology recommends using the reduced physical training time for active psychological preparation: (1) imagery rehearsal of the race course, key segments, and anticipated difficult moments; (2) writing and rehearsing race-day mantras; (3) reviewing training data to build a 'case for confidence'; (4) completing a race focus plan defining attentional targets at each kilometer range. These activities productively channel taper energy and reduce anxiety."}
{"chunk_id": "sport_psychology_expand_0186", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Cotterill et al. 2010 Psychol Sport Exerc; Weinberg & Williams 2001", "text": "Evidence-based pre-race routine construction: research on pre-performance routines (PPR) in endurance sport finds that structured routines of 30–90 minutes before race start consistently improve performance and reduce anxiety compared to unstructured pre-race time. Effective PPR elements include: consistent wake time, familiar pre-race breakfast at specific timing (3–4 hours before), specific warm-up sequence, music playlist, and a closing centering ritual (breathing, brief imagery). The key feature is consistency across training races to build an associative cue for optimal readiness state."}
{"chunk_id": "sport_psychology_expand_0187", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Udry et al. 1997 J Sport Exerc Psychol; Brewer 2010 J Athl Train", "text": "Sport injury triggers a grief-like psychological response that follows a predictable pattern. Udry et al. (1997) documented six phases in injured athletes: (1) initial disbelief and denial; (2) anger and frustration; (3) bargaining (attempting modified training to avoid full rest); (4) depression as injury duration becomes clear; (5) gradual acceptance; (6) return-to-sport anxiety. This sequence is not always linear or complete, but awareness of the pattern helps athletes and coaches normalize emotional responses and seek appropriate support."}
{"chunk_id": "sport_psychology_expand_0188", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Ardern et al. 2013 Br J Sports Med; Glazer 2009 J Athl Train", "text": "Fear of reinjury (FORI) is one of the primary barriers to successful return-to-running following overuse injuries. Research shows that athletes who report high FORI scores at return-to-sport clearance show 3× higher reinjury rates in the following 6 months than those with low FORI, likely through protective (but maladaptive) compensatory movement patterns and avoidance of loaded training. Psychological readiness for return to sport should be assessed alongside physical readiness — tools like the Injury-Psychological Readiness to Return to Sport scale (I-PRRS) quantify this."}
{"chunk_id": "sport_psychology_expand_0189", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Maddison et al. 2012 J Sport Exerc Psychol; Lebon et al. 2010 Neuropsychologia", "text": "Mental practice during injury layoff: research demonstrates that athletes who continue mental training (visualization of running, imagery of training scenes, watching race footage) during injury layoff maintain higher sport-specific neural activation, stronger intrinsic motivation, and faster psychological readiness for return than those who disengage completely. A structured injury mental training protocol — 15–20 minutes daily of technique imagery, race preparation visualization, and goal setting for return — improves both psychological recovery and eventual physical return timelines."}
{"chunk_id": "sport_psychology_expand_0190", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Sullivan et al. 2001 Pain; Tripp et al. 2011 J Clin Sport Psychol", "text": "Catastrophizing cognitions and injury recovery: negative injury cognitions — 'this injury will never heal,' 'I'll never run at the same level again,' 'missing this training will ruin my marathon' — are associated with prolonged injury recovery across multiple pain and sport studies. Research shows that catastrophizing cognitions directly increase perceived pain, reduce pain tolerance, and reduce functional capacity at equivalent tissue healing states. CBT-based cognitive restructuring of injury catastrophizations produces measurably faster functional recovery."}
{"chunk_id": "sport_psychology_expand_0191", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Bianco 2001 J Sport Exerc Psychol; Podlog & Eklund 2007 Psychol Sport Exerc", "text": "Return-to-running anxiety: runners returning from significant injury commonly report heightened anxiety specifically about their first runs back — characterized by hypervigilance to every sensation in the injured area, 'checking' movement patterns, and reduced running enjoyment. This anxiety is clinically distinct from general running anxiety. Evidence-based management: gradual exposure (short early runs), explicit sensation normalization ('some pulling feeling in the first weeks is normal and does not mean reinjury'), and post-run self-check rather than during-run monitoring."}
{"chunk_id": "sport_psychology_expand_0192", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Sparkes 1998 J Sport Exerc Psychol; Podlog & Eklund 2007", "text": "Social identity disruption from injury: for runners with strong sport identity, injury creates an identity void — they can no longer participate in the running community activities that define a significant portion of their self-concept. Research shows that runners who maintain connection to the running community during injury (attending group runs without running, volunteering at races, maintaining running social media engagement) show faster return-to-training and lower depression scores than those who withdraw completely."}
{"chunk_id": "sport_psychology_expand_0193", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Bianco 2001; Brewer 1993 Sociol Sport J", "text": "Cross-training psychology during injury: physiologically equivalent aerobic training through pool running, cycling, or elliptical during running injury preserves fitness. Psychologically, the benefit depends on whether the runner can develop genuine satisfaction from the alternative activity. Research shows this is personality-dependent: runners with strong 'athlete identity' (broader than 'runner identity') adapt psychologically to cross-training better than those with exclusively running-centered identity. Encouraging runners to develop secondary athletic identities proactively reduces injury-related psychological vulnerability."}
{"chunk_id": "sport_psychology_expand_0194", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Freimuth et al. 2011 Int J Ment Health Addict; Hausenblas & Symons Downs 2002", "text": "Marathon training can be psychologically beneficial or psychologically harmful depending on the runner's relationship to training. Research by Freimuth et al. (2011) distinguishes 'healthy exercise' from 'exercise addiction' — defined as compulsive exercise that continues despite injury, illness, or significant social interference, produces withdrawal symptoms when disrupted, and is used primarily for anxiety or mood regulation rather than positive physical engagement. The distinction is clinically important: sport psychologists in marathon contexts should monitor for exercise addiction signs in runners who train through injuries or report severe anxiety when missing sessions."}
{"chunk_id": "sport_psychology_expand_0195", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Terry et al. 2004 Br J Health Psychol; Griffiths et al. 2005", "text": "The exercise addiction inventory (EAI, Terry et al. 2004) identifies six components of exercise addiction risk: salience (running dominates thoughts), mood modification (running used to regulate all emotional states), tolerance (ever-increasing training volume needed for same effect), withdrawal (significant psychological distress when training is missed), conflict (running causes problems in relationships and work), and relapse (returning to training patterns despite attempting to reduce). Scores above 24/30 indicate high addiction risk, warranting clinical referral."}
{"chunk_id": "sport_psychology_expand_0196", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Krogh et al. 2011 J Clin Psychiatry; Blumenthal et al. 2007 Psychosom Med", "text": "Running and depression: a substantial evidence base establishes that regular aerobic exercise (including running 3–5×/week at moderate intensity) produces clinically significant antidepressant effects. A meta-analysis by Krogh et al. (2011) found exercise produced effect sizes of 0.82 on depression measures — comparable to antidepressant medication in mild-to-moderate depression. However, a marathon coach or assistant system should not recommend running as a substitute for clinical treatment of depression, and should flag significant depressive symptoms for professional referral."}
{"chunk_id": "sport_psychology_expand_0197", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Wipfli et al. 2008 Anxiety Stress Coping; Anderson & Shivakumar 2013", "text": "Running and anxiety disorders: regular moderate-intensity running has demonstrated anxiolytic effects, reducing trait anxiety by approximately 0.6 standard deviations in meta-analytic estimates (Wipfli et al. 2008). The mechanism includes HPA axis regulation, GABA system modulation, and reduced amygdala reactivity. However, marathon training itself can trigger anxiety spikes through overtraining-related cortisol elevation, social comparison anxiety, and performance pressure. A marathon assistant system should monitor for signs that training is worsening rather than improving anxiety, and recommend clinical assessment when present."}
{"chunk_id": "sport_psychology_expand_0198", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "clinical_practice_guideline", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Mountjoy et al. 2018 IOC RED-S consensus; Nattiv et al. 2007 ACSM position stand", "text": "Relative Energy Deficiency in Sport (RED-S) has significant psychological sequelae that a marathon assistant should be aware of but not treat: these include depression, irritability, cognitive impairment, and disordered eating cognitions. RED-S in marathon runners (more common in female athletes but affecting males too) requires medical assessment including endocrine evaluation and nutritional counseling. A system detecting possible RED-S indicators (extreme caloric restriction, stress fracture history, menstrual irregularity, extreme low body weight focus) should explicitly recommend professional assessment and avoid providing specific diet prescriptions."}
{"chunk_id": "sport_psychology_expand_0199", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Sundgot-Borgen & Torstveit 2004 Clin J Sport Med; Byrne & McLean 2002", "text": "Disordered eating and running: research estimates 20–30% of female runners and 10–15% of male runners have at least some disordered eating cognitions or behaviors. The combination of endurance training (high caloric demand) and sport culture (lean = faster) creates risk for restriction and disordered eating patterns. A marathon assistant system should not provide detailed caloric prescription without knowledge of the user's relationship with food, and should monitor for language indicating extreme restriction, compensatory exercise, or significant weight-change goals driven by pace targets."}
{"chunk_id": "sport_psychology_expand_0200", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Shipway & Holloway 2010; Cook & Speraw 2006", "text": "Compulsive running and relationship impact: survey research on runners' partners and families consistently identifies training volume as a primary source of relationship conflict in serious amateur marathoners. Research by Shipway & Holloway (2010) found that relationship strain from marathon training was the most common non-physical reason for dropout in their qualitative study. A marathon system that engages runners in reflection about training-life balance — 'is this training plan sustainable alongside your other commitments?' — provides socially responsible coaching."}
{"chunk_id": "sport_psychology_expand_0201", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Mah et al. 2011 Sleep; Fullagar et al. 2015 Sports Med", "text": "Sleep is the most potent single recovery intervention available to marathon runners. Research by Mah et al. (2011, Sleep) found that collegiate athletes who extended sleep to 10 hours nightly for 5–7 weeks improved sprint times, shot accuracy, and mood simultaneously. Meta-analytic research confirms that sleep restriction below 7 hours significantly increases perceived exertion, reduces endurance performance, impairs decision-making, and elevates cortisol. For marathon runners, prioritizing 7–9 hours of sleep produces greater training adaptation than virtually any supplement or recovery modality."}
{"chunk_id": "sport_psychology_expand_0202", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Fullagar et al. 2015 Sports Med; Watson 2017 Curr Sports Med Rep", "text": "Sleep quality markers for marathon runners: rather than focusing only on duration, sport sleep research identifies specific quality markers: sleep onset within 30 minutes of lights-out, one or fewer nocturnal awakenings of <5 minutes, morning waking feeling rested, and subjective HRV scores above baseline. Research indicates that 7 hours of consolidated, high-quality sleep produces better recovery outcomes than 9 fragmented hours. Wearable devices that differentiate deep sleep, REM sleep, and sleep efficiency provide useful but imperfect proxies for sleep quality."}
{"chunk_id": "sport_psychology_expand_0203", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Mah et al. 2011; Bonnar et al. 2018 Sleep Med Rev", "text": "Sleep extension strategies for training athletes: when marathon training volume increases significantly (base-to-build phase transition), proactive sleep extension — planning for 8.5–9 hours of sleep opportunity rather than 7 hours — compensates for the 20–30 minute sleep latency and normal nocturnal awakenings that reduce actual sleep time below opportunity time. Research confirms that sleep extension in the 2 weeks preceding key training races ('sleep banking') is feasible and produces objective performance improvements."}
{"chunk_id": "sport_psychology_expand_0204", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Vitale et al. 2019 J Athl Train; Fullagar et al. 2015 Sports Med", "text": "Sleep hygiene protocols for marathon runners with training-specific modifications: (1) timing — maintain consistent wake time even on rest days (stabilizes circadian rhythm); (2) temperature — sleep environment 16–19°C optimal for most adults; (3) early morning runs and sleep — running before 8am may advance circadian phase, benefiting those who tend to night owl schedules; (4) evening training and sleep — high-intensity evening training delays sleep onset by 60–90 minutes in most athletes, avoid intense training within 2–3 hours of sleep time; (5) post-long-run sleep — total sleep time naturally extends the night after long runs over 25 km."}
{"chunk_id": "sport_psychology_expand_0205", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Waterhouse et al. 2007 Eur J Appl Physiol; Blanchfield et al. 2018", "text": "Napping for marathon runners: research on napping protocols in athletes consistently finds that 20–30 minute naps ('power naps') improve alertness, reaction time, and mood without producing sleep inertia in most individuals. Napping after difficult training sessions or before afternoon/evening training sessions can partially compensate for inadequate night sleep. Research by Waterhouse et al. (2007) found 30-minute post-lunch naps improved sprint performance in sleep-restricted athletes. Marathon runners should be encouraged to view planned napping as a legitimate training tool rather than laziness."}
{"chunk_id": "sport_psychology_expand_0206", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Kreher & Schwartz 2012 Sports Health; Meeusen et al. 2013 Med Sci Sports Exerc", "text": "Sleep and the psychological cost of overtraining: research on overtraining syndrome (OTS) finds sleep disturbance as one of the earliest subjective markers, appearing before objective physiological decline. Fragmented sleep, early morning awakening, and difficulty falling asleep are characteristic OTS sleep patterns. These patterns are mediated by sympathetic nervous system dysregulation and elevated nocturnal cortisol. For a marathon assistant, monitoring self-reported sleep quality (via standardized items) provides an early warning signal for overtraining before performance decline manifests."}
{"chunk_id": "sport_psychology_expand_0207", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Reilly et al. 2007 Sports Med; Srinivasan et al. 2008", "text": "Jet lag and race travel: major destination marathons (Berlin, Boston, New York, Tokyo) require international travel that disrupts circadian rhythm before the race. Research on jet lag mitigation for athletes recommends: arriving 1 day per time zone crossed when crossing >3 zones, using light exposure timing for circadian resetting, melatonin supplementation (0.5–3mg at target destination bedtime) beginning 2–3 days before departure, and building extra sleep days into the travel schedule. Pre-race jet lag significantly impacts marathon performance when not managed."}
{"chunk_id": "sport_psychology_expand_0208", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Lane & Wilson 2011 J Clin Sport Psychol; Buman et al. 2008 J Sport Exerc Psychol", "text": "Post-marathon blues is a well-documented psychological syndrome affecting 15–40% of marathon finishers in the weeks following race completion. It is characterized by low mood, reduced motivation, lack of purpose, mild depression symptoms, and increased fatigue. Research identifies two contributing mechanisms: (1) physiological — post-race cortisol drop and serotonin depletion following extreme exertion; (2) psychological — goal vacuum created when a 16–24 week consuming purpose is suddenly complete. Both mechanisms peak 1–2 weeks post-race and resolve within 4–6 weeks for most runners."}
{"chunk_id": "sport_psychology_expand_0209", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Lane & Wilson 2011; Buman et al. 2008", "text": "Post-marathon blues prevention: research-supported strategies include: (1) registering for the next race or training cycle within 1–2 weeks of race completion (the most effective single strategy, per Lane & Wilson); (2) scheduling social running events in the recovery period that maintain community connection without training stress; (3) planning a 'celebration event' — a meal, trip, or gathering — at 2 weeks post-race when physical recovery has progressed; (4) redirecting training log attention from absence of runs to quality-of-recovery metrics."}
{"chunk_id": "sport_psychology_expand_0210", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Ntoumanis et al. 2014 Psychol Sport Exerc; Tamminen & Holt 2012", "text": "Disappointment processing after a poor race result: a marathon below expectations (missed time goal, DNF, injury-compromised race) activates a distinct psychological sequence. Research on post-failure processing in athletes identifies two adaptive paths: (1) reflection without rumination — analyzing what went wrong and deriving actionable lessons; (2) meaning-making — finding aspects of the experience with lasting value regardless of the result. Both paths require 48–72 hours of decompression before productive analysis is possible; immediate post-race result analysis is typically counterproductive."}
{"chunk_id": "sport_psychology_expand_0211", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Roese 1997 Psychol Bull; Roese & Summerville 2005", "text": "Counterfactual thinking after race disappointment: 'if only I had gone out slower,' 'if only I had trained the tempo runs' — upward counterfactuals (imagining better possible outcomes) are psychologically painful but motivationally activating in moderate doses. Research by Roese (1997, Psychol Bull) found that upward counterfactuals specifically targeted at controllable behaviors ('if only I had started slower') produce preparation improvement before next events more reliably than those targeted at uncontrollable factors ('if only the weather had been cooler'). Coaching after a disappointment involves helping runners identify controllable counterfactuals."}
{"chunk_id": "sport_psychology_expand_0212", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Locke & Latham 2002 Am Psychol; Carver & Scheier 1998", "text": "The joy of a PR (personal record) and identity consolidation: research on goal achievement and self-concept confirms that achieving a challenging personally meaningful goal strengthens related identity more than achieving an easy goal. First marathon completion, first sub-4-hour, or a significant personal best produces a corresponding spike in runner identity strength and intrinsic motivation that typically sustains elevated training motivation for 8–16 weeks post-achievement. Understanding this 'honeymoon phase' helps coaches calibrate the next training cycle launch timing."}
{"chunk_id": "sport_psychology_expand_0213", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Weiner 1985 Psychol Rev; Ntoumanis & Biddle 1998 J Sport Sci", "text": "Race day disappointment versus training disappointment: research on attributional style in sport shows that runners attribute race underperformance differently than training underperformance. Race disappointments trigger stronger internal, stable attributions ('I'm not capable of this goal') while training disappointments are more likely to receive external, unstable attributions ('the weather was bad today'). This asymmetry means race failures are psychologically disproportionately damaging compared to training failures and warrant specific psychological response strategies, including helping runners attribute appropriately to training-related factors (specific controllable preparation elements) rather than global ability."}
{"chunk_id": "sport_psychology_expand_0214", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Deci & Ryan 2000; Ames 1992 J Educ Psychol", "text": "Celebrating performance process over outcome: research on reward and motivation in sport consistently finds that celebrating the 'how' (training commitment, tactical decisions, how challenges were handled) independent of the outcome is more effective for sustained motivation than celebrating only the result. This is particularly important after a race where effort was high but conditions were challenging. Post-race debriefs from sport psychologists regularly employ 'process appreciation' — explicitly identifying and praising specific psychological and tactical performances during the race regardless of finishing time."}
{"chunk_id": "sport_psychology_expand_0215", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Petruzzello et al. 1991 Sports Med; Reed & Ones 2006 Psychol Sport Exerc", "text": "Running as mood regulator: research consistently finds that a single running session produces immediate mood improvement lasting 2–4 hours, characterized by reduced tension, fatigue, and depression scores on the POMS (Profile of Mood States), and increased vigor and positive affect. A meta-analysis by Petruzzello et al. (1991) found effect sizes of 0.53 for acute exercise on anxiety reduction. These effects are present even for runs as short as 10 minutes and do not require high intensity."}
{"chunk_id": "sport_psychology_expand_0216", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Gerber & Puhse 2009; Stults-Kolehmainen & Sinha 2014 Sports Med", "text": "Running for stress relief: cortisol reduction following moderate-intensity running of 20–60 minutes is well established. Research on the stress-exercise relationship finds that aerobic exercise at 60–70% VO2max produces the largest post-exercise cortisol reductions, with low-intensity and high-intensity training producing smaller stress-relief effects. For marathon runners using running primarily as stress management, maintaining easy to moderate intensity training is psychologically most effective — hard sessions provide less stress relief and can temporarily worsen stress markers."}
{"chunk_id": "sport_psychology_expand_0217", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Gauvin & Rejeski 1993; Berger & Motl 2000 J Appl Sport Psychol", "text": "Using running to 'escape' psychological pain: research by Gauvin & Rejeski (1993) found that running's mood effects are strongest when pre-run mood is negative — the mood improvement effect is larger when starting from a distressed state. This creates a reliable pattern: running is most valuable precisely when it feels least likely to be motivating. The clinical implication is teaching runners to use this knowledge ('the run I least want to take is usually the one that helps most') as a behavioral prompt rather than making motivation a precondition."}
{"chunk_id": "sport_psychology_expand_0218", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Oppezzo & Schwartz 2014 J Exp Psychol Learn Mem Cogn", "text": "Running and creative thinking: research on cognitive creativity has documented that walking and running produce increases in divergent thinking (creative problem-generation) of 81–100% compared to sitting conditions. Oppezzo & Schwartz (2014, Experimental Psychology) found that treadmill walking produced equivalent creativity effects to outdoor walking, confirming the physical movement rather than environment is the primary driver. Many professional runners and creative workers report using regular runs deliberately for problem-solving and creative incubation."}
{"chunk_id": "sport_psychology_expand_0219", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Thompson Coon et al. 2011 Environ Sci Technol; Bowler et al. 2010", "text": "Nature exposure amplifies running's emotional regulation effects: research on Blue and Green spaces in exercise found that outdoor running in natural environments produces 50% stronger positive affect improvements than equivalent treadmill running. The mechanism is dual: sensory novelty of natural environments reduces ruminative thinking, while natural light exposure regulates circadian mood circuits. For runners with significant stress or mild mood disturbance, outdoor over indoor running routes are the evidence-informed recommendation."}
{"chunk_id": "sport_psychology_expand_0220", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Aidman & Woollard 2003 J Sport Behav; Mondin et al. 1996 Psychosom Med", "text": "The dark side of emotional regulation by running: when running becomes the primary or sole emotion regulation strategy, its disruption (by injury, weather, travel) can trigger significant emotional dysregulation. Research documents 'exercise withdrawal' — acute anxiety, irritability, and mood disturbance following 24–48 hour running cessation in habitual runners. This is clinically distinct from exercise addiction but shares its vulnerability structure: exclusive dependence on running for emotional regulation. Marathon coaches should encourage parallel development of non-running emotion regulation strategies (social connection, mindfulness, breathing techniques)."}
{"chunk_id": "sport_psychology_expand_0221", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Bratman et al. 2015 PNAS; Szabo 2003 J Sports Med Phys Fitness", "text": "Running and rumination suppression: research on repetitive negative thinking shows that outdoor running specifically reduces rumination — repetitive self-referential negative thought — through both attentional demands (route navigation, effort monitoring) and neural mechanisms (subgenual prefrontal cortex activation suppression, identified by Bratman et al. 2015). A 90-minute outdoor walk or run produces measurable reduction in self-reported rumination and lower neural activity in brain regions associated with rumination. This effect is robust and suggests running as a particularly well-matched intervention for anxiety- and depression-related rumination."}
{"chunk_id": "sport_psychology_expand_0222", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Bruner & Spink 2010 J Appl Sport Psychol; Paradis et al. 2012", "text": "Running and social-emotional regulation: group running (with a training partner, running club, or race pace group) produces emotional regulation effects that extend beyond the session. Social running creates positive affect from social connection independent of the running stimulus, and the shared narrative of training hardship produces bonding effects studied in social cohesion research. For runners with social anxiety or social isolation, running groups provide structured social contact with a shared focus that removes the conversational pressure of purely social events."}
{"chunk_id": "sport_psychology_expand_0223", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Thayer et al. 1994 J Pers Soc Psychol; Craft 2005 Psychol Health", "text": "Running and anger regulation: research by Thayer et al. (1994) found that brisk walking was more effective at reducing anger and tension than other common anger management strategies (watching TV, music listening, venting to a friend). Marathon runners frequently self-report running as their primary anger management strategy. The mechanism is twofold: sustained rhythmic physical movement reduces sympathetic nervous system activation (the substrate of anger), and the attentional demands of running interrupt anger rumination cycles."}
{"chunk_id": "sport_psychology_expand_0224", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Kahneman 2011 Thinking Fast and Slow; Laborde et al. 2016 Eur J Sport Sci", "text": "Race-day decision making under pressure: research on decision-making under physiological and psychological stress (dual-process theory) shows that under race-day pressure, automatic (System 1) thinking dominates over deliberate (System 2) reasoning. This means that pre-planned race strategies execute reliably, while in-race strategy adjustments are cognitively costly and error-prone. The practical implication is: all major race-day strategy decisions should be made in advance and committed to writing. 'If X happens (unexpected heat, off-pace at km 10), I will do Y' planning outperforms in-race deliberation."}
{"chunk_id": "sport_psychology_expand_0225", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Renfree & Gibson 2013; Trubee et al. 2014", "text": "The race start psychological trap: research on marathon start-line anxiety finds that adrenaline, crowd energy, and months of anticipatory investment converge to produce a uniquely high-stakes psychological moment with well-documented pacing error patterns. The psychological experience of running with thousands of other runners creates automatic social facilitation that overrides planned pace judgment. Sport psychology interventions for race start: (1) physically removing oneself to a lower-stimulus environment 10–15 minutes before start; (2) focal attention to personal breathing rather than external environment; (3) using a planned first-km GPS alert as an objective anchor against emotional pacing."}
{"chunk_id": "sport_psychology_expand_0226", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Beilock & Carr 2001 J Exp Psychol; practitioner synthesis", "text": "Dealing with crowds and obstacles on-course: race-day crowd management requires attention-switching between external navigation and internal effort monitoring. Research on dual-task performance shows that experienced runners manage this switch automatically, while beginners show measurable pace disruption when navigating crowded early kilometers. Practical preparation: running at least one training session in conditions simulating race-day crowds (urban events, organized group runs) trains the attentional switching that race-day navigation requires."}
{"chunk_id": "sport_psychology_expand_0227", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Privette 1981 Percept Mot Skills; Jackson & Csikszentmihalyi 1999", "text": "Psychological experience of personal bests: achieving a significant personal best time in a marathon produces a distinctive psychological experience characterized by heightened positive affect, reduced RPE in retrospective memory, and strong autobiographical encoding. Research on peak experiences in sport (Privette 1981, Perceptual & Motor Skills) identifies marathon PRs as among the most frequently cited transcendent experiences by recreational runners. The runner who has a PR experience typically restructures their self-perception of capability upward, creating a lasting change in identity-based confidence."}
{"chunk_id": "sport_psychology_expand_0228", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Buman et al. 2008; DNF psychology literature review", "text": "Decision to DNF (Did Not Finish): the psychological experience of choosing to stop a marathon is complex and highly individual. Research on athletic performance termination finds that the decision to DNF carries shame, relief, and ambiguity simultaneously for most runners. The psychologically healthiest framework presents DNF as a legitimate outcome of a difficult endeavor rather than a failure — one made when the risk of continuing outweighs the benefit. Coaches should explicitly provide pre-race permission structures: 'You have permission to stop if X conditions occur.' This reduces the psychologically paralyzing shame response that causes runners to continue unsafely."}
{"chunk_id": "sport_psychology_expand_0229", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner protocol; Taylor & Wilson 2005", "text": "Psychological state monitoring during races: the 'traffic light' system — an informal internal check-in protocol — is widely used in marathon coaching. Runners establish subjective 'green' (sustainable effort, on target), 'amber' (elevated effort, manageable, monitor), and 'red' (unsustainable effort, adjustment required) states tied to specific RPE, pain, GI sensation, and mental clarity thresholds. Performing a traffic light self-assessment at each drink station (approximately every 5 km) provides structured attention to internal state that prevents both underreaction (continuing too long in red) and overreaction (panic stopping in amber)."}
{"chunk_id": "sport_psychology_expand_0230", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Hardy et al. 2019; Blanchfield et al. 2014 RCT", "text": "Mantras for specific race segments: research on motivational self-talk in endurance events finds that mantras are more effective when pre-assigned to specific contexts rather than used generically throughout. A best-practice approach: (1) a confidence mantra for km 1–10 ('I've trained for this, I belong here'); (2) a process mantra for km 10–25 ('smooth, strong, steady — one km at a time'); (3) a pain tolerance mantra for km 25–35 ('I can handle this — this is what I trained for'); (4) an identity mantra for final km ('I am a marathon runner — this is what I do'). Pre-assigning to segments reduces in-race cognitive selection effort."}
{"chunk_id": "sport_psychology_expand_0231", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Gayle 1998; Ogles & Masters 2003 J Sport Behav; Krouse et al. 2011", "text": "Female marathon runners demonstrate distinct motivational profiles from male runners across research studies. Research by Gayle (1998) and Ogles & Masters (2003) consistently find female runners place significantly higher importance on: health/weight management, social participation, and personal challenge completion. Male runners more frequently prioritize competition, personal records, and performance comparison. These differences have direct implications for coaching approach: for female runners, emphasizing health benefits, community connection, and personal journey rather than competition metrics tends to produce better long-term engagement."}
{"chunk_id": "sport_psychology_expand_0232", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Bruinvels et al. 2021 Br J Sports Med; Carmichael et al. 2021 Int J Environ Res", "text": "Menstrual cycle and psychological performance readiness in female runners: research on menstrual cycle effects on perceived exertion and mood finds significant inter-phase variation. Late-luteal phase (4–7 days pre-menstruation) is associated with elevated perceived exertion at fixed intensities, increased irritability, and reduced confidence in many (but not all) female athletes. Follicular phase (days 1–14) typically corresponds to highest psychological readiness. Research on cycle-synced training periodization suggests scheduling key quality sessions in the follicular phase when feasible, while reducing performance expectations during late-luteal phase."}
{"chunk_id": "sport_psychology_expand_0233", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Hanton et al. 2004 J Sport Sci; Wood & Torrington 2006 Eur J Sport Sci", "text": "Pre-race anxiety differences in female runners: research (Hanton et al.; Wood & Torrington) finds that female athletes consistently report higher somatic pre-competition anxiety than male athletes at the same performance level. However, the relationship between pre-race anxiety and performance is more complex for female athletes — cognitive anxiety (worry) is more strongly performance-impairing, while somatic anxiety (physical symptoms) is more easily reinterpreted as excitement. Psychological preparation for female runners should specifically address cognitive anxiety management rather than general arousal reduction."}
{"chunk_id": "sport_psychology_expand_0234", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Mosewich et al. 2011 Psychol Sport Exerc; Mosewich et al. 2013 Psychol Sport Exerc", "text": "Self-compassion as particularly effective intervention for female runners: research by Mosewich et al. (2011, 2013) specifically demonstrated self-compassion intervention effects in female athletes, finding that a brief self-compassion writing exercise after athletic disappointment significantly reduced shame, self-criticism, and maladaptive emotion in female participants more than analytical self-reflection. Female runners are more likely to engage in self-criticism following poor performance, making self-compassion training a high-priority psychological tool."}
{"chunk_id": "sport_psychology_expand_0235", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Byrne & McLean 2002 Int J Eat Disord; Sundgot-Borgen 2004", "text": "Social comparison and appearance concerns in female runners: research on body image in female athletes finds that female runners are significantly more likely than male runners to link running with body composition goals, and more likely to experience negative affect when training does not produce expected body changes. The 'training-weight obsession' pattern in female runners is documented across multiple qualitative and quantitative studies and represents a risk pathway toward disordered eating and overtraining. Coaching and system prompts targeting female runners should be careful not to reinforce weight-loss as a primary training goal."}
{"chunk_id": "sport_psychology_expand_0236", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "O'Neill & Robinson 2019; Pipkin & Stovak 2019 Curr Sports Med Rep", "text": "Pregnancy and return-to-running psychology: returning to marathon training after childbirth involves a complex identity renegotiation. Research by O'Neill & Robinson (2019) found postpartum female runners experienced guilt (about training time away from infant), changed body-image, performance anxiety about capability loss, and physical vulnerability concerns. A marathon coaching system serving postpartum runners should explicitly validate the non-linear nature of postpartum fitness return, emphasize health over performance outcome, and flag significant mood symptoms for clinical referral given postpartum depression prevalence."}
{"chunk_id": "sport_psychology_expand_0237", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Homan & Tylka 2014 J Sport Exerc Psychol; Tylka & Wood-Barcalow 2015", "text": "Body image and running: research on positive body image in athletes finds that running consistently produces improvements in body image — specifically body functionality appreciation (what the body can do) rather than body appearance evaluation (how the body looks). Fredrickson & Roberts' objectification theory research confirms that sport participation that emphasizes performance over appearance reduces self-objectification. For female runners, framing training conversations around physical capacity, strength, and endurance rather than weight or shape produces better psychological outcomes."}
{"chunk_id": "sport_psychology_expand_0238", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Colcombe & Kramer 2003 Psychol Sci; Guiney & Machado 2013 Psychonomic Bull Rev", "text": "Regular aerobic exercise, including running, produces robust improvements in executive function — specifically working memory, cognitive flexibility, and inhibitory control. A meta-analysis by Colcombe & Kramer (2003, Psychol Sci) found that aerobic fitness training produced average effect sizes of 0.68 on executive function measures in adults, compared to 0.27 for non-executive cognitive functions. These effects are seen after as few as 3 months of regular aerobic exercise."}
{"chunk_id": "sport_psychology_expand_0239", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Erickson et al. 2011 PNAS; van Praag 2008 Nat Rev Neurosci", "text": "Running and memory: aerobic exercise specifically increases hippocampal volume in adults, reversing or slowing age-related hippocampal atrophy. Research by Erickson et al. (2011, PNAS) found that older adults who engaged in aerobic exercise for one year showed 2% increased hippocampal volume and corresponding improvements in spatial memory, compared to 1.4% volume decrease in stretching control group. The memory benefits of marathon training are therefore both acute (improved working memory post-run) and chronic (structural brain changes with training consistency)."}
{"chunk_id": "sport_psychology_expand_0240", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Lambourne & Tomporowski 2010 Brain Res; Hogan et al. 2013 Br J Health Psychol", "text": "Acute running and cognitive performance: research consistently finds that moderate-intensity running (60–70% max HR) for 20–40 minutes produces acute improvements in cognitive performance lasting 60–90 minutes post-exercise. These improvements include faster processing speed, improved working memory accuracy, and better inhibitory control. The mechanism involves catecholamine (norepinephrine, dopamine) release and increased prefrontal cortex activity. For marathon runners who use running to enhance work performance, the optimal post-run cognitive window is approximately 20–90 minutes after completion."}
{"chunk_id": "sport_psychology_expand_0241", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Cona et al. 2015 J Int Neuropsychol Soc; Dietrich et al. 2003 Eur J Neurosci", "text": "Marathon-distance running and acute cognitive effects: very high intensity or ultralong duration exercise (marathon distance and beyond) produces a temporary reversal of cognitive benefits seen at moderate intensities. Research shows that during and immediately after marathon racing, processing speed, attention, and decision-making are measurably impaired due to hypoglycemia, dehydration, and extreme fatigue effects. This 'cognitive wall' at marathon distances is clinically relevant for race-day decision-making — post-race decisions about nutrition, medical attention, and transport should not be made in the immediate post-race window."}
{"chunk_id": "sport_psychology_expand_0242", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Barnes et al. 2003 Geriatr Cogn Disord; Hillman et al. 2008 Nat Rev Neurosci", "text": "Running frequency and cognitive aging: longitudinal research on runners in midlife and older adulthood finds that consistent runners show significantly better cognitive trajectories than sedentary peers. A 20-year longitudinal study of masters runners found that those maintaining consistent running in their 50s–70s retained cognitive performance comparable to non-runners 10–15 years younger. The dose-response relationship suggests a minimum of 150 minutes per week of moderate aerobic exercise is required for cognitive benefit."}
{"chunk_id": "sport_psychology_expand_0243", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Dinoff et al. 2017 Sci Rep; Szuhany et al. 2015 Metab Brain Dis", "text": "BDNF and neuroplasticity from running: brain-derived neurotrophic factor (BDNF), often called 'Miracle-Gro for the brain,' is elevated substantially by aerobic exercise. Running at moderate to vigorous intensity produces acute BDNF increases of 200–400% above resting levels in most studies. BDNF promotes neurogenesis, synaptic plasticity, and neuroprotection. Sustained elevated BDNF from regular running training is the primary neurobiological mechanism linking marathon training to long-term cognitive function and mental health benefits."}
{"chunk_id": "sport_psychology_expand_0244", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Vealey 1994 Sport Psychol; Weinberg & Williams 2001 App Sport Psychol", "text": "Mental skills training (MST) in marathon contexts follows a systematic periodized structure parallel to physical training. Research by Vealey (1994) and subsequent practitioner guides recommend: (1) foundational skills phase (months 1–2 of training) — education, self-awareness, relaxation/arousal control; (2) building skills phase (months 2–4) — imagery, goal-setting system, attention management; (3) peaking phase (race month) — competition preparation, mental routines, race focus plan. MST benefits compound over time, with measurable performance and adherence effects emerging after 8–12 weeks of consistent practice."}
{"chunk_id": "sport_psychology_expand_0245", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Driskell et al. 1994 Psychol Bull; Zimmerman 2000 Psychol Educ Res Pract", "text": "Daily mental skills practice volume: research on psychological skills training effectiveness finds that optimal protocol is 10–20 minutes of deliberate mental practice daily, rather than occasional longer sessions. This parallels the distributed practice principle in motor learning — shorter, more frequent practice produces better skill consolidation than massed practice. For marathon runners, the most accessible implementation is a 5-minute pre-run mental centering routine and 5-minute post-run mental debrief, totaling 10–15 minutes of deliberate practice on training days."}
{"chunk_id": "sport_psychology_expand_0246", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Taylor & Wilson 2005 App Sport Psychol; Vealey & Greenleaf 2001", "text": "The mental skills assessment interview: before initiating a mental skills program for a marathon runner, sport psychologists conduct a structured assessment covering: (1) current mental strengths (what the runner already does well psychologically); (2) mental weaknesses (most commonly: pre-race anxiety management, wall management, self-talk patterns, goal-setting sophistication); (3) past psychological successes and failures in training and racing; (4) learning preference for psychological interventions; (5) time available for mental skills practice. Assessment produces a personalized priority list, not a one-size-fits-all protocol."}
{"chunk_id": "sport_psychology_expand_0247", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Andersen 2009 Performing Under Pressure; Gould & Maynard 2009", "text": "Psychological periodization for marathon training cycles: just as physical training periodizes intensity (base → build → peak → taper), psychological preparation periodizes focus across the training cycle. Base phase: build awareness, develop fundamental relaxation and attention skills. Build phase: introduce imagery rehearsal, competitive anxiety management, race-specific simulation in hard sessions. Peak phase: consolidate race strategies, complete full race-day mental rehearsal. Taper phase: reduce new skill introduction, reinforce existing skills, manage taper anxiety, complete race focus plan."}
{"chunk_id": "sport_psychology_expand_0248", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Smith et al. 2007 J Sport Exerc Psychol; Moran 2004 Sport Exerc Psychol", "text": "Race simulation in psychological training: incorporating race-like psychological conditions into training (starting at the same time as the race, wearing full race gear, running in weather similar to race-day forecasts) creates conditioned associations between those cues and optimal performance states. Research on contextual memory and state-dependent learning confirms that skills practiced in conditions matching the target environment transfer more reliably than skills practiced in neutral conditions. One full race-simulation session in the final 6 weeks of training is recommended."}
{"chunk_id": "sport_psychology_expand_0249", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Greenspan & Feltz 1989 Sport Psychol; Craft et al. 2003 Res Q Exerc Sport", "text": "Progressive relaxation and performance: Jacobson's progressive muscle relaxation (PMR), adapted for sport contexts, reduces somatic anxiety and physiological tension that impair running economy. Research by Greenspan & Feltz (1989) meta-analysis found relaxation-based interventions produced performance improvements in 85% of studies reviewed. A sport-adapted 15-minute PMR protocol focusing on the major running muscle groups (calves, quads, hamstrings, hip flexors, upper back) before racing is a clinically validated pre-race tool."}
{"chunk_id": "sport_psychology_expand_0250", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Wulf & Prinz 2001 Psychon Bull Rev; Masters & Maxwell 2008 Int Rev Sport Exerc Psychol", "text": "Attention control training for marathon running: internal and external attention cues can be trained through deliberate practice. Internal focus training — scanning bodily sensations systematically without judgement — improves marathon-relevant interoceptive accuracy. External focus training — directing attention to running mechanics, environment, or a visual target — improves running economy. Marathon runners with a tendency toward anxiety-driven internal focus benefit from structured external focus training during easy runs; runners who tend to 'check out' cognitively benefit from internal focus training during key sessions."}
{"chunk_id": "sport_psychology_expand_0251", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Moran 2004; Guillot & Collet 2008 Exerc Sport Sci Rev", "text": "Mental simulation protocols for race preparation: complete mental simulation — imagining the race in real time from start to finish at race pace — is most effective when multisensory (including sounds, physical sensations, emotions, weather), emotionally authentic (including anticipated difficult moments), and outcome-neutral (focusing on execution rather than only positive outcomes). Research on mental simulation in endurance events recommends at least 3 complete race simulations in the month before race day, with the final one completed 2–3 days before the race."}
{"chunk_id": "sport_psychology_expand_0252", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Allen & Laborde 2014 Psychol Sport Exerc; Connor-Smith & Flachsbart 2007", "text": "Introversion/extraversion and marathon training: personality research (Myers-Briggs, Big Five) finds that introversion predicts solo long-run preference and higher training completion in self-directed programs, while extraversion predicts stronger engagement with group training environments and events. Neither personality type shows overall marathon performance advantage. Practical implication: training program design should provide genuine options — group training (Tuesdays, Saturdays) and solo training formats — rather than defaulting to one social structure."}
{"chunk_id": "sport_psychology_expand_0253", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Eysenck et al. 1982 Personality Sport Perform; Ogles & Masters 2003", "text": "Type A personality and marathon participation: research on personality and endurance sport participation finds that Type A personality traits (competitiveness, impatience, high achievement orientation, time urgency) are overrepresented in marathon runners compared to the general population. Type A runners show higher training adherence but also higher overtraining rates, higher injury rates from pushing through warnings, and more severe post-race disappointment. Coaching Type A runners requires specific emphasis on rest legitimacy, process orientation, and performance-independent self-worth."}
{"chunk_id": "sport_psychology_expand_0254", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Bonnon et al. 1999 Ergonomics; Emonson & Vanderbeek 2006", "text": "High altitude and psychological adaptation: marathon training or racing at high altitude (>2,000m) produces physiological stress that has significant psychological sequelae. Research on acute mountain sickness and mood finds that altitude-induced hypoxia increases irritability, anxiety, and cognitive slowing even before clinical AMS symptoms appear. Runners training or racing at altitude should be educated that psychological changes — unusual fatigue, low mood, increased anxiety — are altitude-related symptoms, not personal weakness, and require pacing adjustments."}
{"chunk_id": "sport_psychology_expand_0255", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Flouris & Schlader 2015 Sports Med; Nybo & Nielsen 2001 J Appl Physiol", "text": "Running in extreme heat: psychological impact. Research on heat stress and affect finds that thermal discomfort reduces intrinsic motivation during exercise, increases perceived exertion nonlinearly above 25°C ambient temperature, and reduces psychological tolerance for effort at equivalent physiological intensities. In hot marathon conditions, race-day performance management should include explicit psychological permission to reduce pace targets — 'your thermal regulatory cost is real physiological work; adjusted targets are not failure but intelligent racing.'"}
{"chunk_id": "sport_psychology_expand_0256", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Filo et al. 2012 J Sport Manag; Bennett et al. 2012 J Nonprofit Volunt Sect Mark", "text": "Charitable fundraising and marathon motivation: research on prosocial motivation in sport finds that running for a charity cause significantly sustains motivation through difficult training periods, particularly in late-training-cycle low-motivation windows. A study by Filo et al. (2012) found runners with charitable commitments showed significantly lower dropout rates and higher race completion rates than runners without prosocial motivation, even when controlling for running experience. The mechanism is dual: external accountability (donors who have given money expect the runner to finish) and intrinsic meaning (suffering for a valued cause reduces subjective pain)."}
{"chunk_id": "sport_psychology_expand_0257", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Ruffault et al. 2016 Psychol Sport Exerc; Gkika & Wells 2015 Behav Cogn Psychother", "text": "Mindful running protocol: integrating mindfulness practice directly into running sessions — rather than as a separate pre/post practice — involves deliberate attention allocation to present-moment sensory experience during the run. Research by Gkika & Wells (2015) and Ruffault et al. (2016) demonstrated that mindful exercise protocols (maintaining open awareness of sensations, thoughts, and environment without reaction) produced stronger enjoyment, lower perceived exertion at the same intensity, and reduced post-run negative affect compared to distraction-based (music) running. A basic mindful running protocol: first 5 minutes tune to breath, middle section shift to body scan, final 5 minutes expand to environmental awareness."}
{"chunk_id": "sport_psychology_expand_0258", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Cotterill et al. 2010; Moran 2004 Sport Exerc Psychol", "text": "Competition day routines for recreational versus elite marathon runners: research on pre-competition routines across performance levels finds that routine specificity and adherence to routine is more important than any specific routine content. Recreational runners benefit significantly from developing and consistently using a race-day routine — even a simple one — because the routine primes the psychological state associated with training performances and reduces the cognitive novelty load of race environments. The 10–15 most common race-day anxiety triggers (transport delays, weather changes, equipment issues) should be explicitly covered in a pre-planned contingency script."}
{"chunk_id": "sport_psychology_expand_0259", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Ericsson et al. 1993 Psychol Rev; Zimmerman 2000", "text": "Post-competition learning conversations: research on deliberate practice in sport (Ericsson et al.) identifies structured post-performance review as a key mechanism of skill development. For marathon runners, a structured review 48–72 hours post-race — covering: what went according to plan, what didn't, what you would do differently, what you learned about your capabilities, and what you're proud of — produces stronger preparation improvement for subsequent races than unstructured reflection. The review should be written and stored for reference at the start of the next training cycle."}
{"chunk_id": "sport_psychology_expand_0260", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Cheng 2001 Pers Individ Dif; Nicholls et al. 2012 J Sport Exerc Psychol", "text": "Coping flexibility in marathon training: research on coping in endurance sport identifies 'coping flexibility' — the ability to switch between different coping strategies as situational demands change — as a better predictor of performance than reliance on any single coping strategy. Runners with high coping flexibility use problem-focused strategies when barriers are controllable (adjusting training if pace is off) and emotion-focused strategies when they are not (accepting weather conditions). Training coping flexibility involves explicitly practicing the transition between different coping modes in training simulations."}
{"chunk_id": "sport_psychology_expand_0261", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Bloom 1985 Developing Talent; Cote & Fraser-Thomas 2007", "text": "Long-term athlete development and psychological maturity: research on athletic career trajectories finds that recreational marathon runners tend to reach psychological maturity in the sport — comfort with performance variability, appropriate goal calibration, intrinsic motivation dominance — after 3–5 years of consistent participation. Before this point, coaches and systems should expect greater psychological volatility, stronger reactions to performance fluctuations, and more identity instability. This developmental understanding should inform how confidently a system presents performance predictions and how firmly it guides toward realistic goals."}
{"chunk_id": "sport_psychology_expand_0262", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Marcora 2010 Sports Med; Noakes 2011 Sports Med", "text": "The psychophysiology of marathon suffering: research identifies four distinct categories of discomfort in the later stages of marathon running, each with different psychological management approaches. (1) Metabolic suffering — glycogen depletion, acidosis — managed by nutritional pacing decisions and physical training; (2) Thermoregulatory suffering — heat accumulation — requires external management and physiological awareness; (3) Structural suffering — musculoskeletal fatigue and pain — managed by form adjustments and pre-race strength training; (4) Central fatigue suffering — neural exhaustion — most directly managed by psychological tools (self-talk, external focus, chunking). Most late-race suffering in recreational marathoners involves all four categories simultaneously."}
{"chunk_id": "sport_psychology_expand_0263", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Tesarz et al. 2012 Pain; Geva & Defrin 2013 Pain", "text": "Willingness to suffer: research on pain tolerance in endurance athletes consistently finds that marathon runners tolerate significantly higher levels of cold-pressor pain (ice water submersion) than non-runners, and that this tolerance increases with training and racing experience. The mechanism appears to be both psychological (trained pain acceptance) and neurobiological (modified central pain processing). Research by Tesarz et al. (2012, Pain) confirmed that endurance athletes showed attenuated pain perception compared to sedentary controls after controlling for physical condition."}
{"chunk_id": "sport_psychology_expand_0264", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Gardner & Moore 2004 Behav Modif; Hayes et al. 2006 Behav Res Ther", "text": "Acceptance-Commitment Therapy (ACT) for marathon training: ACT, developed by Hayes et al., proposes that the goal is not to reduce or eliminate pain but to change the runner's relationship to it. Psychological flexibility — the ability to contact present-moment experience without defense and pursue value-consistent action — is the core ACT mechanism. Research on ACT applications in sport (Gardner & Moore 2004, Henriksen et al. 2020) confirms that ACT-based protocols improve endurance performance by increasing willingness to remain in contact with discomfort rather than reducing the discomfort itself."}
{"chunk_id": "sport_psychology_expand_0265", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Masedo & Esteve 2007 Behav Res Ther; Páez-Blarrina et al. 2008", "text": "Defusion techniques for pain cognitions: ACT defusion involves observing thoughts and sensations as passing mental events rather than absolute truths. For marathon running, a simple defusion script: 'I notice I'm having the thought that I cannot continue' (versus 'I cannot continue') creates psychological distance from pain-driven cognitions and maintains behavioral choice. Research on cognitive defusion interventions in pain management (Masedo & Esteve 2007) found defusion-trained participants maintained 40% higher performance times in pain tolerance tests compared to control."}
{"chunk_id": "sport_psychology_expand_0266", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Tedeschi & Calhoun 2004 Psychol Inquiry; Barker et al. 2011", "text": "Suffering as meaning: research on post-traumatic growth and resilience in sport identifies voluntary suffering with purpose as a mechanism for meaning-making and psychological growth. Marathon runners who reflect on their most difficult race moments frequently describe these as among their most meaningful life experiences. The experience of choosing to continue through significant discomfort, and succeeding, produces a specific form of self-knowledge ('I know what I'm capable of when things are hard') that most runners describe as among their most valuable personal insights."}
{"chunk_id": "sport_psychology_expand_0267", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Noakes et al. 2005 J Exp Biol; Tucker & Noakes 2009 Br J Sports Med", "text": "The teleoanticipatory model of pacing: Nobel & Noakes proposed that runners subconsciously estimate remaining effort capacity and regulate current output against the anticipated endpoint. This model explains why runners can dramatically increase pace in the final 400m of a marathon despite extreme fatigue — the brain detects proximity to endpoint and releases held-back central reserves. Psychologically, race segmentation that makes each 'endpoint' feel achievable (1km at a time) exploits this mechanism, making the 'finish' feel reachable earlier in the race."}
{"chunk_id": "sport_psychology_expand_0268", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Beedie et al. 2006 Int J Sports Nutr Exerc Metab; Foad et al. 2008", "text": "Expectation effects on performance: research by Beedie et al. (2006) demonstrated that athletes given placebos while told they were receiving caffeine showed performance improvements equivalent to actual caffeine. This expectation effect (believing a performance enhancer has been taken improves performance) is robust across endurance sports and indicates that psychological belief about capacity is a direct determinant of effort output. Pre-race confidence building — systematically reviewing evidence of fitness and readiness — produces genuine performance effects through the expectation pathway."}
{"chunk_id": "sport_psychology_expand_0269", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Heath et al. 1999 J Mark Res; Wulf & Lewthwaite 2016", "text": "The role of personal records in setting psychological anchors: research on reference point theory in motivation finds that previous personal bests serve as strong psychological anchors that structure goal formation and effort regulation in subsequent races. Runners running their second marathon consistently use their first finishing time as a reference point — either as a baseline to improve ('sub-4 this time'), a guarantee to repeat, or a feared regression point. Understanding the specific role personal records play for an individual runner informs goal-setting for subsequent races."}
{"chunk_id": "sport_psychology_expand_0270", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Tucker et al. 2006 Br J Sports Med; Otten 2009 J Motor Behav", "text": "The end-spurt psychology: research on pacing in marathon running consistently documents a U-shaped speed profile — faster at start, slower in the middle, then final acceleration in the last 1–2 km. The psychology driving this end-spurt is the release of conserved capacity as the finish proximity eliminates uncertainty. Research by Otten (2009, J Motor Behav) documented similar patterns in cognitive tasks — end-spurt effects appear universal across domains involving effort toward a defined endpoint. The practical application: ensuring goal focus ('the finish line is X km away') is maintained in late-race psychological support."}
{"chunk_id": "sport_psychology_expand_0271", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Kivetz et al. 2006 J Mark Res; Nunes et al. 2011", "text": "Goal proximity effects in late-race running: research on goal gradient theory (Hull 1932; Kivetz et al. 2006) predicts that motivation and effort increase as goal proximity increases. In marathon terms: effort level does not decrease linearly with fatigue but shows a characteristic increase as the finish line becomes experientially proximate (last 2–3 km for most runners). Race coaching should build on this by making finish proximity vivid in the late-race period — specific distance counts ('only 3 km to go, not much more than a training warm-up') rather than vague encouragement ('almost there')."}
{"chunk_id": "sport_psychology_expand_0272", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Kellmann 2010 Eur J Sport Sci; Kellmann & Kallus 2001 RESTQ-Sport", "text": "Psychological recovery from training is distinct from physiological recovery and requires its own monitoring and intervention. Research by Kellmann (2010) and the Recovery-Stress Questionnaire for Athletes (RESTQ-Sport) identifies psychological recovery dimensions: social recovery (positive interaction with others), general wellbeing, physical rest, and mental downtime. Well-recovered athletes in all four dimensions show markedly better subsequent training quality than those with adequate physical but poor psychological recovery."}
{"chunk_id": "sport_psychology_expand_0273", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Kellmann 2010; Meehan et al. 2004 J Appl Sport Psychol", "text": "Social recovery days: research on psychological recovery in endurance athletes highlights that socially rich rest days — spending time with family, friends, and in community activities unrelated to running — produce stronger recovery outcomes than socially isolated rest. Runners who 'recover in isolation' (alone at home, resting physically) show slower HRV recovery and more negative mood the following training day than those who maintain social engagement during rest. For training plan psychology, structuring active social recovery alongside physical rest produces better overall training outcomes."}
{"chunk_id": "sport_psychology_expand_0274", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Baumeister et al. 1998 J Pers Soc Psychol; Marcora et al. 2009 J Appl Physiol", "text": "Cognitive depletion and training quality: willpower research (Baumeister et al.) demonstrates that the same brain regions governing self-control, decision-making, and effort maintenance in running are depleted by non-running demands. High cognitive load workdays (intensive decision-making, emotional demands) reduce running performance quality even when physical recovery is adequate. Research by Marcora et al. (2009) demonstrated that prior cognitive fatigue increased perceived exertion during subsequent exercise. Marathon runners in cognitively demanding professions should account for work-related cognitive depletion in training planning."}
{"chunk_id": "sport_psychology_expand_0275", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Emmons & McCullough 2003 J Pers Soc Psychol; Wood et al. 2011 Pers Individ Dif", "text": "Gratitude practice in athletic recovery: research on positive psychology interventions in sport contexts finds that gratitude journaling — writing 3 specific things experienced with gratitude from a training session or day — reduces the negative psychological impact of training setbacks and produces measurable mood improvement in 6-week protocols. For marathon runners in high-stress training cycles, a 5-minute gratitude practice post-session provides a structured positive cognitive anchor that offsets the rumination common after hard or disappointing sessions."}
{"chunk_id": "sport_psychology_expand_0276", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Bompa & Haff 2009 Periodization; Hellard et al. 2006 J Strength Cond Res", "text": "The recovery-performance paradox: research on athlete monitoring in marathon training shows that most amateur runners systematically underestimate the value of easy days and rest. This is partly psychological — rest produces no immediate tangible 'training output' and therefore feels wasted — and partly cultural (competitive running culture often glorifies high volume and high effort). The evidence-based counter-frame: physiological adaptations occur during recovery, not during training stress. 'Today's rest is making tomorrow's hard session possible' is a factually accurate reframe that psychologically legitimizes recovery."}
{"chunk_id": "sport_psychology_expand_0277", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Dantzer et al. 2008 Nat Rev Neurosci; practitioner synthesis", "text": "Post-long-run psychological decomposition: following long runs over 28 km, many runners report a 2–4 hour 'psychological hangover' — low mood, reduced motivation for daily activities, mild irritability, and emotional flatness. This is a normal physiological response to extreme effort (glucocorticoid release, inflammatory cytokine elevation) and resolves with food, hydration, and rest. Understanding this pattern helps runners schedule important personal or work commitments away from post-long-run afternoons, and recognize that the depressed mood is transient and physiologically caused rather than indicative of a problem with their training or life."}
{"chunk_id": "sport_psychology_expand_0278", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Ericsson et al. 1993 Psychol Rev; Starkes & Ericsson 2003 Expert Perf", "text": "Deliberate practice in marathon training: Ericsson's deliberate practice framework applied to marathon running emphasizes that performance-developing training is not simply logging miles but engaging in purposeful, attention-demanding practice with specific feedback on performance. Research on expert runners finds that they spend significantly more time on quality sessions (tempo, intervals, race simulations) relative to total volume than amateur runners, and that their easy sessions are executed with deliberate attention to form and effort control rather than mindless completion."}
{"chunk_id": "sport_psychology_expand_0279", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Tenenbaum 2003 Appl Sport Psychol; Williams & Ericsson 2005 Psychol Sport Exerc", "text": "Executive function and race management: elite marathon runners demonstrate superior executive function in race-management tasks — setting pace precisely, making mid-race nutritional decisions, managing emotional state. Research by Tenenbaum (2003) on expert-novice differences in sport decision-making found experts process race-state information faster, require less attentional effort for routine monitoring, and show better 'situation awareness' (knowing what is happening, what will happen, and what to do) throughout the race."}
{"chunk_id": "sport_psychology_expand_0280", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Fletcher & Sarkar 2012 J Sci Med Sport; Gucciardi et al. 2011 Sport Exerc Psychol", "text": "Resilience building in marathon training: sport psychology defines resilience as the ability to adapt positively to adversity (injury, poor races, missed training). Research by Fletcher & Sarkar (2012, J Sci Med Sport) found five psychological resilience factors in elite athletes: positive personality (particularly optimism and competitiveness), motivation, confidence, focus, and perceived social support. All five are trainable. Marathon runners who deliberately build each factor across their training cycle show better recovery from training setbacks and adverse race conditions."}
{"chunk_id": "sport_psychology_expand_0281", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Gucciardi & Gordon 2009; Swann et al. 2017 Psychol Sport Exerc", "text": "Championship mindset components for recreational marathon runners: research on 'championship' or 'clutch' performance in athletes identifies four components accessible to recreational runners: (1) focusing on process over outcome during performance; (2) embracing competitive pressure as information rather than threat ('pressure means this matters to me'); (3) maintaining presence — full attention to the current moment of the race; (4) competitive optimism — expecting to handle whatever arises rather than fearing specific scenarios. All four can be explicitly trained through specific MST interventions."}
{"chunk_id": "sport_psychology_expand_0282", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Butler & Hardy 1992 Sport Psychol; Dale & Wrisberg 1996 J Appl Sport Psychol", "text": "Performance profiling for marathon runners: Butler & Hardy's performance profiling is a structured tool in which runners identify the characteristics of an excellent marathon runner, rate their own current performance on each characteristic, and identify the gap between ideal and current. This process produces individualized psychological training priorities more effectively than generic MST programs, because it aligns with the runner's own conceptual framework for excellence. Research confirms performance profiling produces higher engagement with MST programs than consultant-directed programs."}
{"chunk_id": "sport_psychology_expand_0283", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Tenenbaum 2003; Williams & Ericsson 2005", "text": "Competitive intelligence from other runners: research on expert marathon performance reveals that elite runners process competitor behavior as performance information — using competitor pace and form to infer course conditions, race position, and optimal response. Recreational runners rarely develop this skill but can benefit from basic awareness: noticing whether runners around them are struggling (suggests current pace is appropriate), thriving (suggests underperformance), or disappearing ahead (suggests pace discrepancy requiring decision)."}
{"chunk_id": "sport_psychology_expand_0284", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Martin 2001 Psychol Bull; Kuiper et al. 1993 Psychol Rep", "text": "Humor and running: research on humor use in endurance sports finds that runners who maintain or seek humor during hard training and races report higher perceived competence, lower perceived effort, and more positive training experiences. Humor functions as a cognitive reappraisal tool — reinterpreting hardship as entertaining rather than threatening. Training groups that actively cultivate a humorous culture (inside jokes, playful nicknames for hard sessions) show better group cohesion and training adherence. Coaches can deliberately model humor as an emotional regulation strategy during difficult group sessions."}
{"chunk_id": "sport_psychology_expand_0285", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Csikszentmihalyi 1990; Plante et al. 2001 Adv Mind Body Med", "text": "The long run as meditation: experienced marathon runners frequently describe the long run as a meditative or contemplative practice — a structured time for mental quieting, problem-solving, and self-reflection that is unavailable in the busyness of daily life. This experience closely parallels descriptions of meditative practice in clinical psychology: present-moment awareness, reduced self-referential thinking, and non-judgmental attention. Research on running-as-meditation finds that runners who approach the long run with this framework report higher enjoyment and meaning despite equivalent physical demand."}
{"chunk_id": "sport_psychology_expand_0286", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Tod et al. 2011 Psychol Sport Exerc; Hatzigeorgiadis et al. 2009", "text": "Context-appropriate psychological intervention selection: research on psychological intervention matching establishes that the same intervention that helps one runner can hinder another. Motivational self-talk improves performance in those who use little self-talk but can reduce performance in those who already self-talk naturally. Imagery is most beneficial for runners with adequate basic physical skills; premature imagery for beginners can increase frustration. A responsive marathon coaching system should provide a range of psychological tools and observe which are most engaging for each individual rather than mandating a single approach."}
{"chunk_id": "sport_psychology_expand_0287", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Taylor & Wilson 2005 App Sport Psychol; practitioner synthesis", "text": "Marathon psychology integration checklist for peak performance readiness: a structured pre-race psychological readiness assessment should confirm: (1) race goals are set at all three levels (A/B/C); (2) a complete race focus plan exists; (3) race-day logistics are fully planned, eliminating day-of decisions; (4) at least 3 race simulations have been completed in imagery; (5) specific mantras are assigned to the first km, km 20–30, and final 5 km; (6) the 'wall permission script' is written and memorized; (7) post-race accommodation and celebration plan is in place; (8) the runner has a post-race mental debrief protocol planned."}
{"chunk_id": "sport_psychology_expand_0288", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Buman et al. 2009 J Sport Exerc Psychol; Mann et al. 2014 Soc Psychol", "text": "Training motivation slumps are a predictable feature of 16–24 week marathon preparation. Research by Buman et al. (2009) and analysis of training logs from first-time marathoners found that motivation dips occur with high frequency at three points: weeks 3–5 (effort exceeds initial enthusiasm), weeks 8–10 (novelty has worn off, race is not yet imminent), and weeks 13–15 (accumulated fatigue before taper). Each slump has a distinct psychological profile and optimal response strategy. Knowledge that these slumps are normal and time-limited significantly reduces their dropout impact."}
{"chunk_id": "sport_psychology_expand_0289", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Buman et al. 2009; Gardner et al. 2012 Br J Health Psychol", "text": "Week 3–5 slump intervention: early-training slumps typically resolve best through milestone creation rather than motivation-building. At this stage, the runner hasn't yet built habits, hasn't seen meaningful progress, and hasn't experienced the community and identity reinforcement that comes with sustained participation. Practical response: create a concrete early milestone (first 10-mile long run, first week of 4+ consecutive training days), celebrate it specifically, and use it as evidence that 'this is working.' Progress salience is the primary motivational intervention in early-training slumps."}
{"chunk_id": "sport_psychology_expand_0290", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Buman et al. 2009; Milkman et al. 2014", "text": "Week 8–10 mid-training slump intervention: mid-training slumps are driven by routine fatigue — training has become predictable, the race feels distant, and the effort level is high but undramatic. Effective interventions: (1) a time-trial or tune-up race to create a fresh goal and milestone in the near term; (2) a new training route or partner to introduce novelty; (3) a 'remember why' exercise — writing about initial motivation and what training has given since then; (4) a planned easy week (not the scheduled taper, but an unscheduled lighter week) if fatigue is primary."}
{"chunk_id": "sport_psychology_expand_0291", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Kreher & Schwartz 2012 Sports Health; Buman et al. 2009", "text": "Late-training slump (weeks 13–15): fatigue-driven demoralization at this stage shares features with overtraining monitoring markers: declining mood, increasing perceived effort at fixed paces, reduced enjoyment of sessions, and sleep disturbance. The critical psychological distinction: is this normal late-training fatigue (resolves with taper) or early overtraining syndrome (requires modification)? The most reliable discriminator is trend over 3–5 days: if rest days bring mood and motivation restoration, normal fatigue; if rest days bring no improvement, overtraining warrants medical review."}
{"chunk_id": "sport_psychology_expand_0292", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Gailliot & Baumeister 2007 Pers Soc Psychol Rev; practitioner synthesis", "text": "Motivational recovery tactics for bad training days: research on self-regulatory resource replenishment finds that brief high-reward activities — not avoidant activities like social media browsing — between training obligations rapidly restore motivation. For marathon runners, a reliable post-bad-run recovery includes: (1) eating something satisfying and preferably social; (2) noting specifically what still went right in the session; (3) leaving the training log entry open and returning to add a realistic perspective note 2 hours later. Immediate negative log entries or run-shaming typically consolidate the negative emotional state rather than resolving it."}
{"chunk_id": "sport_psychology_expand_0293", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Tolfrey et al. 2009 J Sports Sci; Koehler et al. 2013 Eur J Sport Sci", "text": "The weight-speed relationship and psychological consequences: research confirms a linear relationship between body mass and marathon performance in recreational runners — lower weight at equivalent fitness produces faster finishing times. However, weight loss pursuit during marathon training carries significant psychological and physiological risks, including disordered eating, loss of lean muscle mass, nutrient deficiency, and reduced training quality. A marathon assistant system should avoid weight prescriptions without comprehensive assessment, and should never suggest weight loss as a performance optimization strategy independent of professional dietary counseling."}
{"chunk_id": "sport_psychology_expand_0294", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Fletcher & MacIntosh 2017 J Strength Cond Res; Williams 1990 Sports Sci", "text": "Running economy vs weight: research indicates that running economy improvements (more efficient stride mechanics, better neuromuscular coordination, increased mitochondrial density) produce faster marathon times without any weight change. The psychological implication is that framing performance improvement as a process of becoming a more efficient runner — rather than a lighter one — redirects motivation toward training quality and away from weight-driven behaviors that carry eating disorder risk."}
{"chunk_id": "sport_psychology_expand_0295", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Fredrickson & Roberts 1997 Psychol Women Q; Homan & Tylka 2014", "text": "Athletic body image and running: research on body image in female endurance athletes (Betz & Wespe 2002) finds a paradox: despite being physiologically fit and functionally capable, many female marathon runners report higher body dissatisfaction than sedentary women of equivalent weight, driven by comparison to elite running physiques. The 'lean runner' aesthetic creates a perceived performance-body ideal that produces body dissatisfaction as a chronic background to training. Sport psychology interventions building body functionality satisfaction ('what my body can do') versus body appearance satisfaction ('how my body looks') show the strongest sustainable positive body image outcomes."}
{"chunk_id": "sport_psychology_expand_0296", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "clinical_practice_guideline", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Mountjoy et al. 2018 IOC RED-S consensus update Br J Sports Med", "text": "RED-S psychological warning signs for marathon coaches: a marathon system should recognize potential RED-S indicators warranting professional referral: (1) runner describes severe caloric restriction with explicit performance justification; (2) runner reports menstrual disruption or absence; (3) runner expresses extreme distress about eating around training; (4) runner reports stress fracture history; (5) runner shows extreme thinness with high training volume. These signals warrant professional medical and nutritional referral, not dietary advice from a coaching system."}
{"chunk_id": "sport_psychology_expand_0297", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Tucker & Gilliland 2007; Shephard 1994 Can J Appl Physiol", "text": "Weather psychology in marathon training: research on exercise behavior and weather finds that the strongest predictor of training session skipping among recreational runners is low temperature below 5°C and precipitation, rather than actual physiological risk. The psychological barrier to cold-weather running is substantially larger than the physiological one. Behavioral strategies that reduce weather-related dropout: cold-weather 'kit readiness' (gear laid out night before), a trained psychological reframe ('cold weather running is a competitive advantage — others will skip'), and specific mantras for launching into adverse weather."}
{"chunk_id": "sport_psychology_expand_0298", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Focht 2009 Int J Behav Nutr Phys Act; Leventhal & Brooks 2019", "text": "Treadmill running psychology: research on treadmill versus outdoor running finds consistent differences in psychological experience: perceived exertion is higher on treadmill at equivalent paces, enjoyment is lower, and time perception is slower (sessions feel longer). However, treadmill running produces superior pacing control and eliminates weather barriers. A psychologically optimal approach uses treadmill for specific quality sessions (controlled tempo work) while reserving outdoor running for long runs where enjoyment, variety, and mind-restoration effects are highest."}
{"chunk_id": "sport_psychology_expand_0299", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Berger & Motl 2000; Raichlen et al. 2021 Front Physiol", "text": "Early morning running and mood: research on time-of-day exercise effects finds that morning exercisers (running before 8am) report higher positive affect post-exercise compared to afternoon exercisers, and this mood boost lasts longer (up to 6 hours) due to the absence of competing stress accumulation later in the day. Morning runners also show superior long-term adherence in research studies, likely because morning sessions are less frequently displaced by daily schedule changes. The psychological barrier to morning running (alarm shock) is highest in the first 4–6 weeks and typically diminishes as circadian adaptation occurs."}
{"chunk_id": "sport_psychology_expand_0300", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Terry et al. 2020 Psychol Sport Exerc; Karageorghis & Priest 2012", "text": "Running with music versus without: a meta-analysis by Terry et al. (2020, Psychol Sport Exerc) found that music improves performance by approximately 2.9% in submaximal exercise (comfortable training pace) and improves positive affect by a moderate effect size (d=0.48). However, music's effects diminish at high intensities (above 80% VO2max) and are absent in elite athlete populations. For recreational marathon runners, music provides meaningful psychological support during easy and moderate-intensity training but is not recommended during races where internal body awareness and race strategy are performance-critical."}
{"chunk_id": "sport_psychology_expand_0301", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Kaplan 1995 Ann Behav Med; Thompson Coon et al. 2011", "text": "Urban versus rural running psychology: research on psychological restoration theory finds that natural environments (parks, trails, rural roads) produce stronger 'soft fascination' — involuntary attention that allows directed attention to rest — compared to urban environments. Runners who regularly access natural environments in training show higher training enjoyment, lower cortisol post-run, and report more 'time well spent' experience even when pace is equivalent. Training programs in urban settings should include specific green-space access as a psychological health component."}
{"chunk_id": "sport_psychology_expand_0302", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Shipway & Holloway 2010; Ogles & Masters 2003; Cote & Fraser-Thomas 2007", "text": "Longitudinal research on marathon runner psychology identifies a 3-phase psychological evolution: (1) Initiation phase (0–18 months participation) — characterized by novelty, high extrinsic motivation, frequent comparison to others, and significant performance anxiety; (2) Establishment phase (18 months–5 years) — emerging intrinsic motivation, reduced social comparison, stable training habits, more sophisticated race-strategy psychology, and identity consolidation; (3) Maintenance phase (5+ years) — primary motivation shifts to health, meaning, and community, performance anxiety reduces significantly, and resilience to performance setbacks increases substantially."}
{"chunk_id": "sport_psychology_expand_0303", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Ericsson 1996 Road to Excellence; Beilock & Carr 2001", "text": "Running economy of psychological skill: experienced runners spend less mental effort on tasks that are effortful for beginners — pace calibration becomes automatic, gear preparation becomes routine, and nutrition timing becomes second nature. This 'psychological skill automatization' frees attentional resources for higher-order race management, enjoyment, and community engagement. The development of psychological automaticity is an underappreciated mechanism explaining why experienced runners often find marathons more enjoyable than beginners despite being aware of the physical demands."}
{"chunk_id": "sport_psychology_expand_0304", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Allen Collinson 2008 Sociol Sport J; Shipway 2010", "text": "Running as a life practice: research on long-term runners consistently finds that marathon participation becomes integrated into life structure — shaping sleep schedules, food choices, social activities, and identity — rather than remaining a discrete 'athletic activity.' This integration is both an adherence mechanism (running is now part of the life structure, not just an add-on) and a psychological resilience resource (the running community, embodied competence, and regular mood management are all woven into daily experience). Marathon coaches working with experienced runners should honor this integration rather than treating running as merely a performance domain."}
{"chunk_id": "sport_psychology_expand_0305", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Buman et al. 2008; Ogles & Masters 2003; sport career research", "text": "Multi-marathon psychology: runners who have completed 5+ marathons show distinct psychological patterns from those in their first or second race. Research finds multi-marathon runners: have significantly lower pre-race anxiety (based on experience), show more sophisticated wall management (having navigated multiple wall experiences), are more likely to use positive reappraisal than avoidant coping, and demonstrate lower performance stakes dependency — they find genuine satisfaction in the process even when performance is below previous bests. Each additional marathon experience strengthens psychological race-management skill."}
{"chunk_id": "sport_psychology_expand_0306", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Stambulova et al. 2009 J Clin Sport Psychol; Taylor & Ogilvie 1998", "text": "Retirement from marathon running: a minority but psychologically significant group of runners experience difficulty retiring from marathon competition due to age, injury, or life change. Research on sport retirement psychology (Stambulova et al. 2009) finds that voluntary retirement produces less psychological distress than forced retirement (injury, health). Psychological support for marathon retirement involves: identity bridging (maintaining running community involvement through volunteering, coaching, spectating), activity substitution (finding equivalent physical challenge), and grief normalization (acknowledging genuine loss of a valued life practice)."}
{"chunk_id": "sport_psychology_expand_0307", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Li et al. 2020 Asia Pac J Sport Soc Sci; Ogles & Masters 2003", "text": "Cultural variation in marathon motivation: cross-cultural research on marathon participation motivations finds meaningful differences between Western (primarily individual achievement and health) and East Asian (primarily community honor, social obligation, and collective identity) runners. Research by Li et al. (2020) with Chinese marathon runners found that 'face' concerns — maintaining social reputation — were significantly more predictive of race entry motivation in Chinese runners than in American runners, while intrinsic enjoyment was equally important across both groups."}
{"chunk_id": "sport_psychology_expand_0308", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Zatzick & Dimsdale 1990 Pain; Mogil 2012 Nat Rev Neurosci (cultural section)", "text": "Pain tolerance cultural variation: research on cultural influences on pain tolerance finds significant cross-cultural differences in willingness to report and tolerate exercise-induced discomfort. Studies comparing East Asian and Western athletic populations find that shame avoidance rather than pain avoidance may be a stronger motivator for continuing in East Asian runners — the psychological cost of DNF or public suffering is culturally weighted differently. Marathon coaching systems serving culturally diverse populations should be aware that a single psychological framework for pain management may not apply equally across cultural backgrounds."}
{"chunk_id": "sport_psychology_expand_0309", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Karau & Williams 1993 J Pers Soc Psychol; Lount & Wilk 2014", "text": "Collective identity and team marathon events: relay marathons, team challenges, and group charity runs create collective identity experiences that motivate differently from individual competition. Research on collective effort in sport (social loafing and social facilitation literature) finds that well-structured team marathon challenges produce higher commitment than equivalent individual challenges because collective accountability reduces dropout psychology — letting teammates down is a more powerful behavior inhibitor than personal commitment alone."}
{"chunk_id": "sport_psychology_expand_0310", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Bandura 1997 Self-Efficacy; Martin 2008 J Appl Sport Psychol", "text": "Bandura's Self-Efficacy Theory is the most empirically supported psychological predictor of athletic performance. Self-efficacy — the belief in one's capacity to perform a specific behavior at a specific level — predicts marathon performance over and above objective training metrics in multiple studies. Research by Martin (2008) found that pre-race self-efficacy explained 11–18% of variance in marathon finishing time among runners with equivalent training volumes, demonstrating that what runners believe about themselves is an independent performance variable."}
{"chunk_id": "sport_psychology_expand_0311", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Bandura 1977 Psychol Rev; 1997 W.H. Freeman; Feltz et al. 2008", "text": "Four sources of self-efficacy: Bandura identifies four mechanisms through which marathon runners build performance beliefs. (1) Mastery experiences — successfully completing challenging training milestones (the most powerful source); (2) Vicarious modeling — observing similar others achieve marathon goals ('if they can, I can'); (3) Social persuasion — verbal encouragement from coaches, training partners, and community; (4) Physiological states — interpreting body signals as indicators of readiness versus fatigue. Well-designed marathon coaching deliberately activates all four sources, with mastery experiences as the foundation."}
{"chunk_id": "sport_psychology_expand_0312", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Feltz et al. 2008 Self-Efficacy in Sport; Maddux 1995", "text": "Confidence building strategies for marathon preparation: research-supported approaches include: (1) graduated success experiences — progressively longer long runs, each completed successfully; (2) race simulation training — completing race-specific sessions (long runs at race pace for the final segment) that directly mirror race demands; (3) training data review — systematically reviewing evidence of fitness improvements across the training cycle; (4) pre-race 'case for confidence' — writing a structured argument for why the runner is prepared, citing specific completed workouts and improved benchmarks."}
{"chunk_id": "sport_psychology_expand_0313", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Paskevich et al. 1999; Watson et al. 2001 J Appl Sport Psychol", "text": "Collective efficacy in team and pacemaker contexts: team-based marathon events and organized pacemaker groups create collective efficacy — the shared belief in the team's capacity to achieve a goal. Research by Paskevich et al. (1999) and Watson et al. (2001) found that collective efficacy is a stronger predictor of team-sport performance than the sum of individual efficacies. In marathon contexts, sub-3-hour pacemaker groups function as high collective efficacy units — the shared belief that 'this group will make it' produces individual effort levels exceeding what runners achieve alone."}
{"chunk_id": "sport_psychology_expand_0314", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Magyar & Feltz 2003; Podlog & Eklund 2007 Psychol Sport Exerc", "text": "Self-efficacy and recovery from setbacks: research consistently finds that athletes with high pre-setback self-efficacy show faster recovery of training motivation and performance after injury, poor race results, or forced training interruptions. This 'resilience reservoir' function of self-efficacy explains why building genuine confidence during training — rather than only during peak fitness periods — is a long-term investment. Coaches who ensure early training successes are explicitly recognized and celebrated build a self-efficacy reserve that sustains runners through inevitable training disruptions."}
{"chunk_id": "sport_psychology_expand_0315", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Buman et al. 2008; Taylor & Brown 1988 Psychol Bull", "text": "Overconfidence as a risk factor in marathon running: while self-efficacy predicts better performance at equivalent training levels, excessive optimism about race capability beyond training preparation produces pacing errors. Research on unrealistic optimism in recreational runners (Buman et al.) finds that runners who significantly overestimate their race capability show worse race outcomes than those with accurate self-assessment, primarily through first-half pacing errors. The optimal state is 'calibrated confidence' — high belief in one's capacity to execute a plan that the training actually supports."}
{"chunk_id": "sport_psychology_expand_0316", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Hays et al. 2009 J Sport Exerc Psychol; Hays et al. 2007", "text": "Confidence cues: research on performance confidence in sport identifies 'confidence cues' — specific memories, images, or sensations that reliably activate confident psychological states. For marathon runners, common confidence cues include: the memory of finishing a particularly hard long run, a previously executed race segment that 'clicked,' or the physical sensation of running at target pace and feeling controlled. Identifying personal confidence cues and rehearsing their deliberate activation (through imagery) is a sport psychology practice with evidence support for performance under pressure."}
{"chunk_id": "sport_psychology_expand_0317", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Feltz 1982 J Pers Soc Psychol; Starek & McCullagh 1999", "text": "The confidence-performance spiral: confidence and performance exist in a bidirectional feedback loop — confidence produces better performance, which builds further confidence. Research by Feltz (1982) established this spiral with self-efficacy and motor task performance. For marathon runners, designing training to maximize this spiral involves: ensuring training sessions have a success definition (not just completion), celebrating milestones explicitly, using training data review to make progress visible, and contextualizing difficult sessions as evidence of training capacity rather than evidence of limitation."}
{"chunk_id": "sport_psychology_expand_0318", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Hamasaki 2020 J Funct Morphol Kinesiol; Courtney 2009 Biofeedback", "text": "Diaphragmatic breathing training for runners: research on breathing mechanics in distance runners finds that most recreational runners use predominantly thoracic (chest) breathing under effort, which activates accessory respiratory muscles, creates tension in the shoulders and neck, and increases oxygen cost. Diaphragmatic breathing — belly expansion during inhalation — is more efficient and activates the parasympathetic relaxation response. Research by Hamasaki (2020) confirmed that regular diaphragmatic breathing training improved exercise efficiency and reduced perceived exertion."}
{"chunk_id": "sport_psychology_expand_0319", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Coates & Kowalchik 2013 Running on Air; research on breathing patterns", "text": "Rhythmic breathing in running: research on breathing rhythm and running economy finds that synchronizing breathing rhythm with stride cadence (the 'breathing footstrike' pattern) reduces musculoskeletal impact asymmetry. Budd Coates' 3:2 breathing pattern (3 strides exhale:2 strides inhale) is the most studied recreational runner protocol; it distributes foot impact stress across both legs equally in relation to exhalation (the highest stress moment of the breathing cycle). At higher intensities, a 2:1 pattern is physiologically required."}
{"chunk_id": "sport_psychology_expand_0320", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Balban et al. 2023 Cell Rep Med; Russo et al. 2017 Front Hum Neurosci", "text": "Physiological sigh protocol for mid-race anxiety: research by Balban et al. (2023, Cell Reports Medicine) found that cyclic sighing (slow double-nasal inhale followed by long oral exhale) for 5 minutes produced the largest improvements in positive affect and reductions in anxiety compared to other breathing protocols including box breathing and mindfulness meditation. In a marathon context, a brief 60-second cyclic sigh protocol at aid stations or before difficult segments provides a rapid evidence-based physiological regulation tool."}
{"chunk_id": "sport_psychology_expand_0321", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Zaccaro et al. 2018 Front Hum Neurosci; Thayer & Lane 2009 Int J Psychophysiol", "text": "Box breathing for pre-race anxiety: Box breathing (4-count inhale, 4-count hold, 4-count exhale, 4-count hold) is the most widely adopted structured breathing protocol in performance contexts, originally developed in military special operations training. Research on controlled breathing and HRV confirms that slow, regular breathing at 5–6 breaths per minute (including box breathing) produces strong parasympathetic activation and anxiety reduction. The 4-count box rhythm equates to approximately 4 breaths per minute, which is within the optimal range for HRV enhancement."}
{"chunk_id": "sport_psychology_expand_0322", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Weil 1999 Breathing: The Master Key; Zaccaro et al. 2018", "text": "4-7-8 breathing technique: Andrew Weil's 4-7-8 pattern (inhale 4 counts, hold 7 counts, exhale 8 counts) emphasizes prolonged exhalation, which is the most potent component of breathing for vagal nerve activation and rapid parasympathetic response. Research on slow exhalation specifically (longer exhale than inhale) consistently shows acute anxiety reduction within 3–5 minutes of practice. For marathon runners with high pre-race somatic anxiety, 5 repetitions of 4-7-8 breathing 20–30 minutes before race start produces reliable rapid anxiety reduction."}
{"chunk_id": "sport_psychology_expand_0323", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Kabat-Zinn 1994 Wherever You Go; Mehta et al. 2012", "text": "Breathing and attentional focus: research on breathing-focused attention (as practiced in mindfulness protocols) demonstrates that breath attention is the most reliable attentional anchor in high-distraction environments. During a marathon, the crowd noise, pain, competitive stimuli, and environmental complexity create significant attentional interference. Returning focus to breath rhythm (footstrike-breath synchrony or count-regulated breathing) provides a low-cognitive-cost attentional anchor that reduces mental chaos during difficult race segments."}
{"chunk_id": "sport_psychology_expand_0324", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Tucker et al. 2006; Noakes 2011 Lore of Running; Pageaux & Marcora 2016", "text": "Pacemaker psychology in competitive marathon running: elite marathon world records are almost universally set with pacemaker assistance. Research by Tucker et al. on pacemaker effects found that runners with pacemakers run at target pace with significantly less attentional effort, lower cognitive load, and lower perceived exertion than solo runners at the same pace. The pacemaker externalizes the pace monitoring task, freeing cognitive resources for effort maintenance. This mechanism is accessible to recreational runners via GPS pacing apps, metronome cadence cues, and pacemaker group enrollment."}
{"chunk_id": "sport_psychology_expand_0325", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Carron et al. 2004 J Sport Exerc Psychol; practitioner synthesis", "text": "Training partner compatibility research: study of recreational runner dyads finds that training partner compatibility on three dimensions predicts best outcomes — (1) pace compatibility (within 30–45 seconds per km on easy days); (2) scheduling compatibility (consistent availability for planned sessions); (3) psychological compatibility (similar attitudes toward competition, conversation during runs, response to bad days). Research confirms that incompatible training partners — particularly significant pace mismatches — produce more harm than solo training due to chronic over- or under-pacing."}
{"chunk_id": "sport_psychology_expand_0326", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Irwin et al. 2012 Ann Behav Med; Feltz et al. 2011 Ann Behav Med", "text": "The Köhler effect in partner running: research by Irwin et al. (2012) and Feltz et al. (2011) experimentally demonstrated the Köhler effect in exercise contexts: the less-able partner in an exercise dyad works significantly harder when exercising together than when exercising alone, without the more-able partner experiencing performance decline. This effect is larger when the performance difference is small to moderate and when the task is interdependent. Running with a slightly faster partner produces motivationally superior results for the slower runner compared to running alone."}
{"chunk_id": "sport_psychology_expand_0327", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Gucciardi & Gordon 2009; Connaughton et al. 2008 J Sci Med Sport", "text": "Mental toughness and training partner selection: research on mental toughness development in endurance sport (Gucciardi & Gordon) identifies training partner selection as a significant mental toughness determinant. Partners who simultaneously support and challenge — who celebrate effort while also maintaining high standards — produce greater mental toughness development than either purely supportive (social running) or purely challenging (competitive running) partners. The 'tough love' dyad, when trust is established, produces the fastest psychological development."}
{"chunk_id": "sport_psychology_expand_0328", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Mageau & Vallerand 2003 J Sport Sci; Amorose & Horn 2000 J Sport Exerc Psychol", "text": "Running coach psychology: research on coaching effectiveness in amateur marathon contexts finds that the most predictive coaching behaviors are not technical (training plan design) but psychological: demonstrating genuine belief in the runner's capability, providing specific positive reinforcement (not generic encouragement), adapting communication style to the runner's emotional state, and maintaining consistent presence through difficult training periods. Technical expertise is necessary but insufficient — coaching relationships that satisfy autonomy, competence, and relatedness needs (SDT) produce superior athlete outcomes."}
{"chunk_id": "sport_psychology_expand_0329", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Carron et al. 2003; Loehr & Schwartz 2003 Power of Full Engagement", "text": "Work-life-training balance in recreational marathon running: research on time scarcity in recreational athletes finds that time constraints — not physical capacity or motivation — are the most commonly cited barrier to marathon training in working adults. A study of adult marathon entrants found 73% cited 'not enough time' as their primary training difficulty. Psychologically, time pressure creates decision points with higher dropout probability. Training plans that provide explicit '3-day/week minimum' protocols and work-travel contingency sessions reduce time-pressure-driven dropout."}
{"chunk_id": "sport_psychology_expand_0330", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Milkman et al. 2021 Nature; Hagger & Luszczynska 2014 Health Psychol", "text": "Time-blocking for marathon training: research on habit formation and scheduling in health behavior change confirms that training sessions scheduled at a specific time on a specific day show dramatically higher completion rates than 'fit it in when possible' approaches. Research by Milkman et al. (2021, Nature) specifically found that scheduling gym workouts in calendar blocks improved attendance by 22% compared to intention-only control conditions. The scheduling act itself creates psychological pre-commitment that resists last-minute dropout."}
{"chunk_id": "sport_psychology_expand_0331", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Kenttä & Hassmén 1998 Eur J Sport Sci; Kellmann 2010", "text": "Recovery and rest as essential psychological practice: cultural pressure in runner communities often stigmatizes rest as laziness or inadequacy. Research on overtraining psychology (Kenttä & Hassmén 1998) found that athletes who frame recovery as 'active training choice' rather than 'unavoidable necessity' show higher compliance with prescribed rest and better training outcomes. Psychoeducation that explicitly reframes rest — 'today's recovery is where yesterday's training becomes fitness' — changes the emotional valence of rest from avoidant to appetitive."}
{"chunk_id": "sport_psychology_expand_0332", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Gauthier & Bherer 2012; practitioner synthesis", "text": "Managing marathon training around parenthood: research on exercise adherence in parents of young children finds that the primary barrier is not time (total discretionary time is objectively reduced) but psychological permission — parents experience significant guilt about time away from children for training. Running communities and marathon programs that explicitly normalize parental running ('running makes you a better parent through mood, health, and modeling'), provide childcare-compatible session formats (running groups meeting during school hours, stroller-friendly long runs), and address guilt directly show significantly higher parental runner retention."}
{"chunk_id": "sport_psychology_expand_0333", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Stults-Kolehmainen & Sinha 2014 Sports Med; practitioner synthesis", "text": "Managing training during high-stress work periods: research on exercise behavior under stress finds a paradox: psychological stress increases the benefit of exercise but simultaneously reduces the likelihood of exercise. Runners in high-stress work periods need explicitly simpler training structures — a 'stress week protocol' of reduced volume but maintained frequency preserves the mood regulation benefit while reducing the planning and time overhead. The psychological goal in high-stress periods is maintaining the identity habit ('I am someone who runs even in hard weeks') rather than maintaining training load."}
{"chunk_id": "sport_psychology_expand_0334", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Fuss et al. 2015 PNAS; Dietrich & McDaniel 2004 Br J Sports Med", "text": "The runner's high and endocannabinoid system: the subjective experience of running euphoria — traditionally attributed to endorphins — is now understood to be primarily mediated by endocannabinoids, particularly anandamide. Research by Fuss et al. (2015, PNAS) found that blocking endocannabinoid receptors abolished running-induced euphoria while beta-endorphin blockade did not, definitively resolving a decades-long debate. Anandamide crosses the blood-brain barrier readily (endorphins cannot), making it the neurochemically plausible explanation for the mood elevation associated with sustained moderate-intensity running."}
{"chunk_id": "sport_psychology_expand_0335", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Berridge & Kringelbach 2015 Neuron; Salamone & Correa 2012 Neuron", "text": "Dopamine system and marathon motivation: dopamine drives the anticipatory motivation for running ('wanting') more than the in-run pleasure ('liking'). Research on dopaminergic reward prediction shows that approaching a challenging goal activates striatal dopamine, creating the motivational drive to continue training. The anticipation of race day, of a personal best, or of completing a milestone long run creates dopaminergic motivation that sustains the decision to train. When dopaminergic anticipation is removed (no upcoming race, no goal), training motivation collapses even when past enjoyment has been high."}
{"chunk_id": "sport_psychology_expand_0336", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Young 2007 J Psychiatry Neurosci; Chaouloff 1997 Med Sci Sports Exerc", "text": "Serotonin and the long run: sustained aerobic exercise at moderate intensity (easy-to-comfortable effort) produces sustained serotonin release that persists for several hours post-run. Serotonin is the primary mood-stabilizing neurotransmitter and mediates the 'afterglow' of long training runs — the calm, clear, positive mood state that characterizes the hours after a long run rather than during it. This serotonergic mechanism explains why the psychological benefits of running are strongest on long run days and why 'runner's afterglow' is more reliable than acute running euphoria."}
{"chunk_id": "sport_psychology_expand_0337", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Sapolsky 2004 Why Zebras Don't Get Ulcers; Kreher & Schwartz 2012 Sports Health", "text": "Cortisol and overtraining neuropsychology: excess training without adequate recovery produces chronically elevated cortisol, which directly suppresses hippocampal neurogenesis, reduces serotonin synthesis, and impairs prefrontal cortex function. The result is a self-reinforcing cycle: overtraining reduces cognitive and emotional regulation capacity, which impairs the athlete's ability to recognize and respond to overtraining signals. Monitoring subjective mood through a brief validated scale (POMS or RMSSD check-in) provides an early neuropsychological signal before objective performance decline."}
{"chunk_id": "sport_psychology_expand_0338", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Ericsson 1993; Sunde et al. 2010 J Strength Cond Res", "text": "Neuroplasticity and running skill: running economy — the neuromuscular efficiency of the running stride — improves through the same experience-dependent plasticity mechanisms that underlie motor learning. Research on motor skill acquisition confirms that 1,000+ hours of running (approximately 3–4 years of consistent training) produce measurable neuromotor optimization: stride efficiency, cadence automaticity, and terrain responsiveness become largely automatic. This neuromotor improvement underlies the subjective experience that 'running gets easier' for experienced runners even at the same physical fitness level."}
{"chunk_id": "sport_psychology_expand_0339", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Reddish et al. 2013 PLOS ONE; Cohen et al. 2010 Exp Brain Res", "text": "Mirror neurons and group run psychology: neuroscience of social motor synchrony demonstrates that running alongside others at matched cadence activates mirror neuron circuits, creating a sense of 'shared effort' that reduces perceived exertion compared to solo running at the same pace. Research on synchronized group physical activity (Reddish et al. 2013, PLOS ONE) found synchronous movement increased pain tolerance by 30% compared to asynchronous conditions — a direct relevance to the pain management benefits of pacemaker groups and running clubs in marathon training."}
{"chunk_id": "sport_psychology_expand_0340", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Millet et al. 2011 PLOS ONE; Freund et al. 2013 J Exp Biol", "text": "Ultra-endurance psychology relevant to late marathon stages: research on ultra-marathon runners provides insights directly applicable to marathon km 30–42, as both contexts involve extreme fatigue-induced psychological challenges. Research by Millet et al. (2011) and Freund et al. (2013) on ultra-marathon cognition found that after prolonged exercise (>6 hours), executive function declines measurably — relevant to marathon runners who take over 5 hours. For slow marathon runners, late-race psychological strategies should account for genuine cognitive fatigue affecting decision quality."}
{"chunk_id": "sport_psychology_expand_0341", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Schomer 1990 Percept Mot Skills; Masters & Lambert 1989 J Sport Exerc Psychol", "text": "Dissociation and association at ultra-distances: research by Schomer (1990) and Masters & Lambert (1989) on attentional strategies in ultra-endurance events found that the most successful ultra-runners flexibly switch between association (monitoring body signals) and dissociation (distracting from discomfort) based on situation — using association when precise pacing judgment is critical, dissociation when pain management dominates. This flexibility finding is increasingly being applied to marathon coaching: rigid strategy adherence is less adaptive than context-sensitive attentional switching."}
{"chunk_id": "sport_psychology_expand_0342", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Inzlicht & Schmeichel 2012 Curr Dir Psychol Sci; Buman et al. 2008", "text": "Psychological coping at the 35–40 km wall: the final marathon wall experience, if severe, creates a psychological state of 'active self-regulation depletion' — the runner's capacity to deliberately override discomfort is exhausted. Research by Inzlicht & Schmeichel (2012) on ego depletion in sport suggests that this state is partially recoverable within 3–5 minutes of slowing pace or walking, as brief recovery restores prefrontal regulatory capacity. At the hardest km of a marathon, a planned 2-minute tactical walk is psychologically rational when it prevents complete decompensation."}
{"chunk_id": "sport_psychology_expand_0343", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Holtzhausen & Noakes 1997 Med Sci Sports Exerc; Noakes 2012 Sports Med", "text": "Hallucination and dissociation risk at marathon extremes: in extreme heat, late ultra-distance events, or severe hypoglycemia at marathon distances, runners may experience mild perceptual distortions (vivid imagery, sensory anomalies, time distortion). These are documented in case studies and represent neurological stress responses, not psychopathology. For marathon assistant systems, any report of visual disturbances, extreme confusion, or disorientation during a marathon race should trigger explicit referral for medical assessment — these are symptoms of heat illness, hyponatremia, or hypoglycemia."}
{"chunk_id": "sport_psychology_expand_0344", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Bernier et al. 2009 J Applied Sport Psychol; Schwanhausser 2009", "text": "MBSR (Mindfulness-Based Stress Reduction) in sport contexts: the full 8-week MBSR protocol, originally designed for chronic pain patients by Jon Kabat-Zinn, has been adapted and studied in athlete populations. Research by Bernier et al. (2009) with elite golfers and Schwanhausser (2009) with competitive swimmers found MBSR-adapted protocols produced improvements in flow frequency, reduced competitive anxiety, and improved concentration under pressure. For marathon runners, abbreviated MBSR practices (particularly the body scan and breath awareness components) are the most directly applicable elements."}
{"chunk_id": "sport_psychology_expand_0345", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Zeidan et al. 2011 J Neurosci; Garland et al. 2014 JAMA Int Med", "text": "Mindfulness and pain tolerance in running: research by Zeidan et al. (2011, J Neurosci) found that brief mindfulness training (four 20-minute sessions) reduced pain intensity ratings by 40% and pain unpleasantness by 57% compared to control conditions, mediated by increased activity in the orbitofrontal cortex (which modulates pain meaning rather than pain sensation). This finding directly supports mindfulness training as a marathon pain management strategy: it doesn't reduce pain signals but changes the psychological relationship to those signals."}
{"chunk_id": "sport_psychology_expand_0346", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Hutcherson et al. 2008 Psychol Sci; Kok et al. 2013 Psychol Sci", "text": "Loving-kindness meditation and running community: loving-kindness (metta) meditation — directing well-wishes toward oneself, loved ones, and eventually all beings — is the mindfulness practice most strongly associated with social connection and reduced loneliness. For marathon runners who find community belonging a central motivation, loving-kindness practice during easy runs (directing well-wishes to training partners, fellow runners on the course, spectators) produces stronger social bonding and reduces competitive negativity. Research by Hutcherson et al. (2008) found even a brief 7-minute loving-kindness practice increased feelings of social connection."}
{"chunk_id": "sport_psychology_expand_0347", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Lutz et al. 2008 Trends Cogn Sci; Jha et al. 2010 Emotion", "text": "Open monitoring meditation vs. focused attention meditation for runners: sport psychology research distinguishes between (1) focused attention (FA) meditation — maintaining attention on one object (breath, mantra) and redirecting when distracted — and (2) open monitoring (OM) meditation — broadly aware of whatever arises in consciousness without attachment. FA meditation produces stronger attention control and is more useful for managing distraction during races. OM meditation produces stronger interoceptive awareness and is more useful for body-signal monitoring in training. Experienced meditating runners benefit from both forms practiced on alternate days."}
{"chunk_id": "sport_psychology_expand_0348", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner synthesis; Birrer & Morgan 2010", "text": "Mindfulness during interval training: interval training sessions — characterized by alternating high-intensity effort and recovery — are psychologically demanding because each interval represents a complete psychological arc from 'approaching the start' to 'surviving the effort' to 'recovering.' Mindfulness practice during intervals involves deliberately attentional to the different qualities of each phase: the anticipatory phase (pre-interval), the effort phase (monitoring form and effort), and the recovery phase (observing the shift from high to low intensity). This structured attention prevents the mental drift that reduces interval training effectiveness."}
{"chunk_id": "sport_psychology_expand_0349", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Vealey 1994 Sport Psychol; Weinberg & Williams 2001", "text": "Base building phase psychology (weeks 1–8): the primary psychological challenges in base building are establishing the habit (converting intention to automatic behavior), managing initial soreness and discomfort without catastrophizing, and building patience with slow progress. The primary psychological skills to develop in this phase are: (1) basic relaxation and centering (5-minute breath routine); (2) process-goal orientation (measuring completion, not pace); (3) self-compassion (normalizing imperfect sessions); (4) identity reinforcement (training log, community participation). No race-specific psychological skills are needed in this phase."}
{"chunk_id": "sport_psychology_expand_0350", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Vealey 1994; Taylor & Wilson 2005 Applying Sport Psychol", "text": "Build phase psychology (weeks 8–16): as training intensity and volume increase, psychological skill development shifts to: (1) specific goal-setting refinement (A/B/C race goals based on emerging fitness data); (2) imagery rehearsal introduction (short 5-minute race segments); (3) race-simulation psychological training (tempo runs with race-day mantras); (4) pre-performance routine establishment; (5) managing training fatigue without catastrophizing. This is when self-talk training becomes most valuable — the runner begins to encounter genuinely hard sessions that require deliberate psychological management."}
{"chunk_id": "sport_psychology_expand_0351", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Taylor & Wilson 2005; Jackson & Csikszentmihalyi 1999", "text": "Peak and taper phase psychology (weeks 16–20): psychological skills refinement and race preparation dominate. Key activities: (1) full mental race simulation (complete race in imagery); (2) confidence-building training data review; (3) race focus plan completion; (4) anticipatory anxiety management; (5) taper management education; (6) race-day logistics planning. The athlete should enter race week with all psychological tools established and rehearsed, ready to execute rather than still developing new skills."}
{"chunk_id": "sport_psychology_expand_0352", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Taylor & Wilson 2005; practitioner synthesis", "text": "Post-race psychological skill development: a structured post-race debrief 48–72 hours after race completion generates the most valuable psychological learning of the entire training cycle. Key questions: (1) What worked psychologically that I planned? (2) What psychological challenge arose that I hadn't anticipated? (3) What is the one thing I would change about my mental preparation? (4) What was my strongest psychological moment in the race? (5) What does this race tell me about my psychological readiness for my next goal? This debrief becomes the foundation of the next training cycle's psychological preparation."}
{"chunk_id": "sport_psychology_expand_0353", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Vealey 1988 J Sport Exerc Psychol; Ericsson et al. 1993 Psychol Rev", "text": "Psychological skill transfer across training cycles: research on psychological skill learning in sport confirms that skills developed across a training cycle are retained between seasons, similar to physiological adaptations. A runner who has practiced pre-race imagery for a first marathon enters their second marathon training with that skill available, requiring maintenance rather than fresh development. This compounding of psychological skills across training cycles is a key reason experienced marathoners show better race-day psychological management than beginners at equivalent fitness."}
{"chunk_id": "sport_psychology_expand_0354", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Masters & Ogles 1995 J Sport Behav; Buman et al. 2008", "text": "Existential dimensions of marathon running: philosophical and psychological research on the 'meaning of running' identifies the marathon as one of the most accessible 'existential challenges' in modern recreational culture — a context in which ordinary people voluntarily confront their physical limits, face failure and success in a pure form, and experience what they are made of when conditions are hardest. Research by Masters & Ogles (2007) found that 'seeking the adventure of testing the self' was among the top five motivation categories for recreational marathon runners across cultural contexts."}
{"chunk_id": "sport_psychology_expand_0355", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Seligman 2011 Flourish; Deci & Ryan 2008 Psychol Inquiry", "text": "Meaning-making through marathon training difficulty: research on post-traumatic growth and eudaimonic wellbeing identifies voluntary challenge with personal significance as a uniquely powerful meaning-making mechanism. The marathon's combination of significant physical challenge, clear preparation investment, and defined outcome creates what researchers describe as 'compressed eudaimonia' — the experience of growth, vitality, and purpose concentrated in a finite activity. This explains the common testimony that marathon participation was 'one of the most meaningful things I've done' even among runners who achieved modest finishing times."}
{"chunk_id": "sport_psychology_expand_0356", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Filo et al. 2012 J Sport Manag; Frankl 1985 Man's Search for Meaning", "text": "Legacy running — running for those who cannot: a growing phenomenon in marathon communities involves runners dedicating their race to a deceased loved one, an ill family member, or a cause larger than personal achievement. Research on meaning-enhancement interventions in endurance sport finds that 'dedication running' significantly increases late-race pain tolerance and reduces dropout probability. The mechanism is meaning-activation: when personal suffering is reframed as service or tribute, the psychological cost of continued effort is reduced relative to the perceived purpose."}
{"chunk_id": "sport_psychology_expand_0357", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Privette 1981 Percept Mot Skills; Maslow 1968 Toward a Psychology of Being", "text": "Transcendence experiences in long-distance running: qualitative research on peak experiences in marathon running consistently documents moments of transcendence — brief periods of seemingly effortless motion, profound clarity, and sense of unity with the environment. These experiences overlap with philosophical descriptions of 'flow' but extend to explicitly transpersonal dimensions (loss of self-other boundary, timelessness, profound felt meaning). Research by Privette (1981) identified marathon racing as among the most frequent contexts for peak experience among recreational athletes."}
{"chunk_id": "sport_psychology_expand_0358", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Greenberg et al. 1986 J Pers Soc Psychol; Solomon et al. 1991", "text": "Running and mortality resilience: existential psychology research documents that confronting physical limits in sport — reaching genuine exhaustion in a marathon, experiencing the body's fragility — paradoxically reduces fear of death in some runners and produces stronger engagement with life. The mechanism aligns with Terror Management Theory: symbolic victory over physical limitation provides evidence of capability and agency that partially offsets mortality anxiety. This 'mortality resilience' function of marathon running is more explicit in older runners but present across age cohorts."}
{"chunk_id": "sport_psychology_expand_0359", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Linardon et al. 2020 Psychol Med; Firth et al. 2017 World Psychiatry", "text": "AI-assisted sport psychology in marathon coaching: emerging research on AI systems in athletic performance support identifies several roles where AI tools demonstrate advantage over human coaches: (1) consistent availability for psychological support across training hours; (2) non-judgmental processing of psychological self-report data; (3) pattern recognition across mood, training load, and performance data to identify early distress signals; (4) personalized delivery of evidence-based psychological techniques matched to self-reported state. Research on digital mental health interventions (iCBT, mental health apps) demonstrates that AI-delivered interventions can achieve 60–80% of the effect sizes of therapist-delivered interventions for anxiety and mood applications."}
{"chunk_id": "sport_psychology_expand_0360", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "clinical_practice_guideline", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Torous et al. 2018 JMIR Ment Health; ethical guidelines for digital health", "text": "Boundaries of AI psychological support in sport: research on digital mental health tool limitations identifies key areas where AI assistance is insufficient and human referral is required: (1) suicidal or self-harm ideation; (2) clinical depression or anxiety disorders; (3) eating disorder presentations; (4) substance use or addiction; (5) trauma or grief requiring clinical processing; (6) relationship crises requiring systemic intervention. An AI marathon coaching system that detects these signals should provide empathic acknowledgment, validation of the experience, and explicit professional referral with specific resources rather than attempting to address these clinically complex presentations."}
{"chunk_id": "sport_psychology_expand_0361", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "clinical_practice_guideline", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "WHO 2021 guidance on AI in digital health; Luxton 2014 Psychol Services", "text": "Ethical principles for AI-delivered psychological support in running: research on responsible AI in mental health contexts identifies five core principles: (1) do no harm — avoid interventions that could worsen psychological state; (2) user autonomy — support rather than direct decision-making; (3) data privacy — treat self-reported psychological information with highest confidentiality; (4) transparency about limitations — be clear about what AI can and cannot provide; (5) professional referral readiness — always have a referral pathway available. Marathon AI systems that apply these principles produce significantly higher user trust and safety outcomes."}
{"chunk_id": "sport_psychology_expand_0362", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Kellmann 2010 Eur J Sport Sci; Hooper et al. 1995 Med Sci Sports Exerc", "text": "Monitoring psychological readiness in a marathon assistant system: evidence-based psychological monitoring for marathon training uses validated brief measures administered regularly: (1) POMS-Brief (5 items) for mood state; (2) RESTQ-Sport (12 items) for recovery-stress balance; (3) single-item subjective wellbeing; (4) sleep quality (1–5 rating); (5) training motivation (1–5 rating). Research confirms that even a single-item daily wellbeing question significantly outperforms no monitoring in detecting early overtraining and burnout risk. Integration of these prompts into a training log system creates an early warning system for psychological risk."}
{"chunk_id": "sport_psychology_expand_0363", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Buman et al. 2009; Mann et al. 2014 Soc Psychol Pers Sci; Michie et al. 2011", "text": "Psychologically informed training plan design: evidence-based training plan design for recreational marathoners incorporates psychological principles alongside physiological ones. Research on behavioral adherence in training programs confirms that plans designed with psychological architecture — milestone celebrations every 4 weeks, built-in flexibility days, explicit permission for modification, social integration points, and periodic review check-ins — achieve 30–45% higher completion rates than physiologically optimized but psychologically naive plans. A marathon assistant system should default to psychologically informed plan design."}
{"chunk_id": "sport_psychology_expand_0364", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner synthesis; Smith et al. 2010 J Strength Cond Res", "text": "Interval training anxiety: research on psychological responses to structured speed work in recreational runners finds that 'interval anxiety' — apprehension about performance in interval sessions — is one of the most common barriers to high-intensity training adherence in amateur athletes. The anxiety has multiple components: fear of not completing all repetitions, social embarrassment at slow relative performance, and uncertainty about target pace. Evidence-based responses include: setting target ranges rather than fixed paces, normalizing mid-set pace variation, and explicitly reframing incomplete sets as appropriate training rather than failure."}
{"chunk_id": "sport_psychology_expand_0365", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner synthesis; Ekkekakis et al. 2011 Exerc Sport Sci Rev", "text": "Mental demands of tempo running: tempo runs at lactate threshold pace (a sustainable but genuinely uncomfortable effort, approximately 7–8 RPE) require sustained attention to effort regulation over 20–40 minutes without external pace setting. Research on self-regulation in sustained effort tasks finds that tempo runs are psychologically more demanding than either easy runs (no regulatory effort) or intervals (short high-effort bursts). Successful tempo runners use specific attentional strategies: short-segment mental chunking ('10 more minutes, then reassess'), process-focus cues ('smooth', 'tall', 'relaxed'), and deliberate RPE check-ins every 5 minutes."}
{"chunk_id": "sport_psychology_expand_0366", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Baker et al. 2011 J Strength Cond Res; practitioner synthesis", "text": "Psychological impact of speed development in older runners: masters runners often report significant psychological barriers to adding speed work due to injury fear and realistic concerns about recovery. Research on masters training adaptation (Baker et al. 2011) finds that masters runners who include structured speed work (even minimal — 2×8 minutes per week) maintain race pace capacity significantly better than those who train exclusively at easy effort. The psychological barrier to speed work in masters runners requires specific attention — injury fear normalization and evidence that appropriate speed work prevents rather than causes injury."}
{"chunk_id": "sport_psychology_expand_0367", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Ericsson 1993 Psychol Rev; practitioner synthesis", "text": "The value of failed intervals: research on learning from failure in athletic skill development confirms that interval sessions where some repetitions are not completed to target provide more information about current fitness than sessions where all are completed easily. Failed repetitions indicate training is producing appropriate stress; the psychological framing of 'I completed 3 of 5 reps and learned my current limit' rather than 'I failed the session' preserves motivation and provides data for future planning."}
{"chunk_id": "sport_psychology_expand_0368", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner synthesis; Cotterill et al. 2010 Psychol Sport Exerc", "text": "Pre-race meal anxiety and rituals: research on pre-performance routines in endurance sports finds that food choice before key training and racing is strongly ritualized in experienced runners, and that anxiety about pre-race nutrition is common in beginners. The psychological function of pre-race food rituals is not nutritional optimization but anxiety reduction — familiar foods eaten at familiar times create a consistency anchor in an otherwise variable pre-race environment. Research confirms that the psychological comfort of familiar pre-race nutrition outweighs the marginal physiological differences between closely similar nutritional choices."}
{"chunk_id": "sport_psychology_expand_0369", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Pfeiffer et al. 2012 Med Sci Sports Exerc; practitioner synthesis", "text": "Mid-race fueling compliance as a psychological skill: research on carbohydrate intake adherence during marathon races finds that fueling compliance — actually consuming planned carbohydrates at planned intervals — is only approximately 60% in recreational marathoners despite explicit fueling plans. The primary barriers are psychological: forgetting under cognitive fatigue, aversion to the sensory experience of gels when already experiencing GI discomfort, and reluctance to slow or stop for drink stations. Pre-race fueling rehearsal in long runs builds automated fueling behavior that is more resistant to mid-race cognitive fatigue breakdown."}
{"chunk_id": "sport_psychology_expand_0370", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Burke et al. 2011 J Sports Sci; practitioner synthesis", "text": "Carbohydrate loading psychology: the psychological aspects of carbohydrate loading (consuming 8–12g CHO/kg body weight in the 24–48 hours before a marathon) include body image concerns about bloating and temporary weight gain (1–2 kg of glycogen-bound water), GI anxiety, and disruption of established eating patterns. Psychoeducation about these expected sensations — normalizing bloating, water retention, and increased urination as signs that loading is working — reduces carbohydrate loading anxiety and improves compliance with this evidence-based strategy."}
{"chunk_id": "sport_psychology_expand_0371", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Grgic et al. 2020 Br J Sports Med; Spriet 2014 Sports Med", "text": "Race day caffeine and anxiety interaction: caffeine is the most empirically supported ergogenic aid in endurance sport, with meta-analytic effect sizes of approximately 3.3% for endurance performance. However, caffeine also amplifies anxiety and can exacerbate pre-race anxiety symptoms in high-anxiety runners. Research indicates that habitual caffeine users (≥200mg/day) experience smaller anxiogenic effects; caffeine-naive runners taking caffeine before their first race may experience significant anxiety amplification that negates performance benefits. Pre-race caffeine protocols should be practiced in training before race-day use."}
{"chunk_id": "sport_psychology_expand_0372", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Maughan et al. 2018 Br J Sports Med IOC statement; Braun et al. 2009", "text": "Nutritional supplement decision anxiety: recreational marathon runners are exposed to significant marketing pressure for nutritional supplements. Research on supplement use decision-making in athletes finds that supplement choices are driven primarily by social influence (training partners' recommendations, ambassador endorsements) rather than evidence evaluation, and that supplement use creates performance expectation anchoring — believing a supplement will work makes it more likely to appear to work (placebo effect). A marathon coaching system should address supplement questions with evidence-based responses that distinguish strong evidence (caffeine, creatine loading caveat, sodium bicarbonate) from weak evidence, without dismissing the psychological function of rituals."}
{"chunk_id": "sport_psychology_expand_0373", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Nieman 1994 J Sports Med Phys Fitness; Dantzer et al. 2008 Nat Rev Neurosci", "text": "Immune window and psychological vulnerability post-marathon: research documents a 2-week immune suppression window following marathon completion (the 'open window' theory). During this period, runners also show heightened psychological vulnerability — increased irritability, reduced stress tolerance, and susceptibility to depressive mood. Research connecting immune markers to mood (cytokine-mood interaction) suggests the psychological vulnerability has neurobiological basis in post-marathon inflammatory cytokine elevation, which directly affects CNS mood regulation."}
{"chunk_id": "sport_psychology_expand_0374", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Lippi et al. 2014 Semin Thromb Hemost; practitioner synthesis", "text": "Return-to-running psychology after marathon: research on post-marathon recovery trajectories finds most runners feel psychologically ready to run again significantly before they are physiologically recovered. This creates the psychologically challenging prescription of 'rest when you feel like running.' Effective communication reframes this: 'The running you feel like doing now is the reward for the running you've already done — letting the body consolidate what training has built produces a better outcome than premature training resumption.'"}
{"chunk_id": "sport_psychology_expand_0375", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner synthesis; Lane & Wilson 2011", "text": "The 2-week post-marathon celebration window: research on reward timing in behavior change finds that celebrating achievements close in time to the achievement produces stronger motivational impact than delayed celebrations. A structured post-marathon celebration plan — a special dinner at 24–48 hours, a rest week 'staycation' in week 1, a social event with running community at week 2 — addresses post-marathon blues while creating psychological positive anchors for the race as a life milestone. Planning celebrations before the race ensures they happen even when post-race mood is low."}
{"chunk_id": "sport_psychology_expand_0376", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "McAdams 2006 Redemptive Self; Tamminen & Holt 2012 Psychol Sport Exerc", "text": "Narrative construction after a marathon: qualitative research on marathon runner experience finds that how runners construct the narrative of their race — the story they tell themselves and others about what happened — significantly determines long-term motivation and identity. Runners who construct 'growth narratives' ('this race taught me what I need to do next') show better subsequent training engagement than those who construct 'failure narratives' ('that race proved I'm not capable'). Coaching runners toward growth narrative construction in the 48–72 hours post-race is an important and undervalued psychological intervention."}
{"chunk_id": "sport_psychology_expand_0377", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Miller & Rollnick 2013 Motivational Interviewing; Resnicow et al. 2002 Health Educ Res", "text": "Motivational interviewing (MI) principles in marathon coaching: MI, originally developed by Miller & Rollnick for substance use treatment, is the most evidence-supported brief intervention for behavior change across health domains. MI's core principles — expressing empathy, developing discrepancy (between current behavior and stated values), rolling with resistance, and supporting self-efficacy — map directly onto marathon coaching challenges. Research on MI in exercise counseling contexts (Resnicow et al. 2002) shows MI-consistent coaching conversations increase exercise adherence compared to directive advice-giving."}
{"chunk_id": "sport_psychology_expand_0378", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Miller & Rollnick 2013; Oyserman et al. 2012 J Exp Psychol Gen", "text": "Developing discrepancy in marathon motivation: a key MI principle is helping the person articulate the discrepancy between their current behavior (training inconsistently, skipping hard sessions) and their stated values or goals (wanting to finish a marathon, valuing health, demonstrating persistence to their children). Research on values-based motivation interventions confirms that explicitly connecting daily training behavior to personally meaningful values produces stronger adherence than performance-outcome-based motivation alone. Questions like 'what does completing this marathon mean about who you are?' activate values-discrepancy more effectively than 'what time do you want to run?'"}
{"chunk_id": "sport_psychology_expand_0379", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Miller & Rollnick 2013; Hagen & Peterson 2014", "text": "Open questions in marathon psychological coaching: evidence-based psychological support conversations for marathon runners predominantly use open questions — questions that cannot be answered with yes/no and that invite elaboration on the runner's experience. Research on question type in coaching conversations confirms that open questions activate reflective processing and value-articulation that directive questions do not. Examples: 'What feels most challenging about this training period?' 'What does a really good training day feel like for you?' 'What would make next week's long run feel like a success?'"}
{"chunk_id": "sport_psychology_expand_0380", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Miller & Rollnick 2013; Henderlong & Lepper 2002 Psychol Bull", "text": "Affirmations as psychological support tools: MI uses specific affirmations — statements that recognize the runner's strengths, efforts, and qualities rather than just praising outcomes — to build self-efficacy and reduce shame. Research confirms that strength-based affirmations ('that was hard and you kept going — that's exactly the persistence that builds marathon fitness') are more psychologically effective than outcome praise ('good job on the time') because they reinforce identity rather than performance. Marathon assistant systems should default to strength and effort affirmation rather than outcome evaluation."}
{"chunk_id": "sport_psychology_expand_0381", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Norcross & Lambert 2011 Psychotherapy Relationships; Miller & Rollnick 2013", "text": "Reflective listening in marathon coaching conversations: MI's reflective listening technique — restating or paraphrasing what the runner has shared to demonstrate understanding and invite elaboration — produces significant alliance and adherence effects even in brief interactions. Research on therapeutic alliance in coaching contexts finds that feeling genuinely understood (not just heard) is the single strongest predictor of continued engagement with a coaching system or coach. For AI-based marathon coaching, response structures that begin by reflecting the runner's expressed experience before offering guidance demonstrate this principle."}
{"chunk_id": "sport_psychology_expand_0382", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Mujika & Padilla 2001 Med Sci Sports Exerc; Ericsson 1996", "text": "The performance plateau in marathon training: research on training adaptation curves shows that most recreational runners experience fitness plateaus after 12–18 months of consistent training, when the largest adaptation responses (baseline cardiovascular and structural adaptations) are complete and further improvement requires progressively harder stimuli. Psychologically, the plateau is experienced as 'the same effort for the same result' and is a primary dropout driver for runners who frame progress only in pace improvement terms. Reframing progress to include running economy, injury resistance, consistency metrics, and effort comfort at fixed paces reveals that improvement is ongoing even when pace plateaus."}
{"chunk_id": "sport_psychology_expand_0383", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Tenenbaum 2003; Mujika & Padilla 2001", "text": "Breaking a training plateau: research on overcoming performance plateaus in endurance sport identifies three primary interventions: (1) structural periodization change — introducing a phase the training program hasn't included (altitude, strength emphasis, ultra-long runs, race simulation); (2) recovery intervention — identifying that the plateau is fatigue-driven and inserting an extended recovery block; (3) motivational reset — a new race distance, terrain, or competitive context that creates fresh challenge-skill balance and re-activates flow and flow-approach motivation."}
{"chunk_id": "sport_psychology_expand_0384", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Kahneman & Tversky 1979 Econometrica (loss aversion); practitioner synthesis", "text": "Pace-goal comparison and plateau frustration: runners tracking training paces on GPS devices in contexts where improvement has stalled may experience significant demotivation from comparing current pace to training log entries from months prior. Research on reference point effects predicts this comparison produces loss aversion — the emotional impact of 'my pace regressed' is approximately twice as strong as the equivalent gain. Practical response: vary the comparison metrics used during plateaus — use effort-control (RPE at given pace), consistency (training days completed), or race performance rather than training pace as the primary progress indicator."}
{"chunk_id": "sport_psychology_expand_0385", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Ericsson 1993 Psychol Rev; Mujika & Padilla 2001", "text": "The value of 'boring' consistency: research on long-term athletic development consistently identifies that the most predictive factor of long-term marathon improvement is training consistency over years, not the sophistication of individual training sessions. The psychological challenge is that consistency — running the same easy miles month after month — is experientially unremarkable and generates none of the motivational reinforcement that dramatic training changes do. Cultivating appreciation for consistency requires a specific psychological frame: 'boring consistency is the product I'm creating every session; the race is just the quality check.'"}
{"chunk_id": "sport_psychology_expand_0386", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Edmondson 1999 Adm Sci Q; Clark 2020 4 Stages of Psychological Safety", "text": "Psychological safety in running groups: research by Edmondson (1999) defined psychological safety as 'the belief that one will not be punished or humiliated for speaking up with ideas, questions, concerns, or mistakes.' Applied to running groups, psychological safety determines whether members: (1) share when they are struggling; (2) ask for pace adjustments without shame; (3) disclose injury symptoms without fear of social consequence; (4) set goals that feel genuinely achievable rather than socially expected. Running groups with high psychological safety show significantly better injury disclosure rates and lower overtraining incidence."}
{"chunk_id": "sport_psychology_expand_0387", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Pennebaker 1997 Opening Up; practitioner synthesis", "text": "Toxic positivity in running communities: 'toxic positivity' — the cultural norm of only sharing positive experiences and dismissing or minimizing struggles — is documented in running community research and produces psychological harm. Research on social sharing and emotion regulation shows that being unable to share genuine struggles within a community increases suppression of negative emotion, which paradoxically amplifies those emotions. Running communities that explicitly normalize struggle ('this training cycle is hard — who's finding the long run brutal this week?') produce better member wellbeing and retention than those that project relentless positivity."}
{"chunk_id": "sport_psychology_expand_0388", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Shipway & Holloway 2010; Dawson 2013 J Leis Res", "text": "Pace inclusivity and drop-out rates in running clubs: research on running club retention finds that clubs with clear multi-pace structures (where slower runners are explicitly welcomed, organized, and celebrated rather than merely tolerated) show dramatically lower dropout rates among new members. The psychological mechanism is identity threat reduction: a runner who fears being the slowest in a group must choose between performance anxiety (running too fast to avoid embarrassment) and shame (acknowledging slower pace). Multi-pace structures eliminate this forced choice."}
{"chunk_id": "sport_psychology_expand_0389", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Dashper 2015 Sociol Sport J; Shipway 2012", "text": "Gender inclusivity in running communities: research on women's barriers to running club participation finds that club culture — particularly male-dominated clubs where pacing norms, conversation topics, and leadership are implicitly male-centered — creates psychological barriers that explain the underrepresentation of women in club environments relative to their participation in mass-market running events. Women-specific running groups (research by Dashper 2015 and Shipway 2012) show significantly higher psychological safety ratings and community belonging scores than mixed-gender clubs of equivalent size."}
{"chunk_id": "sport_psychology_expand_0390", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Martens et al. 1990 Competitive Anxiety in Sport; Burton 1988 J Sport Exerc Psychol", "text": "Competitive state anxiety inventory-2 (CSAI-2): Martens et al.'s (1990) multidimensional anxiety measure distinguishes cognitive anxiety (worry) from somatic anxiety (physical arousal) and self-confidence. Research applying CSAI-2 to marathon runners finds that cognitive anxiety is more predictive of performance impairment than somatic anxiety, while self-confidence is the strongest positive performance predictor of the three components. Pre-race interventions are optimally targeted: use imagery and cognitive restructuring for cognitive anxiety, controlled breathing for somatic anxiety, and mastery experiences + evidence review for self-confidence."}
{"chunk_id": "sport_psychology_expand_0391", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Jones & Swain 1992 J Sport Sci; Hanton & Jones 1999 J Appl Sport Psychol", "text": "Facilitative vs. debilitative anxiety interpretation: Jones & Swain's (1992) research demonstrated that competitive anxiety can be interpreted as either facilitative ('this anxiety will help me perform') or debilitative ('this anxiety will hurt my performance'), and that this interpretation is more predictive of performance than the anxiety level itself. Runners with facilitative anxiety interpretation show performance equivalent to low-anxiety runners; those with debilitative interpretation show impaired performance. Anxiety reappraisal training — learning to interpret activation as excitement rather than threat — is a learnable, evidence-based skill."}
{"chunk_id": "sport_psychology_expand_0392", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Beilock & Carr 2001 J Exp Psychol; Masters et al. 2008 Int Rev Sport Exerc Psychol", "text": "Choking under pressure mechanisms: sports psychology research on choking (unexpected performance impairment under high-stakes conditions) identifies two mechanisms relevant to marathon running: (1) explicit monitoring — the runner re-directs conscious attention to automatic movements (stride, breathing, posture) that function best automatically, disrupting their execution; (2) distraction — anxiety consumes working memory resources needed for pacing judgment and race management. For marathon runners, the research-supported anti-choking strategy is a pre-established process focus ('execute the plan') rather than outcome focus ('this matters so much')."}
{"chunk_id": "sport_psychology_expand_0393", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Damisch et al. 2010 Psychol Sci; Womack 1992 J Sport Behav", "text": "Superstition, rituals, and irrational beliefs in running: research by Damisch et al. (2010, Psychol Sci) demonstrated that superstitious objects and rituals ('lucky socks', 'good luck' phrases) produced measurable performance improvements through the mechanism of elevated self-efficacy. Even objectively irrational rituals produce real performance effects when athletes believe in them. From an applied perspective, marathon runners' personal rituals — regardless of logical basis — should be respected rather than challenged, as their efficacy is partly based on the belief itself."}
{"chunk_id": "sport_psychology_expand_0394", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Moran 1996 The Psychology of Concentration in Sport; Wegner et al. 1987", "text": "Thought stopping techniques: thought stopping (deliberately interrupting negative thought patterns with a specific cue — a sharp internal 'stop!' or physical gesture) is a CBT-derived technique applied in sport contexts to interrupt rumination and negative self-talk cycles. Research on thought stopping in sport (Moran 1996) supports its effectiveness as a temporary interruption, effective when followed by a positive replacement thought. Criticism notes that suppression can rebound; the technique works best as part of a three-step sequence: stop → release → replace with prepared alternative."}
{"chunk_id": "sport_psychology_expand_0395", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Cumming et al. 2007 Psychol Sport Exerc; Côté & Fraser-Thomas 2007", "text": "Youth marathon participation psychology: research on youth distance running and motivation (Cumming et al. 2007; Côté et al.) strongly recommends a task/mastery motivational climate for young runners, specifically cautioning against early specialization in competitive distance running before age 14. Young runners who participate in multi-sport environments before specializing show lower burnout rates, higher enjoyment, and better long-term performance outcomes. Marathon events increasingly offer youth categories, but sport psychology guidelines recommend completion-focused, time-relaxed participation for runners under 18."}
{"chunk_id": "sport_psychology_expand_0396", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Knight & Holt 2014 Psychol Sport Exerc; Fraser-Thomas et al. 2008", "text": "Parental influence on youth running: research on parental involvement in youth sport psychology identifies the 'Goldilock zone' of parental support — enough to enable and encourage without creating performance pressure. Over-investment from parents (monitoring every split, imposing competitive goals, expressing disappointment at outcomes) is the primary psychosocial risk factor for youth sport burnout. A marathon system serving young runners should explicitly flag significant parental performance pressure as a welfare concern and recommend age-appropriate goal frameworks focused on completion and enjoyment."}
{"chunk_id": "sport_psychology_expand_0397", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Colcombe et al. 2006 J Gerontol; Hamer & Chida 2009 Psychol Med", "text": "Marathon running and age-related cognitive decline prevention: longitudinal research on aerobic fitness and cognitive aging finds that maintaining aerobic fitness (measured by VO2max) is one of the most robust protective factors against age-related cognitive decline, dementia, and Alzheimer's disease. Research by Colcombe et al. (2006, J Gerontol) found aerobic fitness training increased prefrontal and temporal cortex volume in adults aged 60–79 — regions typically lost with aging. For masters marathon runners, the cognitive preservation value of continued training is substantial and represents a motivational asset that coaches and systems can meaningfully communicate."}
{"chunk_id": "sport_psychology_expand_0398", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Ogles & Masters 2003; masters competition psychology review", "text": "Age-group competition psychology in amateur marathoners: research on recreational competitive athletes (Ogles & Masters 2003) identifies a distinct psychological profile for serious age-group competitors — runners who primarily train and race relative to age-group rankings rather than absolute performance. This profile shows higher intrinsic motivation, stronger identity, and better long-term adherence than pure participation-focused runners, but also higher competitive anxiety, stronger negative response to injury, and more pronounced burnout risk from poor race seasons. Age-group competitors benefit from motivational portfolio diversification — maintaining process goals alongside competitive goals."}
{"chunk_id": "sport_psychology_expand_0399", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Medvec et al. 1995 J Pers Soc Psychol; practitioner synthesis", "text": "Racing psychology for BQ (Boston Qualifying) runners: Boston Qualification creates a specific high-stakes competitive context for a significant segment of recreational marathoners. Research on 'almost' performance outcomes (Medvec et al. 1995) found that narrowly missing a defined goal produces stronger negative affect than missing by a large margin — 'so close' catastrophically amplifies disappointment. For BQ-targeting runners, psychological preparation specifically addresses: how to process a missed BQ (narrow margin versus physiological best day versus strategic error), what realistic re-attempt timelines look like, and maintaining perspective on the BQ as one meaningful goal within a larger running life."}
{"chunk_id": "sport_psychology_expand_0400", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Greenspan & Feltz 1989 Sport Psychol; Shapiro et al. 2007 Int J Behav Med", "text": "Progressive muscle relaxation protocol for pre-race sleep: a specific 15-minute PMR protocol adapted for marathon runners before sleep the night before a race: systematically tensing and releasing muscle groups from toes to face (each 5 seconds tension, 10 seconds release), followed by 5 minutes of slow diaphragmatic breathing. Research on PMR for sport performance sleep quality finds this protocol reduces pre-competition arousal, shortens sleep onset latency by an average of 8 minutes, and improves subjective sleep quality even when total sleep time is similar."}
{"chunk_id": "sport_psychology_expand_0401", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Paul et al. 2012 Appl Psychophysiol Biofeedback; Lehrer & Gevirtz 2014 Front Psychol", "text": "Heart rate variability biofeedback in marathon training: HRV biofeedback — using real-time HRV display to practice coherent breathing (typically at 0.1 Hz / 6 breaths per minute) — is a validated psychophysiological training tool that improves autonomic nervous system flexibility, anxiety regulation, and performance under pressure. Research by Paul et al. (2012) found that 5 weeks of HRV biofeedback significantly improved cognitive performance under pressure in competitive athletes compared to relaxation control. Marathon runners with significant pre-race anxiety may benefit specifically from this approach."}
{"chunk_id": "sport_psychology_expand_0402", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Morgan et al. 1987 Int J Sport Psychol; Terry et al. 1999 J Appl Sport Psychol", "text": "Mood monitoring in marathon training: brief validated mood assessment in training context. The POMS-Brief (Profile of Mood States abbreviated) measures tension, depression, anger, vigor, fatigue, and confusion in under 3 minutes. Research on mood monitoring in marathon training (Morgan et al. 1987) found that the 'iceberg profile' — high vigor, low scores on all negative dimensions — predicts optimal training adaptation, while profile inversions (high fatigue, depression; low vigor) predict overtraining and underperformance. Weekly POMS monitoring during peak training provides an early warning system for psychological overload."}
{"chunk_id": "sport_psychology_expand_0403", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Hooper et al. 1995 Med Sci Sports Exerc; Saw et al. 2016 Sports Med", "text": "Single-item psychological readiness assessments for daily use: research on ultra-brief psychological monitoring in athlete populations shows that single-item measures of key constructs (subjective wellbeing, motivation, energy, sleep quality) — each on a 1–10 scale — capture approximately 70% of the variance of their full-scale equivalents when aggregated across multiple days. For marathon coaching systems, daily 4-item micro-assessments (wellbeing, motivation, energy, soreness) produce actionable training modification signals without imposing the burden of full validated scales."}
{"chunk_id": "sport_psychology_expand_0404", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner synthesis; Abbiss & Laursen 2008 Sports Med", "text": "Using race splits for psychological reconstruction: reviewing race split data (km-by-km or 5-km split) after a marathon provides both physiological and psychological information about the race. Psychological analysis of split patterns: (1) large first-5km overspeed indicates anxiety-driven pacing failure; (2) gradual pace decline through km 25–30 indicates normal glycogen depletion without significant psychological event; (3) sudden large pace drop at a specific km indicates wall experience; (4) late-race acceleration indicates effective 'nothing left to save' psychological release. Split pattern diagnosis informs specific training responses."}
{"chunk_id": "sport_psychology_expand_0405", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Rees & Hardy 2000 J Sport Exerc Psychol; practitioner synthesis", "text": "Pre-race communication with significant others: research on social support in athletic performance finds that 'race day presence' of significant others (spouse, partner, children, close friends) is the single most emotionally impactful form of social support for recreational marathoners — more important than logistical help or verbal encouragement in training. Preparing significant others for race-day psychology — what not to say at certain points ('you look tired'), where to stand for maximum impact (km 30, the predictive wall zone), and what kind of support is wanted — is a psychologically sophisticated pre-race preparation step."}
{"chunk_id": "sport_psychology_expand_0406", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Samson & Solmon 2011; Pettitt et al. 2005", "text": "Spectator interaction psychology during marathon racing: runner-spectator interactions during a marathon produce brief but significant psychological interventions. Research on motivational speech in endurance context confirms that personally directed encouragement ('Go Sarah!', 'You're doing amazing for mile 22!') produces stronger pace maintenance effects than generic crowd noise. Training runners to 'use' spectator energy — deliberately making eye contact, responding briefly to crowd, smiling — activates reciprocal social connection that temporarily reduces RPE and extends pain tolerance."}
{"chunk_id": "sport_psychology_expand_0407", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Brown & Kulik 1977 Cognition; Pillemer 1998 Momentous Events", "text": "Race documentation and memory: research on autobiographical memory in peak athletic experiences (Brown & Kulik 1977 flashbulb memory research applied to sport) finds that emotionally significant race experiences are encoded with exceptional vividness and durability — often remaining among the clearest memories of adults' lives decades later. This 'flashbulb encoding' of race day means the psychological investment in race preparation and race-day emotional quality pays memory dividends far exceeding the race duration. Creating conditions for a high-quality race experience — positive social context, meaningful goals, managed anxiety — is an investment in long-lasting autobiographical meaning."}
{"chunk_id": "sport_psychology_expand_0408", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Fletcher & Sarkar 2012 J Sci Med Sport; practitioner synthesis", "text": "Adaptation to failure in marathon career: longitudinal research on recreational marathon runners documents that most runners who train for and compete in multiple marathons encounter at least one DNF, injury-compromised race, or significantly disappointing performance. Research on resilience in endurance sport (Fletcher & Sarkar 2012) identifies that runners who engage in deliberate adversity appraisal — processing what the failure teaches them specifically — show faster recovery of training motivation and better subsequent performance than those who minimize or catastrophize the experience. A structured 'failure debrief' protocol is a psychologically protective post-failure tool."}
{"chunk_id": "sport_psychology_expand_0409", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner synthesis; Taylor & Wilson 2005", "text": "Psychological readiness checkpoints in marathon training: research on athlete performance support suggests embedding structured psychological check-ins at defined training milestones rather than only responding to crisis. Recommended checkpoints: (1) week 4 — first significant long run; (2) week 8 — peak of initial buildup, first motivation dip risk; (3) week 14 — final hard training week before taper; (4) race week Monday — taper management; (5) race night — pre-competition routine review; (6) 48-72h post-race — reflection debrief. Each checkpoint uses a brief structured conversation rather than open-ended check-in."}
{"chunk_id": "sport_psychology_expand_0410", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Filo et al. 2009 J Sport Manag; Turner 1969 The Ritual Process", "text": "Marathon as community ritual: sociological and psychological research on large participatory sporting events (marathon, parkrun, Masters Games) identifies these events as modern community rituals — structured collective experiences that create shared meaning, belonging, and cultural identity. Research by Filo et al. (2009) documented that marathon participation produces community belonging effects equivalent to religious participation in some participants. This ritual function explains why marathon finishing ceremonies, participant communities, and shared suffering experiences produce strong bonding that persists long after the event."}
{"chunk_id": "sport_psychology_expand_0411", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Cook & Speraw 2006; Masters et al. 1993 J Leisure Res", "text": "Marathon as identity transition: qualitative research on first marathon completion documents it as an identity transition event — a 'rite of passage' in the anthropological sense, marking a before-and-after boundary in self-concept. Research by Cook & Speraw (2006) and Masters et al. (1993) found first marathon finishers uniformly describe the event as significant identity transformation, independent of finishing time. This identity transition function is why marathon completion resonates beyond its physiological demands — it represents a socially validated assertion of extraordinary human capacity."}
{"chunk_id": "sport_psychology_expand_0412", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Michie et al. 2011 Ann Behav Med; Fogg 2009 Persuasive Technology", "text": "Psychological support architecture for a marathon coaching AI: evidence synthesis from sport psychology, digital health, and behavior change research suggests an optimal AI marathon coaching psychological architecture includes: (1) regular micro-mood monitoring (daily 4-item check-in); (2) milestone celebration at defined training checkpoints; (3) crisis detection and referral pathway for mental health signals; (4) motivational interviewing-consistent conversation style (open questions, affirmations, reflections); (5) identity-affirming language ('as a runner, you know that...'); (6) evidence-based psychological technique library (self-talk scripts, imagery protocols, breathing tools); (7) post-race debrief framework. Research on digital health behavior change confirms this architecture produces superior adherence to equivalent systems without psychological components."}
{"chunk_id": "sport_psychology_expand_0413", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Ntoumanis & Biddle 1999; Kavussanu & Roberts 1996 J Sport Exerc Psychol", "text": "Competition as personal benchmark: research on recreational runners' competition motivation finds that the most psychologically healthy form of competition for recreational athletes is 'personal competition' — competing primarily against one's own previous performance rather than other runners. This internalized competition standard produces the performance benefits of competitive orientation (goal clarity, high effort, peak performance seeking) without the psychological risks (social comparison anxiety, shame on defeat, others-dependent self-worth). Helping runners establish personally meaningful performance benchmarks is more psychologically sustainable than encouraging external ranking focus."}
{"chunk_id": "sport_psychology_expand_0414", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Trubee et al. 2014 Int J Sports Physiol Perform; practitioner synthesis", "text": "Competitive field management on race day: running in a mass-participation marathon with thousands of competitors creates specific challenges for pace management. Research shows runners embedded in groups faster than their target pace systematically run faster than planned in the first 5 km. Evidence-based management: (1) seed conservatively relative to goal time; (2) plan to 'run your own race' in the first 3 km explicitly; (3) use 'letting runners go' — watching faster runners pass — as an active practice rather than competitive trigger."}
{"chunk_id": "sport_psychology_expand_0415", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Van der Kolk 2014 The Body Keeps the Score; Levine 2010 In an Unspoken Voice", "text": "Trauma-informed approaches in running coaching: research on trauma and exercise finds that survivors of trauma may experience body-focused activities like intense running as psychologically challenging due to dissociation, emotional flooding, or shutdown responses triggered by high physiological arousal. A trauma-informed marathon coaching system recognizes: (1) unexplained training avoidance may have trauma-related causes; (2) body-check-in requests should be optional; (3) intrusive exercise-related recollections warrant professional referral; (4) the choice and control features of marathon participation (setting one's own goals, own pace) are psychologically restorative in themselves for many trauma survivors."}
{"chunk_id": "sport_psychology_expand_0416", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Gross & John 2003 J Pers Soc Psychol; Blagden & Craske 1996", "text": "Cognitive reappraisal in mid-race execution: cognitive reappraisal — actively changing the meaning attributed to a challenging experience — is one of the most effective emotion regulation strategies in the research literature (Gross & John 2003). In marathon running contexts, specific reappraisal frames that research and practitioner experience confirm are effective: 'this pain means my body is working exactly as it should'; 'this is what race-specific fitness feels like'; 'this difficulty is exactly where my competitors are dropping off'; 'I've trained for this exact feeling.' Selecting and practicing reappraisal frames before the race makes them automatically available under cognitive fatigue."}
{"chunk_id": "sport_psychology_expand_0417", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Gross 1998 Psychol Rev; Webb et al. 2012 J Pers Soc Psychol", "text": "Emotion regulation strategy selection by phase: research on adaptive emotion regulation in endurance sport identifies phase-specific optimal strategies. Pre-race: reappraisal (changing thought content about upcoming challenge) is more effective than suppression. During race: acceptance (not fighting difficult sensations) and attentional deployment (choosing where to focus) are most effective. Post-race: expressive writing and social sharing accelerate emotional processing. Teaching runners this phase-specific strategy map — and rehearsing each strategy in appropriate training contexts — produces more flexible and effective emotion management than a single global strategy."}
{"chunk_id": "sport_psychology_expand_0418", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Hanrahan 2012 J Clin Sport Psychol; Pennebaker 1997 Opening Up", "text": "Training journal as psychological tool: research on expressive writing for athletes (Hanrahan 2012; Lavallee et al.) finds that athletes who maintain reflective training journals — going beyond session data to record emotional responses, challenges, and insights — show improved psychological wellbeing, clearer goal processing, and better training consistency compared to those who log only physiological metrics. The reflective writing mechanism is the same documented in Pennebaker's trauma-writing research: expressing difficult experiences in writing accelerates cognitive processing and reduces emotional residue."}
{"chunk_id": "sport_psychology_expand_0419", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Locke & Latham 2002 Am Psychol; Gollwitzer 1993 Am Psychol", "text": "Goal-setting in the training journal: research on goal-setting theory implementation in practice finds that writing goals — rather than only thinking them — increases goal commitment and follow-through significantly. Locke & Latham (2002) note that written goals activate specific cortical engagement that mental goals do not. For marathon runners, a training journal that includes weekly written goal review (what was the psychological goal for this week? was it achieved?) produces stronger psychological self-regulation over the training cycle than training logs tracking only physical metrics."}
{"chunk_id": "sport_psychology_expand_0420", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Pennebaker 1997; Tamminen & Holt 2012 Psychol Sport Exerc", "text": "Debriefing difficult training sessions: research on traumatic sport experiences and psychological processing supports the value of brief written or verbal debrief after particularly challenging sessions (a sufferfest long run, a failed interval session, a training run disrupted by illness). The debrief has three components: (1) acknowledgment — 'that was genuinely hard'; (2) context — 'this happened because...'; (3) forward frame — 'what I take from this for training is...'. Research on narrative processing confirms this three-part structure reduces rumination and converts negative experiences into learning events."}
{"chunk_id": "sport_psychology_expand_0421", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Betz & Wespe 2002; Wilson et al. 2003 J Sport Sci", "text": "Cross-training mental benefits: for runners who regularly supplement running with cross-training (cycling, swimming, strength training), research on exercise variety and psychological outcomes finds that varied exercise produces stronger hedonic adaptation resistance — the same workout feels novel for longer, maintaining enjoyment. Additionally, competence development in a second activity creates a multi-domain athletic identity that buffers the psychological impact of running injury. Research by Betz & Wespe found multi-sport athletes show lower sport-specific identity threat from injury."}
{"chunk_id": "sport_psychology_expand_0422", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner synthesis; Balsalobre-Fernandez et al. 2016 Int J Sports Med", "text": "Strength training psychology for runners: research on resistance training adherence among endurance athletes finds that runners typically have lowest adherence to prescribed strength training among all training components, driven by: (1) perceived interference with primary running identity; (2) aesthetic concern about increased muscle mass; (3) unfamiliarity producing frustration and avoidance. Psychological strategies to improve strength training adherence: frame as 'running-specific strength' not generic gym work; emphasize injury prevention function; include strength as a discrete training identity domain ('I strength-train to protect my running')."}
{"chunk_id": "sport_psychology_expand_0423", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Funk et al. 2004 Sport Manag Rev; Filo et al. 2009", "text": "The festival dimension of mass marathons: sociological research on major marathon events (Berlin, Tokyo, London) identifies a 'festival' quality — multi-day social, cultural, and athletic experiences that extend the marathon beyond the race itself. Research by Funk et al. on event experience and motivation finds that festival dimensions (expo, city exploration, post-race celebration) create emotional resonance that sustains motivation to train for subsequent events independent of race performance. Many runners report 'I fell in love with the event, not just the race.'"}
{"chunk_id": "sport_psychology_expand_0424", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Lave & Wenger 1991 Situated Learning; Allen Collinson 2008", "text": "Community of practice in marathon running: Lave & Wenger's 'community of practice' framework applied to running clubs and training groups identifies legitimate peripheral participation — newcomers observing and gradually integrating into expert community practices — as the primary mechanism of running culture transmission. Beginners who join established running communities don't just receive training information; they observe and absorb the emotional, attitudinal, and identity practices that sustain elite amateur runners through decades of training. This 'apprenticeship in motivation' is the true value of running communities beyond social support."}
{"chunk_id": "sport_psychology_expand_0425", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Gollwitzer & Sheeran 2006 Adv Exp Soc Psychol; practitioner synthesis", "text": "Race-day psychology emergency kit: sport psychology recommends runners prepare a 'psychological emergency kit' — a card or note with specific pre-planned responses to the 4–5 most likely psychological challenges: (1) 'I started too fast — what do I do now?'; (2) 'I'm at km 30 and want to quit — my response is...'; (3) 'My goal is unreachable — my new goal is...'; (4) 'I'm in pain — my pain script is...'; (5) 'I've lost my focus — my refocusing cue is...'. Research on implementation intentions confirms that having a pre-planned response to anticipated challenges reduces decision-making time and emotional reactivity."}
{"chunk_id": "sport_psychology_expand_0426", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Hayes et al. 2006; Gardner & Moore 2004 Behav Modif", "text": "Acceptance script for marathon adversity: ACT-based scripting for the hardest marathon moments prepares runners to accept, rather than fight, the experience of extreme fatigue. A specific acceptance script: 'This is what a marathon feels like at this point. This is hard. My body is doing its best. I don't have to feel good to keep moving. My values — [specific personal value] — are what keep me going. One step.' Research on ACT scripts in pain contexts confirms that brief, values-anchored acceptance scripts reduce pain unpleasantness without reducing motivational drive."}
{"chunk_id": "sport_psychology_expand_0427", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Taylor & Wilson 2005; Moran 2004 Sport Exerc Psychol", "text": "Visualization library for marathon runners: a comprehensive personal visualization library for marathon training includes: (1) start-line visualization (full sensory — crowd noise, temperature, nervous energy, then settling into rhythm); (2) km 10–20 'in the zone' visualization (controlled, strong, efficient); (3) km 28–32 wall-point visualization (recognizing the wall, executing specific response); (4) km 38–42 final push visualization (drawing on reserves, crowd energy, identity); (5) finish line visualization (the final meters, crossing the line, emotional release). Rehearsing each visualization weekly in the final 6 weeks creates automatic access under race conditions."}
{"chunk_id": "sport_psychology_expand_0428", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Jackson & Roberts 1992; Clough et al. 2002 Pers Individ Dif", "text": "Individual peak performance profile: research by Jackson & Roberts (1992) on flow experiences in competitive athletes recommends developing an 'Individual Peak Performance Profile' — a structured documentation of the specific physical, mental, environmental, and behavioral conditions that have preceded the athlete's best performances. For marathon runners, this profile typically includes: optimal weather range, ideal pre-race routine duration, music or silence preference, preferred warm-up, key mantras, optimal arousal level, and specific thoughts/emotions experienced before best races. The profile guides race preparation to recreate peak-performance conditions."}
{"chunk_id": "sport_psychology_expand_0429", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Podlog & Eklund 2007; Brewer 2010 J Athl Train", "text": "Post-injury motivation rebuilding protocol: a structured 8-week post-injury psychological recovery protocol based on evidence from sport psychology and physical rehabilitation research: (1) weeks 1–2: grief processing, cross-training identity building, visualization of running (not of injury); (2) weeks 3–4: research into the injury and recovery evidence, rebuilding competence and control; (3) weeks 5–6: return-to-running preparation — setting return goals, imagery of first runs back; (4) weeks 7–8: graded exposure (first walk, first easy jog, first short run), self-compassion practice for inevitable discomfort. Research on graded exposure in rehabilitation confirms this protocol reduces fear of reinjury."}
{"chunk_id": "sport_psychology_expand_0430", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Kimiecik & Stein 1992 J Applied Sport Psychol; practitioner synthesis", "text": "Reframing race day as practice: research on performance psychology identifies 'practice mindset' — approaching competition with the same exploratory, learning-focused attitude as training — as one of the most effective anti-anxiety competition approaches. Runners who approach their marathon as 'the biggest training run of the cycle, where I practice everything I've learned' rather than 'the test of 4 months of work' show significantly lower pre-race anxiety and comparable or superior performance. This is not denial of the event's importance but a deliberate psychological reframe that activates process focus."}
{"chunk_id": "sport_psychology_expand_0431", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Plews et al. 2013 Int J Sports Physiol Perform; Saw et al. 2016 Sports Med", "text": "Recovery metrics as performance data: research on training monitoring in marathon preparation distinguishes effort metrics (training load, pace, distance) from recovery metrics (HRV, sleep, mood). Most recreational runners monitor only effort metrics, creating an incomplete performance picture. Research confirms that recovery data is at least as predictive of upcoming performance quality as training load data. A psychologically sophisticated approach treats morning HRV, sleep quality rating, and subjective wellbeing as equal-status training data alongside pace and distance, with equal willingness to adjust plans based on recovery signals."}
{"chunk_id": "sport_psychology_expand_0432", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Shipway & Holloway 2010 Leis Stud; Masters et al. 1993", "text": "Marathon and life philosophy: qualitative research on long-term recreational marathon runners identifies a consistent pattern: marathon training and racing over years produces not just athletic development but articulated life philosophy. Research by Shipway & Holloway (2010) documented runners describing their sport as 'a philosophy of how to live' — emphasizing commitment, adaptation to adversity, incremental progress, and present-moment engagement. These running-derived life principles are applied broadly across non-running domains, producing documented improvements in persistence, stress tolerance, and goal pursuit in professional and personal life contexts."}
{"chunk_id": "sport_psychology_expand_0433", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Steele 1988 Adv Exp Soc Psychol; Cohen & Sherman 2014 Annu Rev Psychol", "text": "Final race week mantras and affirmation system: research on self-affirmation theory (Steele 1988) and its application in sport contexts supports brief daily affirmation practice in race week as a self-efficacy and identity-consolidation tool. An evidence-informed final race week affirmation protocol: write 3 training achievements from the cycle that prove race readiness, 1 identity statement ('I am a marathon runner who can handle hard things'), and 1 process commitment ('I will execute my race plan in the first half regardless of how I feel'). Reviewing these affirmations morning and evening in the final 3 days consolidates psychological race readiness."}
{"chunk_id": "sport_psychology_expand_0434", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Ogles & Masters 2003 J Sport Behav; Masters et al. 1993 J Leisure Res", "text": "Integration of marathon training lessons into daily life: longitudinal research on the non-athletic benefits of marathon participation consistently documents skills transfer: patience (from tolerating the long training cycle), resilience (from overcoming training setbacks), goal achievement behavior (from executing a structured long-term plan), and body literacy (from developing interoceptive awareness). These skills have documented positive effects in career persistence, relationship satisfaction, and health management. The full value proposition of marathon training extends far beyond race-day performance to these cross-domain psychological skill developments."}
{"chunk_id": "sport_psychology_expand_0435", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Vealey 2007 Handbook Sport Psychol; Taylor & Wilson 2005", "text": "Sport psychology consultation model for marathon runners: research on sport psychology delivery models finds that the most effective consultation format for recreational runners combines: (1) education — knowledge of psychological principles; (2) skills training — deliberate practice of specific techniques; (3) application — using techniques in training and competition; (4) reflection — reviewing what works and adjusting. This four-phase model, applied across 8–12 sessions over a training cycle, produces superior outcomes to either pure education or pure techniques-only approaches."}
{"chunk_id": "sport_psychology_expand_0436", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Hayes et al. 2006 Behav Res Ther; Kashdan & Rottenberg 2010 Clin Psychol Rev", "text": "Psychological flexibility scale for runners: research on psychological flexibility (the ability to contact the present moment fully, without unnecessary defense, and persist in behavior serving chosen values) identifies this construct as the strongest cross-situational predictor of athletic persistence under adversity. A simple self-check for psychological flexibility in marathon context: 'When things are hard, do I do what matters to me anyway?' — an affirmative answer predicts training adherence and race completion more reliably than motivation level or physical condition."}
{"chunk_id": "sport_psychology_expand_0437", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Kabat-Zinn 1994; practitioner synthesis; Birrer & Morgan 2010", "text": "Mindfulness body scan practice for marathon recovery: a 15–20 minute body scan meditation, practiced after key training sessions, develops interoceptive awareness while simultaneously providing recovery-facilitating relaxation. Research on post-exercise body scan practice in athlete populations finds this practice reduces delayed-onset muscle soreness ratings, improves subjective recovery quality, and increases body awareness accuracy — runners who practice body scanning report earlier identification of developing injury symptoms before they become clinically significant."}
{"chunk_id": "sport_psychology_expand_0438", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Nolen-Hoeksema et al. 2008 Perspect Psychol Sci; Segerstrom et al. 2000", "text": "Rumination and recovery inhibition: research on repetitive negative thinking (Nolen-Hoeksema 1991) finds that rumination — uncontrollable, repetitive dwelling on negative experiences — significantly impairs psychological recovery from hard training days, poor performances, and injury. Runners prone to rumination show longer psychological recovery times after setbacks regardless of objective event severity. Rumination-specific interventions for runners: (1) time-bounded processing ('I will think about this for 20 minutes, then redirect'); (2) physical distraction (the run itself); (3) cognitive defusion ('I'm having the ruminative thought that...'); (4) writing to closure."}
{"chunk_id": "sport_psychology_expand_0439", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Gupta et al. 2015; Sinnerton & Reilly 1992 Ergonomics", "text": "Sleep chronotype and training scheduling: research on chronotype (individual biological tendency toward morning or evening alertness) finds that 'evening chronotypes' (owls) who force early-morning training accumulate significant sleep debt across a training cycle. Research by Gupta et al. and Sinnerton et al. confirm that running performance in owl-type runners is 4–8% lower at 7am than at 4pm, while morning-type runners show minimal time-of-day performance variation. Marathon training programs should explicitly allow chronotype-appropriate session timing to prevent sleep debt and chronotype mismatch underperformance."}
{"chunk_id": "sport_psychology_expand_0440", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Tomporowski 2003 Sports Med; Dietrich & Audiffren 2011 Neurosci Biobehav Rev", "text": "Cognitive load and pace estimation accuracy: research on dual-task performance in running found that runners performing cognitively demanding secondary tasks (mental arithmetic, memory tasks) while running show significantly worse pace consistency — running 5–8% too fast or too slow. This finding has direct implications for marathon race management: post-mile 20 cognitive fatigue reduces pace judgment accuracy, making GPS pace display or pace-group reference more important in the late race when cognitive self-regulation accuracy has declined."}
{"chunk_id": "sport_psychology_expand_0441", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Bargh & Chartrand 1999 Am Psychol; practitioner synthesis", "text": "Pre-run psychological priming: research on behavioral priming (Bargh & Chartrand 1999) demonstrates that brief exposure to concepts, images, or language associated with success, effort, and competence produces measurable performance enhancement. For marathon training: reviewing a written summary of recent training achievements immediately before a hard session creates priming-based confidence enhancement that improves session quality. The effect is specific and requires the priming content to be personally relevant — generic motivational content produces weaker effects than personal performance data."}
{"chunk_id": "sport_psychology_expand_0442", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Voss et al. 2013 Front Aging Neurosci; Kramer & Erickson 2007 Nat Rev Neurosci", "text": "Neuroimaging evidence for running psychology: fMRI research on elite runners versus sedentary controls shows structural and functional brain differences: increased prefrontal cortex volume, enhanced default mode network connectivity (supporting self-referential processing and future planning), and reduced amygdala reactivity to stress stimuli. While marathon training does not transform brain structure in weeks, longitudinal neuroimaging research (Voss et al. 2013) documents significant white matter and grey matter changes over 6–12 months of consistent aerobic training, providing neurobiological grounding for the psychological benefits of marathon training."}
{"chunk_id": "sport_psychology_expand_0443", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Turnwald et al. 2019 Nat Med; Bandura 1997 Self-Efficacy", "text": "Endurance gene psychology: research on psychological responses to genetic information about athletic potential (specifically ACTN3 'sprinting' vs 'endurance' gene variants) finds that learning one has a 'positive' endurance genotype produces performance improvements, while 'negative' genetic information produces declines — both independent of actual genetic effect on performance. Research by Turnwald et al. (2019, Nature Medicine) found that genetic feedback produces mindset-mediated physiological effects. Marathon coaching systems should be cautious about presenting genetic potential framing in ways that create limiting beliefs."}
{"chunk_id": "sport_psychology_expand_0444", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Schlissel 2019; Millet et al. 2011 PLOS ONE", "text": "Strategic suffering acceptance in ultramarathon principles applied to marathon: elite ultramarathon runners report a specific psychological practice that distinguishes them from dropouts — pre-race acceptance of suffering as inherent to the endeavor rather than as a problem requiring solution. Research by Schlissel (2019) on ultra-runner coping found that suffering acceptance predicted race completion more strongly than physical training volume or experience in DNF-prone ultra conditions. This 'strategic pre-acceptance' — deciding before the race that 'yes, this will hurt, and yes, I will continue' — is directly transferable to marathon preparation."}
{"chunk_id": "sport_psychology_expand_0445", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Frederick-Recascino 2002 in Handbook; practitioner synthesis", "text": "Psychological skills for running in different seasons: research on seasonal variation in running motivation and performance finds that winter training represents the highest psychological challenge for most runners — low light, cold temperatures, and absent race proximity create motivational nadir. Sport psychology recommendations for winter training psychology: (1) shift goal focus to process metrics (consistency, effort quality); (2) increase community engagement (indoor group runs, virtual challenges); (3) establish a meaningful spring race goal to create anticipatory motivation; (4) use winter to build psychological skills (imagery, mindfulness) as deliberate training."}
{"chunk_id": "sport_psychology_expand_0446", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Rousseau 1989 J Organizational Behav; practitioner synthesis", "text": "Psychological contract with the marathon: experienced marathon coaches describe a useful concept — the 'psychological contract with the marathon' — the implicit agreement between the runner and the race about what each will provide. The runner provides: honest preparation, respect for the distance, and willingness to accept the race's demands. The marathon provides: a genuine test, an honest reflection of preparation, and an unforgettable experience regardless of the finishing time. Research on psychological contracts in performance contexts (Rousseau 1989) confirms that violation of this contract (e.g., running undertrained and expecting success) produces particularly negative psychological aftermath."}
{"chunk_id": "sport_psychology_expand_0447", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Deci & Ryan 2000; Oyserman 2012; practitioner synthesis", "text": "The 'why' audit: research on value-based motivation (Deci & Ryan; Oyserman) recommends periodic 'why' audits — structured reflection on the underlying personal values driving marathon participation. Questions: Why do I run? What would I lose if I couldn't run? What do I hope my participation teaches me about myself? What does my running say about my values? Research confirms that runners who can articulate personally meaningful answers to these questions show stronger adherence through adversity than those with surface-level motivations ('I want to lose weight', 'my friend talked me into it')."}
{"chunk_id": "sport_psychology_expand_0448", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Hardy & Callow 1999 J Sport Exerc Psychol; Cumming & Williams 2012", "text": "Imagery modalities in marathon preparation: research on mental imagery effectiveness distinguishes internal imagery (experiencing the race from a first-person perspective, feeling the effort, seeing the course ahead) from external imagery (watching oneself run as if from video). Research by Hardy & Callow (1999) found that internal imagery is superior for skill execution and emotional preparation; external imagery is superior for technique correction and pattern recognition. Marathon runners benefit from both: internal imagery for race-day feel and emotional readiness, external imagery for reviewing form and race strategy."}
{"chunk_id": "sport_psychology_expand_0449", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Vealey & Greenleaf 2001; Isaac 1992 J Sport Behav", "text": "Imagery vividness and effectiveness: research on imagery ability differences in athletes confirms that imagery vividness (the degree of sensory detail and emotional authenticity in mental images) moderates imagery's performance effects. High-vividness imagers show stronger performance improvement from imagery practice than low-vividness imagers. Vividness is trainable: daily imagery practice increases vividness over 4–8 weeks. Training imagery vividness specifically — adding more sensory modalities (sound, temperature, proprioception) and emotional authenticity — increases the psychological return on imagery time investment."}
{"chunk_id": "sport_psychology_expand_0450", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Driskell et al. 1994 Psychol Bull; Murphy 1994 J Appl Sport Psychol", "text": "Imagery practice logistics: research on imagery practice in athlete populations finds that 5–10 minutes of deliberate imagery practice daily is more effective than occasional longer sessions. Optimal conditions: quiet environment, comfortable position (seated or lying), eyes closed, beginning with a brief body relaxation to reduce distraction. Research confirms that imagery practice immediately before sleep is particularly effective due to the alpha brain state produced by pre-sleep relaxation, which enhances imagery vividness and neural consolidation of the rehearsed patterns."}
{"chunk_id": "sport_psychology_expand_0451", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Leone et al. 2005 Int J Eat Disord; Pope et al. 2000", "text": "Body dysmorphia risk in male marathon runners: while traditionally studied primarily in female athletes and bodybuilders, research on body dysmorphic disorder (BDD) and exercise addiction documents risk in male distance runners, particularly those who focus intensively on body weight as a performance variable. Research by Leone et al. (2005) found clinically significant body image disturbance in 11% of male competitive distance runners studied. A marathon system detecting significant body composition preoccupation in male runners should provide psychoeducation about healthy performance weight ranges and professional referral when preoccupation appears clinically significant."}
{"chunk_id": "sport_psychology_expand_0452", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Arkes & Blumer 1985 Organ Behav Hum Dec; Kahneman 2011", "text": "Return of investment psychology in marathon training: research on behavior change economics confirms that perceived investment (time, money, social reputation) in a goal increases persistence through difficulty via the 'sunk cost' mechanism. While classic economic theory treats sunk costs as irrational, in marathon contexts the psychological 'sunk cost' of months of training provides genuine motivational protection against late-training dropout and race-day DNF. Coaches can activate this frame ('you've built something real over 14 weeks — today's session protects that investment') as a legitimate motivational tool when other approaches have insufficient pull."}
{"chunk_id": "sport_psychology_expand_0453", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Buman et al. 2008; Ogles & Masters 2003; sport psychology profile research", "text": "Psychological signature of elite amateur performance: research on 'sub-3-hour' marathon runners (a performance level achievable by dedicated recreational runners) identifies a distinctive psychological profile: higher intrinsic motivation, stronger athletic identity, superior pain tolerance, lower performance anxiety (based on racing experience), more sophisticated race strategy knowledge, and greater psychological flexibility. Each of these psychological variables is independently trainable — suggesting that closing the psychological profile gap between average recreational runners and sub-3-hour performers is as achievable through deliberate psychological development as closing the physiological gap."}
{"chunk_id": "sport_psychology_expand_0454", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Fletcher & Sarkar 2016 J Sport Exerc Psychol; Gucciardi et al. 2009 J Sci Med Sport", "text": "Resilience training in marathon preparation: research on resilience-building interventions in sport (Fletcher & Sarkar 2016) finds that deliberate exposure to controllable adversity during training — intentionally incorporating uncomfortable scenarios (running in adverse weather, running through moderate fatigue, practicing continuing after a missed nutrition window) — builds the resilience resources that protect performance in actual race-day adversity. The key principle: 'Make training harder than the race in targeted ways so the race feels manageable.'"}
{"chunk_id": "sport_psychology_expand_0455", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Bhattacharya et al. 2018 Organ Behav Hum Dec; Allen et al. 2017 J Mark Res", "text": "Marathon distance as psychological boundary event: research on boundary effects in goal psychology (Bartels & Rips 2010; Bhattacharya et al.) finds that round-number boundaries (sub-3, sub-4, sub-5 hours) produce disproportionate motivation and celebration effects beyond their practical significance. Runners just below a round-number barrier show dramatically increased motivation to achieve the boundary compared to runners equally far from the boundary on the far side. This psychological phenomenon is worth understanding for coaches helping runners set goals — round-number targets produce qualitatively different motivation than equivalent non-round targets."}
{"chunk_id": "sport_psychology_expand_0456", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner synthesis; Gucciardi et al. 2009", "text": "The psychology of running in the rain: research on training behavior in adverse weather finds that successfully completing a planned training session in challenging conditions (rain, wind, heat) produces disproportionate psychological benefit relative to the training stimulus — a 'resilience reward' that strengthens self-efficacy and identity more powerfully than the same session in optimal conditions. Many coaches deliberately schedule key mental toughness sessions in forecast adverse weather for this psychological compounding effect, while ensuring safe conditions and appropriate training adjustment."}
{"chunk_id": "sport_psychology_expand_0457", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "emerging research synthesis 2020–2025", "text": "Marathon psychology research frontiers: emerging areas of sports psychology research with direct marathon relevance include: (1) psychobiological models of gender-specific fatigue perception differences; (2) wearable technology for real-time psychological state monitoring in training; (3) AI-personalized psychological intervention delivery; (4) gut-brain axis connections between GI distress and mood in endurance events; (5) sleep microstructure and marathon next-day performance; (6) social media-based peer support optimization for training adherence. These areas represent the next decade of evidence that will refine marathon psychological support."}
{"chunk_id": "sport_psychology_expand_0458", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Marcora 2010 Sport Med (integration review); Tenenbaum & Eklund 2007 Handbook", "text": "Integrative approach to marathon psychology: research synthesis across behavioral science, sport psychology, and neuroscience converges on an integrative view: marathon performance is co-determined by physiological preparation, psychological skill, social context, and meaning. The best marathon performances occur when training has been adequate, psychological tools are practiced and available, social support is present and appropriate, and the race carries personal meaning. A marathon coaching system optimally addresses all four domains — not only training load — to support the full human system that produces peak marathon performance."}
{"chunk_id": "sport_psychology_expand_0459", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Hatzigeorgiadis et al. 2009 Perspect Psychol Sci", "text": "Positive self-talk after a training failure: research on post-failure self-talk patterns in athletes (Hatzigeorgiadis et al. 2009) found that instructional self-talk ('relax shoulders, drive arms') restored performance quality faster than motivational self-talk after a failed interval. Applied to marathon: after a missed target in a hard training session, returning to technique cues ('light feet, tall posture, relaxed hands') is more effective at restoring performance quality than generic encouragement ('keep going, believe in yourself')."}
{"chunk_id": "sport_psychology_expand_0460", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "systematic_review_meta_analysis", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Laborde et al. 2016 Eur J Sport Sci; Mayer et al. 2004 Psychol Inquiry", "text": "Emotional intelligence and marathon performance: research on emotional intelligence (EI) in sport contexts finds that athletes with higher EI show better pre-competition anxiety management, faster recovery from setbacks, and more effective use of social support. A meta-analysis by Laborde et al. (2016) found significant positive relationships between EI and performance in endurance contexts. EI in running contexts manifests as: accurately reading one's own emotional state, understanding the emotional impact of training decisions, and managing emotional responses to performance feedback."}
{"chunk_id": "sport_psychology_expand_0461", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Moore 2009 J Clin Sport Psychol; Kaufman et al. 2009 J Clin Sport Psychol", "text": "Non-attachment and running outcomes: Buddhist psychology concept of non-attachment to outcomes — engaging fully in action without clinging to specific results — has been operationalized in Western sport psychology through ACT and mindfulness approaches. Research on non-attachment in competitive sport finds that athletes who practice non-attachment to race outcomes show lower performance anxiety, superior focus on execution, and, paradoxically, better performance outcomes. The paradox resolves when understood: non-attachment removes the anxiety that impairs performance while maintaining full effort engagement."}
{"chunk_id": "sport_psychology_expand_0462", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Iso-Ahola & Mobily 1980; Taylor & Demick 1994 J Appl Sport Psychol", "text": "Psychological momentum in marathon racing: research on psychological momentum — the subjective sense that things are 'going well' or 'going badly' in an unfolding performance — finds it is a genuine phenomenon with neuropsychological substrate. Positive momentum states produce enhanced pain tolerance, reduced perceived exertion, and improved decision quality. Negative momentum (triggered by unexpected difficulty, missed splits, or pain onset) has opposite effects. Race psychology includes techniques for (1) generating momentum early by achieving small within-race sub-goals; (2) interrupting negative momentum through brief behavioral change (pace check, nutrition intake, form adjustment)."}
{"chunk_id": "sport_psychology_expand_0463", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Easterbrook 1959 Psychol Rev; Beilock & Gray 2007", "text": "Attentional narrowing under pressure: research on the effects of pressure on attentional capacity in endurance sport finds that as perceived pressure increases, attentional field narrows from broad (aware of environment, competitors, body, strategy) to narrow (focused on immediate discomfort and wanting to stop). This attentional narrowing is adaptive in some contexts but harmful in marathon racing when it prevents strategic decision-making. Pre-planned attentional anchor protocols — returning to a specific external focus (stride rhythm, next drink station) — interrupt attentional narrowing and restore broader situational awareness."}
{"chunk_id": "sport_psychology_expand_0464", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner synthesis; Udry et al. 1997 J Sport Exerc Psychol", "text": "Recovery from a DNF: research on athletic performance withdrawal from competition finds that runners who DNF (Did Not Finish) a marathon experience a distinct psychological aftermath that differs from a poor finishing performance. DNF produces stronger identity threat ('I'm someone who quit') and social shame concerns, requiring specific psychological intervention. Evidence-based DNF recovery: (1) narrative reframe ('I made the right safety/health decision'); (2) specific review of what triggered the decision (was it appropriate?); (3) identification of what the DNF teaches about preparation; (4) prompt re-engagement with running community to avoid shame-driven isolation."}
{"chunk_id": "sport_psychology_expand_0465", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Cialdini 2001 Influence; Jussim & Harber 2005 Pers Soc Psychol Rev", "text": "Marathon number psychology — the power of the bib: research on symbolic objects in sport performance finds that athlete number assignments carry psychological weight beyond their informational function. Low bib numbers (assigned to expected fast finishers) produce performance expectations that influence actual outcomes — a version of the self-fulfilling prophecy. Research by Cialdini et al. on social proof confirms that runners in earlier corrals run faster partly because of the psychological effects of being treated as a fast runner. For recreational runners, being assigned or choosing an appropriate corral — one where finishing pace expectations are realistic — reduces the social comparison anxiety that drives early pacing errors."}
{"chunk_id": "sport_psychology_expand_0466", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Funk et al. 2011 Sport Manag Rev; Hinch & Higham 2004", "text": "Marathon tourism psychology: a growing body of research examines 'sport tourism' motivation in marathon participation — runners who select races primarily for their destination city rather than competitive opportunity. Research by Funk et al. (2011) found that sport-tourism motivated runners show distinct psychological profiles: higher novelty-seeking, stronger extrinsic motivation components, greater price sensitivity, and more specific pre-race wellbeing from exploration activities. These runners benefit from coaching approaches that deliberately integrate the destination experience into race preparation psychological context."}
{"chunk_id": "sport_psychology_expand_0467", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Kaplan 1995 Ann Behav Med; Stevens et al. 2015", "text": "Sensory environment and race performance: research on environmental psychology and athletic performance finds that sensory characteristics of the race environment significantly affect psychological experience and physiological output. Key findings: (1) green corridor segments reduce perceived exertion; (2) tunnel segments increase anxiety; (3) urban noise increases arousal (helpful in early race, harmful when fatigued); (4) music zones in late-race provide recoverable psychological stimulation. Understanding how the race course's sensory environment affects psychological state allows runners to plan psychological tool use strategically across course segments."}
{"chunk_id": "sport_psychology_expand_0468", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Stickgold 2005 Nature; Ericsson 1993 Psychol Rev", "text": "The post-run debrief as neural consolidation: research on memory consolidation in skill learning confirms that brief structured review of a training session immediately after completion strengthens neural encoding of lessons learned from the session. The mechanism parallels sleep consolidation: active rehearsal of session lessons within 30 minutes produces significantly better retention than passive completion. For marathon training, a 3-minute post-run reflection ('what was the psychological lesson of this session?') produces compounding psychological skill acquisition across the training cycle."}
{"chunk_id": "sport_psychology_expand_0469", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Hopkins et al. 2001 Med Sci Sports Exerc; Atkinson & Nevill 1998", "text": "Acceptance of performance variability: research on performance variability in marathon training finds that day-to-day and week-to-week performance fluctuation is a natural feature of training adaptation, not evidence of inconsistency or inadequacy. Research by Hopkins et al. (2001) quantified typical within-athlete performance variability at 2–4% for trained runners under similar conditions. Psychological preparation should include explicit expectation of this variability: a runner who expects perfect linearity will experience repeated disappointment; one who expects normal variability treats outlier sessions as statistical noise rather than meaningful signals."}
{"chunk_id": "sport_psychology_expand_0470", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Rimé 2009 Psychol Rev; Zech et al. 2010", "text": "Post-race social sharing and consolidation: research on social sharing of emotional experiences (Rimé 2009, Psychol Rev) finds that sharing significant athletic experiences (race reports, telling the race story to friends, posting on social media) produces emotion regulation, meaning consolidation, and social bonding effects. For marathon runners, race storytelling is a psychological processing tool, not merely social performance. Coaches should encourage structured post-race social sharing — writing a race report, sharing key moments with the running community — as a deliberate psychological recovery and consolidation practice."}
{"chunk_id": "sport_psychology_expand_0471", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Weed et al. 2015 Br J Sports Med; Hindson et al. 2017", "text": "Olympic marathon spectating and participatory motivation: research on spectatorship effects on running participation finds that watching major marathon events (Olympics, World Majors) on media produces significant 'inspiration effects' — increased running participation and training motivation in recreational runners for 6–12 weeks following major events. The London 2012 Olympics were associated with measurable increases in running participation in subsequent months. For marathon coaching systems, leveraging seasonal inspiration (post-major championship) to initiate training cycle discussion represents a psychologically optimal engagement window."}
{"chunk_id": "sport_psychology_expand_0472", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Birney et al. 1969; Elliot & Church 1997 J Pers Soc Psychol", "text": "Fear of failure versus fear of success in marathon running: research distinguishing fear of failure (the dominant performance anxiety pattern in most runners) from fear of success (psychological resistance to achieving goals due to concern about increased expectations, identity change, or social consequences) finds that fear of success is underrecognized in marathon running contexts. Runners approaching significant personal milestones (first sub-4, BQ qualification) sometimes unconsciously underperform in key training sessions. Awareness of this pattern and explicit anticipation of what success will require (increased expectations, new identity) allows psychological preparation for achievement."}
{"chunk_id": "sport_psychology_expand_0473", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Kellmann 2010 Eur J Sport Sci; practitioner synthesis", "text": "Marathon recovery weeks as psychological periodization: research on psychological overload in training finds that psychological capacity — like physiological capacity — benefits from deliberate recovery periods. Scheduling a 'psychological recovery week' every 4–6 weeks of peak training — where effort goals are replaced by enjoyment goals, performance data review is suspended, and training is completed intuitively by feel — prevents psychological burnout independently of physical recovery. Research on marathon training programs that include psychological deload weeks show better adherence through the full cycle compared to programs with continuous performance focus."}
{"chunk_id": "sport_psychology_expand_0474", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner synthesis; Funk et al. 2004", "text": "The role of race expos in psychological preparation: major marathon expos — the pre-race registration and vendor events — serve psychological as well as logistical functions for runners. Research on anticipatory emotion in sporting events finds that the expo environment activates positive anticipatory affect that primes optimal arousal for race day. The expo also provides environmental familiarization (reducing novelty-related anxiety), social belonging activation (community of fellow runners), and ritual completion (final race number collection). Attending the expo as a structured psychological preparation step — not just for logistics — optimizes its psychological value."}
{"chunk_id": "sport_psychology_expand_0475", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Ogles & Masters 2003; Buman et al. 2009 J Sport Exerc Psychol", "text": "Building psychological consistency across seasons: research on year-round training psychology in recreational marathon runners identifies psychological consistency — maintaining regular running and training community engagement across the full year, including the post-marathon recovery period and the off-season — as the strongest predictor of improving performance across marathon training cycles. Psychological consistency is maintained by: (1) transitional goals between training cycles (fun runs, shorter races); (2) maintained community participation; (3) off-season training identity frame ('I'm a runner in every season, not only during training cycles')."}
{"chunk_id": "sport_psychology_expand_0476", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Tenenbaum & Eklund 2007 Handbook Sport Psychol; Vealey 1994 integration", "text": "Marathon psychology framework summary for coaching systems: an evidence-integrated framework for marathon psychological support includes six functional domains: (1) motivation architecture (SDT-aligned goal structures, implementation intentions, identity building); (2) performance anxiety management (reappraisal, breathing, controlled exposure); (3) pain and suffering management (acceptance, defusion, attention strategies, chunking); (4) social and community psychology (accountability, group cohesion, social facilitation); (5) recovery psychology (rest legitimacy, psychological deload, sleep); (6) resilience and adversity response (coping flexibility, growth narratives, psychological emergency planning). Effective marathon psychological support addresses all six domains across the training cycle."}
{"chunk_id": "sport_psychology_expand_0477", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "White 1959 Psychol Rev; Deci & Ryan 2000", "text": "Goal proximity and perceived competence: research on competence motivation in distance running (White 1959; Deci & Ryan 2000) finds that as runners approach a meaningful goal (completing a long run PB, hitting target pace in tempo), perceived competence spikes — even before the goal is achieved. This anticipatory competence surge is a motivational resource that coaches can leverage by making goal proximity explicit: 'You have 3 km left — you've done this before in training.'"}
{"chunk_id": "sport_psychology_expand_0478", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Cumming & Williams 2012 Appl Sport Psychol; Guillot & Collet 2008", "text": "Mental rehearsal specificity gradient: research on mental imagery in sport performance (Cumming & Williams 2012) identifies a 'specificity gradient' — imagery rehearsing precise target scenarios produces larger performance effects than generic positive imagery. For marathon runners: imagining the specific race course, specific target pace feel, specific km 32 sensation, and specific finish line approach produces better psychological preparation than imagining 'running well' in general. Imagery preparation should be as race-specific as possible."}
{"chunk_id": "sport_psychology_expand_0479", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Weinberg et al. 1997 J Appl Sport Psychol; Foster 2004", "text": "Performance keyword associations: research on associative learning in sport performance finds that runners who associate specific keywords ('smooth', 'strong', 'easy') with target physiological states — through consistent use during training at those states — create conditioned stimulus-response associations that can activate the target state on demand during racing. The process requires 8–12 weeks of consistent pairing during training. Race-day activation of trained keywords produces verified physiological and psychological state shifts in research participants."}
{"chunk_id": "sport_psychology_expand_0480", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner synthesis; Kenefick et al. 2007 Med Sci Sports Exerc", "text": "Psychological response to race-day weather changes: unexpected race-day weather (unanticipated heat, rain, or wind) is one of the most common psychological destabilizers in marathon racing. Research on adaptation to unexpected challenges in performance contexts finds that runners with pre-established 'weather contingency scripts' — specific adjusted goals and pacing plans for hot, cold, wet, and windy conditions — show significantly less mid-race demoralization and better final performance outcomes than those adapting ad hoc to unexpected conditions."}
{"chunk_id": "sport_psychology_expand_0481", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Lucas-Carr & Krane 2011 J Appl Sport Psychol; practitioner review", "text": "Gender-affirming aspects of marathon communities: research on LGBTQ+ athletes in mainstream sport finds that marathon running communities have shown relatively high inclusivity compared to many other competitive sports, with major events explicitly welcoming gender-diverse participants and providing non-binary competition categories. Research documents that gender-affirming sport participation produces significant psychological benefits — reduced gender-related distress, improved body relationship, and stronger community belonging — for transgender and non-binary runners. Marathon coaching systems should use inclusive language and avoid assumptions about gender in runner profiles."}
{"chunk_id": "sport_psychology_expand_0482", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Cialdini et al. 1990 J Pers Soc Psychol; Nolan et al. 2008", "text": "Perceived social norms and running frequency: research on social norm influences on health behavior (Cialdini et al. 1990) finds that knowledge that peers are running frequently creates normative pressure to run equivalently. Running communities that regularly share training data implicitly establish training frequency norms. When these norms are higher than what an individual runner finds sustainable, they produce anxiety and shame on rest days. Psychologically healthy running communities deliberately communicate a range of 'normal' training frequencies and validate lower-volume participation as legitimate."}
{"chunk_id": "sport_psychology_expand_0483", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Brewer et al. 1993; Hamer & Chida 2009 Psychol Med; McKinley et al. 2019", "text": "Athletic identity and career longevity research: longitudinal studies on recreational athletic participation find that runners with moderate-to-high athletic identity who maintain regular participation for 5+ years show lower incidence of age-related cognitive decline, lower rates of clinical depression, higher life satisfaction scores, and greater social network density than non-athletic age-matched controls. The marathon specifically — with its structured training cycles, community events, and progressive challenge — creates the conditions for these long-term health benefits more reliably than unstructured recreational activity."}
{"chunk_id": "sport_psychology_expand_0484", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Schwartz et al. 2002 J Pers Soc Psychol; Stoeber & Otto 2006", "text": "The 'good enough' training philosophy: research on perfectionism and performance in recreational athletes supports the concept of 'satisficing' in training — accepting training sessions that are 'good enough' rather than perfect, and moving forward rather than dwelling on imperfect execution. Research by Schwartz et al. (2002, J Pers Soc Psychol) found that 'satisficers' (those who accept good enough) show higher life satisfaction and lower regret than 'maximizers' (those who must optimize every decision). Applied to marathon training: a 'good enough' training culture prevents perfectionism-driven burnout while maintaining consistent preparation quality."}
{"chunk_id": "sport_psychology_expand_0485", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Andersen & Williams 1988 J Sport Exerc Psychol; Petrie & Falkstein 1998", "text": "Marathon performance in relation to life stress index: research on life stress and athletic performance (Andersen & Williams 1988 stress-injury model) finds an inverted relationship — moderate life stress (creating motivational energy and structured focus) supports marathon training, while severe life stress (relationship crisis, bereavement, job loss) significantly impairs training quality, injury risk, and race performance. A marathon coaching system asking runners about current life stress context (not specific details) and adjusting training expectations accordingly represents psychologically sophisticated practice."}
{"chunk_id": "sport_psychology_expand_0486", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Smith et al. 2005 J Sport Exerc Psychol; Mageau & Vallerand 2003", "text": "Coaching the 'difficult conversation': research on effective communication in athlete-coach relationships identifies that discussions about underperformance, overtraining risk, and goal adjustment are the most psychologically challenging coach-athlete conversations. Evidence-based principles for these conversations: (1) descriptive rather than evaluative opening ('Your last three long runs have had higher RPE than expected' vs 'You've been struggling'); (2) collaborative problem framing ('What do you think is happening?'); (3) solution focus with athlete agency ('What would you like to do about this?'). These principles are directly applicable to AI-based coaching conversation design."}
{"chunk_id": "sport_psychology_expand_0487", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Trubee et al. 2014; practitioner synthesis", "text": "First-kilometer psychology — executing the plan when everything says go fast: research on the first-km psychology in marathon racing finds this is the hardest discipline for most recreational runners. The combination of peak fitness feel, race excitement, crowd energy, and competitive comparison creates maximal conditions for pace overshoot. Evidence-based first-km psychological management: (1) set a specific target range that is explicitly slower than target race pace; (2) use internal focus on effort (RPE 5–6 target) rather than pace display for the first 5 minutes; (3) pre-frame early restraint as the performance skill — 'holding back is the hard work in the first km.'"}
{"chunk_id": "sport_psychology_expand_0488", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Gucciardi & Gordon 2009; Andersen 2009", "text": "Distinguishing training from racing psychology: research on competitive versus training psychological states finds that elite runners explicitly differentiate their psychological orientation in training (process-focused, exploratory, tolerating imperfection) from racing (outcome-focused, risk-accepting, maximal-effort committed). Recreational runners who approach every training session with race-level competitive mindset accumulate psychological fatigue faster and show higher burnout rates. Training a 'training mindset' — curious, process-focused, adaptable — as distinct from 'racing mindset' is a psychological periodization principle."}
{"chunk_id": "sport_psychology_expand_0489", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Aspinwall & Taylor 1997 J Pers Soc Psychol; Greenglass 2002 Proactive coping", "text": "Proactive coping in marathon preparation: proactive coping — taking actions in advance to prevent anticipated challenges rather than reacting to them after they occur — is a research-supported emotion regulation strategy with particular relevance to marathon preparation. Research by Greenglass (2002) and Aspinwall & Taylor (1997) on proactive coping in health contexts finds it more effective than reactive coping for sustained performance under predictable challenges. For marathon runners: preparing specific responses to the anticipated km 32 wall, the too-fast first km temptation, and the race-week anxiety before they arise is proactive rather than reactive psychological preparation."}
{"chunk_id": "sport_psychology_expand_0490", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "referral_and_flag_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner synthesis; Podlog & Eklund 2007", "text": "Psychological safety and DNF decisions in training: research on safety culture in athletic environments finds that training groups and coaches who explicitly normalize training session abandonment when genuinely warranted (illness onset, injury warning signs, acute stress) produce lower overall injury rates than those where stopping a session is culturally discouraged. This 'permission to stop' culture requires explicit verbal establishment — the implicit norm in most running communities is that stopping is failure, making it psychologically inaccessible even when objectively appropriate."}
{"chunk_id": "sport_psychology_expand_0491", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Butler & Hardy 1992; Dale & Wrisberg 1996", "text": "Performance profiling update mid-cycle: research on performance profiling application finds that the most effective implementation involves re-assessment at cycle mid-point (week 8–10 of a 16-week plan), comparing current profiles to initial profiles to: (1) celebrate psychological growth on dimensions that have improved; (2) identify dimensions where initial targets were unrealistic; (3) adjust priority for the remaining training period. This mid-cycle update keeps the psychological preparation plan responsive to actual development rather than fixed to initial assessment."}
{"chunk_id": "sport_psychology_expand_0492", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "practitioner synthesis; Vickers & Williams 2007 J Appl Sport Psychol", "text": "Acceptance of the gap between training and race performance: research on training pace versus race performance translation in recreational runners finds that GPS pace in training systematically underestimates race difficulty due to course variation, crowd management, and race-day conditions. Most recreational runners run their marathon 3–8% slower than their training long runs suggest. Psychological preparation for this gap — framing it as normal and expected rather than as underperformance — prevents mid-race demoralization when race pace is harder than training feel predicted."}
{"chunk_id": "sport_psychology_expand_0493", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Kahan 2012 Annu Rev Law Soc Sci; practitioner synthesis", "text": "Identity-protective cognition in running community: research on identity-protective cognition (Kahan 2012) finds that people tend to process new information in ways that protect existing identities. For runners, this means: performance-identified runners will seek evidence that slow days are external attributions ('the heat') rather than internal; injury-experienced runners may deny early warning signs to protect the 'runner who doesn't get hurt' identity. A psychologically sophisticated coaching system recognizes and gently challenges identity-protective cognitions when they contribute to inappropriate training behavior."}
{"chunk_id": "sport_psychology_expand_0494", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Jones et al. 2002 J Appl Sport Psychol; Dweck 2006 Mindset", "text": "High-performance mindset for recreational runners: research on psychological characteristics of high performers (Jones et al. 2002; Gucciardi & Gordon 2009) identifies that 'high performance mindset' components are not exclusive to elite athletes — they are psychological orientations accessible across performance levels. For recreational marathon runners, the high-performance mindset includes: welcoming challenge as opportunity, viewing failure as information rather than verdict, training with full engagement regardless of audience, and maintaining consistent standards across favorable and difficult training conditions."}
{"chunk_id": "sport_psychology_expand_0495", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Hardy et al. 2019; Kross et al. 2014 J Exp Psychol Gen", "text": "Cross-cultural self-talk research and marathon implications: research on self-talk effectiveness across cultural contexts finds significant variation. First-person singular self-talk ('I can do this') is more effective for extroverted, Western-individualist populations; second-person self-talk ('You can do this') is more effective in some East Asian and collectivist cultural contexts where self-directing an external 'you' creates psychological distance that reduces self-criticism. Marathon coaching systems serving culturally diverse populations should allow self-talk personalization rather than prescribing a single format."}
{"chunk_id": "sport_psychology_expand_0496", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "randomized_controlled_trial", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Brick et al. 2016 Med Sci Sports Exerc; Marchant 2011", "text": "Visual anchoring techniques in late-race: research on attentional focusing strategies for pain management in endurance sport confirms that fixing gaze on a specific visual target ahead (a runner, a landmark, a finish-line visible marker) and committing to reaching that target before selecting the next one significantly extends pain tolerance compared to unfocused gaze. The technique is called 'chunking by visual anchor' — each visual target becomes the 'finish line' for a micro-race within the race. Research by Brick et al. (2016) specifically documented this effect in marathon and half-marathon populations."}
{"chunk_id": "sport_psychology_expand_0497", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Ntoumanis et al. 2010 J Sport Exerc Psychol; Fogg 2009", "text": "Performance language in coaching and self-coaching: research on linguistic framing in sport contexts (Ntoumanis et al. 2010) finds that the language coaches and runners use about training produces measurable differences in motivation quality. 'You should do the long run' creates controlled motivation; 'You get to do the long run' activates autonomy. 'I have to train' signals burden; 'I choose to train' signals agency. 'I'm trying to run a marathon' signals uncertainty; 'I'm training for my marathon' signals commitment. Language auditing — deliberately choosing performance-consistent framing — is a low-cost, evidence-supported psychological tool."}
{"chunk_id": "sport_psychology_expand_0498", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Vealey 2001 Handbook Sport Psychol; Hays et al. 2009 J Sport Exerc Psychol", "text": "Sport confidence sources for marathon runners: Vealey's (2001) Sport Confidence model identifies six major sources of sport confidence relevant to marathon performance: (1) mastery — successfully executing race skills in training; (2) demonstration of ability — performing well relative to others or one's own past; (3) physical and mental preparation — believing one has done the work; (4) physical self-presentation — feeling physically ready; (5) social support — believing the team/community believes in you; (6) coach's leadership — trusting the training guidance. Systematically building each source across the training cycle produces more robust and sustainable race-day confidence than any single source alone."}
{"chunk_id": "sport_psychology_expand_0499", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Dai et al. 2014 Manage Sci; Milkman et al. 2011 J Mark Res", "text": "Temporal landmarks and marathon motivation: research on temporal landmarks — specific dates or events that function as psychological 'fresh start' opportunities (New Year's, birthdays, Monday) — finds that marathon race registrations spike dramatically at temporal landmarks. Research by Dai et al. (2014, Manage Sci) confirmed that new health behaviors are disproportionately initiated at temporal landmarks. Marathon coaching systems can leverage these natural motivation peaks (new year, new month, birthday, spring) as optimal windows for initiating training cycle conversations and goal-setting."}
{"chunk_id": "sport_psychology_expand_0500", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "peer_reviewed_study", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Fredrickson 2001 Am Psychol; Tugade & Fredrickson 2004 J Pers Soc Psychol", "text": "Positive emotion generation strategies for hard training: research on positive emotion in endurance performance (Fredrickson's broaden-and-build theory) finds that positive emotions — even briefly experienced before or during challenging sessions — broaden attentional scope, increase creative problem-solving, and build psychological resources. Practical positive emotion generation strategies for hard training sessions: (1) gratitude activation before the session ('one thing I'm grateful for about this training'); (2) micro-accomplishment celebration during ('I just hit my km split — that felt good'); (3) post-session meaning reflection ('what did this session build?')."}
{"chunk_id": "sport_psychology_expand_0501", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "practitioner_coach_material", "prescription_permission": "explanation_only", "review_status": "approved", "evidence_weight": "moderate", "source_ref": "Taylor & Wilson 2005; practitioner synthesis", "text": "Final psychological readiness assessment for race week: a structured 10-question self-assessment for the week before a marathon, each rated 1–10: (1) I feel physically ready for this race; (2) I believe in my training; (3) I have a clear race plan; (4) I know what to do if things go wrong; (5) I feel connected to why this race matters; (6) I have managed my pre-race anxiety; (7) I feel rested and well-recovered; (8) My race logistics are fully prepared; (9) I have mentally rehearsed the race; (10) I am excited rather than dreading race day. Scores below 6 on items 2, 3, 4, 5, and 9 indicate specific preparation gaps warranting targeted intervention."}
{"chunk_id": "sport_psychology_expand_0502", "shard": "sport_psychology", "domain_terms": ["sport_psychology"], "quality_tier": "expert_review_narrative", "prescription_permission": "can_write_core", "review_status": "approved", "evidence_weight": "strong", "source_ref": "Tenenbaum & Eklund 2007 Handbook Sport Psychol; Vealey 2007", "text": "Closing reflection on sport psychology in marathon running: the accumulated research base in sport psychology supports a clear conclusion: marathon performance and training adherence are determined by the interaction of physiological preparation, psychological skill, and social context. Psychological skills — self-talk, imagery, attention management, goal-setting, anxiety regulation, coping flexibility — are as trainable as physiological capacities, take 8–12 weeks to develop, and produce measurable performance effects. The most impactful marathon coaching addresses the whole person: prepared body, prepared mind, supported spirit."}
