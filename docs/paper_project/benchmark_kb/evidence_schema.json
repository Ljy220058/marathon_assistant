{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STAI Benchmark Evidence Item",
  "type": "object",
  "required": [
    "evidence_id",
    "domain",
    "topic",
    "source_type",
    "source_title",
    "source_url_or_path",
    "quote",
    "supports_qids",
    "verification_status"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "description": "Stable evidence identifier, e.g. T12-E01."
    },
    "domain": {
      "type": "string",
      "description": "Domain label, e.g. endurance_training."
    },
    "topic": {
      "type": "string",
      "description": "Evidence topic, e.g. running_economy."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "academic_paper",
        "official_guideline",
        "textbook",
        "race_policy",
        "other"
      ]
    },
    "source_title": {
      "type": "string"
    },
    "source_url_or_path": {
      "type": "string"
    },
    "page": {
      "type": ["string", "number", "null"]
    },
    "section": {
      "type": ["string", "null"]
    },
    "quote": {
      "type": "string",
      "description": "Short verbatim quote or exact evidence span. Keep short for copyright safety."
    },
    "paraphrase": {
      "type": "string"
    },
    "supports_qids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_category": {
      "type": ["string", "null"]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "pending",
        "rejected"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
