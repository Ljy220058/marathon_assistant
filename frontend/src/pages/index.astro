---
import "../styles/global.css";

const quickActions = [
  {
    label: "生成完整计划",
    meta: "画像 + 比赛日",
    prompt: "请基于我的用户画像、当前周跑量、可训练日和目标比赛日期，生成一份结构化马拉松训练计划。请同时输出周计划、月历、每日强度区间、训练负荷摘要和关键训练解释。",
  },
  {
    label: "复核训练负荷",
    meta: "TL + 7日影响",
    prompt: "请复核当前训练计划的训练负荷安排，列出总负荷、7日负荷影响、42日基础体能、每周训练负荷变化，并标记可能过载或过低的训练日。",
  },
  {
    label: "本周降载调整",
    meta: "疲劳/恢复",
    prompt: "我最近疲劳偏高，请在尽量保留训练连续性的前提下，把本周训练调整为更保守的降载方案。请说明保留、降级、替换和取消的训练。",
  },
  {
    label: "解释单日训练",
    meta: "原因 + 替代",
    prompt: "请解释当前计划中最近一次关键训练为什么这样安排，包括训练目标、强度区间、训练负荷、风险提醒，以及如果当天状态不好应该怎么替代。",
  },
];

const migrationCards = [
  ["已迁移", "API 健康检查、快捷指令、训练问答、强度区间与证据分层"],
  ["本轮迁移", "结果摘要、自动存储、可点击日历、训练课详情"],
  ["继续迁移", "用户画像、证据预览、训练反馈表单、历史计划浏览"],
];

const profileFields = [
  ["goal", "目标", "半马完赛 / 全马 PB / 健康跑"],
  ["experience", "经验", "新手 / 进阶 / 有比赛经验"],
  ["weeklyMileage", "当前周跑量", "例如 35 km"],
  ["raceDate", "比赛日期", "例如 2026-10-18"],
  ["availableDays", "可训练日", "例如 周二、周四、周六、周日"],
  ["longRun", "最长训练", "例如 90 分钟或 16 km"],
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>马拉松助手工作台</title>
    <meta
      name="description"
      content="马拉松助手 Astro 新前端，逐步承接 Chainlit 旧前端能力。"
    />
  </head>
  <body>
    <div class="grid-background" aria-hidden="true"></div>
    <header class="top-nav">
      <a class="brand" href="#workspace" aria-label="马拉松助手首页">
        <span class="brand-mark">M</span>
        <span>Marathon Assistant</span>
      </a>
      <nav aria-label="主导航">
        <a href="#plan">训练计划</a>
        <a href="#profile">画像</a>
        <a href="#calendar-section">日历</a>
        <a href="#evidence">证据</a>
        <a href="#feedback-workbench">反馈</a>
      </nav>
      <div id="navHealth" class="nav-health">连接中</div>
    </header>

    <main id="workspace" class="workspace">
      <section class="hero-panel">
        <p class="eyebrow">Chainlit 能力迁移到 Astro 工作台</p>
        <h1>训练计划、解释证据和反馈闭环，放进一个更清爽的跑步控制台。</h1>
        <p class="hero-copy">
          保留现有 FastAPI / Chainlit 后端能力，先把旧前端里的常用入口迁移到新框架：快捷指令、训练计划、日历、强度区间和证据分层。
        </p>
        <div class="migration-grid" aria-label="迁移状态">
          {
            migrationCards.map(([title, body]) => (
              <article class="migration-card">
                <strong>{title}</strong>
                <span>{body}</span>
              </article>
            ))
          }
        </div>
      </section>

      <div class="app-layout">
        <aside class="side-rail" aria-label="快捷操作">
          <section class="panel rail-panel">
            <div class="panel-heading">
              <p class="section-kicker">Quick Actions</p>
              <h2>常用训练任务</h2>
            </div>
            <div class="quick-list">
              {
                quickActions.map((item) => (
                  <button class="quick-button" data-prompt={item.prompt}>
                    <span>
                      <strong>{item.label}</strong>
                      <small>{item.meta}</small>
                    </span>
                    <span class="quick-arrow">填入</span>
                  </button>
                ))
              }
            </div>
          </section>

          <section class="panel rail-panel">
            <div class="panel-heading">
              <p class="section-kicker">Connection</p>
              <h2>后端接口</h2>
            </div>
            <label class="field-label" for="apiBase">API Base</label>
            <input id="apiBase" value="http://127.0.0.1:8000" />
            <div id="health" class="status-note">等待连接</div>
          </section>

          <section id="feedback" class="panel rail-panel">
            <div class="panel-heading">
              <p class="section-kicker">Feedback</p>
              <h2>反馈预设</h2>
            </div>
            <div class="feedback-stack">
              <button class="ghost-button" data-feedback-preset data-completion="已完成" data-fatigue="轻微" data-pain="没有疼痛" data-sleep="良好" data-notes="训练完成度正常，主观疲劳轻微，没有疼痛。">
                完成良好
              </button>
              <button class="ghost-button" data-feedback-preset data-completion="已完成" data-fatigue="明显" data-pain="轻微不适" data-sleep="一般" data-notes="训练完成，但疲劳明显，恢复一般，希望降低下一次训练负荷。">
                今天偏累
              </button>
              <button class="ghost-button" data-feedback-preset data-completion="部分完成" data-fatigue="高疲劳" data-pain="疼痛风险" data-sleep="较差" data-notes="训练中出现不适或疼痛信号，请优先给出保守调整建议。">
                疼痛预警
              </button>
            </div>
          </section>

          <section class="panel rail-panel">
            <div class="panel-heading">
              <p class="section-kicker">History</p>
              <h2>历史计划</h2>
            </div>
            <div class="feedback-stack">
              <button id="savePlanDraft" class="ghost-button">保存当前计划快照</button>
              <button id="loadPlanDrafts" class="ghost-button">刷新本地历史</button>
            </div>
            <div id="historyList" class="compact-list">
              <div class="empty-state">暂无本地历史。</div>
            </div>
          </section>
        </aside>

        <section class="main-stack">
          <section id="plan" class="panel composer-panel">
            <div class="panel-heading split">
              <div>
                <p class="section-kicker">Command Center</p>
                <h2>训练问答与计划生成</h2>
              </div>
              <span class="pill">default_user</span>
            </div>
            <textarea
              id="queryInput"
              placeholder="输入你的训练问题，例如：帮我生成一个 12 周半马训练计划，并解释关键训练安排。"
            ></textarea>
            <div class="model-controls">
              <div class="model-switch">
                <span class="field-label">模型来源</span>
                <div class="model-toggle" role="group" aria-label="选择模型来源">
                  <button type="button" class="model-provider-button active" data-provider-choice="ollama">Ollama</button>
                  <button type="button" class="model-provider-button" data-provider-choice="ds">DeepSeek</button>
                </div>
              </div>
              <label>
                <span class="field-label">模型来源</span>
                <select id="llmProvider">
                  <option value="ollama">Ollama</option>
                  <option value="ds">DS API</option>
                </select>
              </label>
              <label>
                <span class="field-label">模型</span>
                <select id="llmModel">
                  <option value="qwen2.5:latest">qwen2.5:latest</option>
                </select>
              </label>
            </div>
            <div class="api-key-controls">
              <label>
                <span class="field-label">DeepSeek API Key</span>
                <input id="dsApiKey" type="password" placeholder="sk-..." autocomplete="off" />
              </label>
              <div class="api-key-actions">
                <button id="saveDsApiKey" type="button" class="secondary-button">保存 API Key</button>
                <button id="clearDsApiKey" type="button" class="secondary-button">清除</button>
              </div>
              <span id="dsApiKeyStatus" class="muted">仅保存在当前浏览器本地。</span>
            </div>
            <div class="toolbar">
              <div class="button-row">
                <button id="runQuery" class="primary-button">发送</button>
                <button id="loadMeta" class="secondary-button">刷新区间与证据</button>
                <button id="clearResult" class="secondary-button">清空</button>
              </div>
              <span id="queryHint" class="muted">Ctrl / ⌘ + Enter 可发送</span>
            </div>
          </section>

          <section class="dashboard-grid">
            <article class="panel report-panel">
              <div class="panel-heading split">
                <div>
                  <p class="section-kicker">Coach Output</p>
                  <h2>结果摘要</h2>
                </div>
                <span id="resultBadge" class="pill muted-pill">等待请求</span>
              </div>
              <div id="report" class="empty-state">还没有结果。先从左侧选择一个入口，或直接输入训练问题。</div>
            </article>

            <aside class="panel metrics-panel">
              <div class="panel-heading">
                <p class="section-kicker">Structured Signals</p>
                <h2>结构化信息</h2>
              </div>
              <div class="metric-grid">
                <div class="metric-card">
                  <span>Token</span>
                  <strong id="tokenUsage">-</strong>
                </div>
                <div class="metric-card">
                  <span>审计评分</span>
                  <strong id="auditScores">-</strong>
                </div>
                <div class="metric-card wide">
                  <span>引导问题</span>
                  <strong id="guidedQuestions">-</strong>
                </div>
              </div>
            </aside>
          </section>

          <section id="profile" class="panel">
            <div class="panel-heading split">
              <div>
                <p class="section-kicker">Profile Wizard</p>
                <h2>跑者画像草稿</h2>
              </div>
              <span id="profileStatus" class="pill muted-pill">用户画像</span>
            </div>
            <div class="profile-grid">
              {
                profileFields.map(([id, label, placeholder]) => (
                  <label class="profile-field" for={`profile-${id}`}>
                    <span>{label}</span>
                    <input id={`profile-${id}`} data-profile-field={id} placeholder={placeholder} />
                  </label>
                ))
              }
            </div>
            <div class="toolbar profile-toolbar">
              <div class="button-row">
                <button id="saveProfileDraft" class="secondary-button">保存画像草稿</button>
                <button id="buildProfilePrompt" class="secondary-button">生成画像提示</button>
                <button id="runProfilePlan" class="primary-button">基于画像生成计划</button>
              </div>
              <span class="muted">画像会用于生成训练计划、强度区间和训练安排解释。</span>
            </div>
          </section>

          <section id="calendar-section" class="panel">
            <div class="panel-heading split">
              <div>
                <p class="section-kicker">Training Calendar</p>
                <h2>训练日历</h2>
              </div>
              <span id="calendarCount" class="pill muted-pill">0 天</span>
            </div>
            <div id="loadSummary" class="load-summary-panel empty-state">
              训练负荷会在生成计划后显示。
            </div>
            <div id="calendar" class="calendar-grid">
              <div class="empty-state">计划生成后会在这里展示日历卡片。</div>
            </div>
            <div id="dayDetail" class="day-detail-panel">
              <div class="empty-state">点击日历中的某一天，查看热身、主课、冷身和引用证据。</div>
            </div>
          </section>

          <section id="feedback-workbench" class="panel">
            <div class="panel-heading split">
              <div>
                <p class="section-kicker">Feedback Loop</p>
                <h2>训练反馈表单</h2>
              </div>
              <span class="pill muted-pill">生成调整提示</span>
            </div>
            <div class="feedback-form">
              <label>
                <span>完成状态</span>
                <select id="feedbackCompletion">
                  <option value="已完成">已完成</option>
                  <option value="部分完成">部分完成</option>
                  <option value="未完成">未完成</option>
                </select>
              </label>
              <label>
                <span>主观疲劳</span>
                <select id="feedbackFatigue">
                  <option value="轻微">轻微</option>
                  <option value="中等">中等</option>
                  <option value="明显">明显</option>
                  <option value="高疲劳">高疲劳</option>
                </select>
              </label>
              <label>
                <span>疼痛/不适</span>
                <select id="feedbackPain">
                  <option value="没有疼痛">没有疼痛</option>
                  <option value="轻微不适">轻微不适</option>
                  <option value="疼痛风险">疼痛风险</option>
                </select>
              </label>
              <label>
                <span>睡眠恢复</span>
                <select id="feedbackSleep">
                  <option value="良好">良好</option>
                  <option value="一般">一般</option>
                  <option value="较差">较差</option>
                </select>
              </label>
              <label class="wide">
                <span>补充说明</span>
                <textarea id="feedbackNotes" placeholder="例如：后半程心率偏高，第二天小腿紧张。"></textarea>
              </label>
            </div>
            <div class="toolbar">
              <div class="button-row">
                <button id="composeFeedbackPrompt" class="primary-button">生成反馈调整提示</button>
                <button id="submitFeedbackApi" class="secondary-button">提交到调整接口</button>
                <button id="clearFeedback" class="secondary-button">清空反馈</button>
              </div>
              <span class="muted">提交后会调用后端反馈接口，并把恢复、疼痛和疲劳状态纳入后续计划调整。</span>
            </div>
          </section>

          <section id="evidence" class="reference-grid">
            <article class="panel">
              <div class="panel-heading">
                <p class="section-kicker">Intensity</p>
                <h2>强度区间</h2>
              </div>
              <div id="zones" class="chip-grid">
                <div class="empty-state">未加载</div>
              </div>
            </article>
            <article class="panel">
              <div class="panel-heading">
                <p class="section-kicker">Evidence</p>
                <h2>证据分层</h2>
              </div>
              <div id="tiers" class="chip-grid">
                <div class="empty-state">未加载</div>
              </div>
            </article>
          </section>

          <section class="panel">
            <div class="panel-heading split">
              <div>
                <p class="section-kicker">Evidence Preview</p>
                <h2>证据预览</h2>
              </div>
              <span id="evidenceCount" class="pill muted-pill">0 条</span>
            </div>
            <div id="evidencePreview" class="evidence-list">
              <div class="empty-state">生成计划后，会从返回结果中提取证据编号、证据层级和来源摘要。</div>
            </div>
          </section>
        </section>
      </div>
    </main>

    <script is:inline>
      const state = {
        apiBase: "http://127.0.0.1:8000",
        lastResponse: null,
      };

      const $ = (id) => document.getElementById(id);
      const apiBaseInput = $("apiBase");
      const queryInput = $("queryInput");
      const llmProviderInput = $("llmProvider");
      const llmModelInput = $("llmModel");
      const providerButtons = Array.from(document.querySelectorAll("[data-provider-choice]"));
      const dsApiKeyInput = $("dsApiKey");
      const saveDsApiKeyButton = $("saveDsApiKey");
      const clearDsApiKeyButton = $("clearDsApiKey");
      const dsApiKeyStatus = $("dsApiKeyStatus");
      const healthBox = $("health");
      const navHealth = $("navHealth");
      const reportBox = $("report");
      const resultBadge = $("resultBadge");
      const calendarBox = $("calendar");
      const dayDetailBox = $("dayDetail");
      const loadSummaryBox = $("loadSummary");
      const calendarCount = $("calendarCount");
      const tokenUsageBox = $("tokenUsage");
      const auditScoresBox = $("auditScores");
      const guidedQuestionsBox = $("guidedQuestions");
      const zonesBox = $("zones");
      const tiersBox = $("tiers");
      const profileStatus = $("profileStatus");
      const evidencePreview = $("evidencePreview");
      const evidenceCount = $("evidenceCount");
      const historyList = $("historyList");

      function getApiBase() {
        return (apiBaseInput.value || state.apiBase).replace(/\/$/, "");
      }

      function escapeHtml(value) {
        return String(value ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function text(value, fallback = "-") {
        const normalized = String(value ?? "").trim();
        return normalized || fallback;
      }

      function setEmpty(el, message) {
        el.className = "empty-state";
        el.textContent = message;
      }

      function setBusy(message) {
        reportBox.className = "loading-state";
        reportBox.textContent = message;
        resultBadge.textContent = "处理中";
      }

      async function apiFetch(path, options = {}) {
        const response = await fetch(`${getApiBase()}${path}`, {
          headers: {
            "Content-Type": "application/json",
            ...(options.headers || {}),
          },
          ...options,
        });
        if (!response.ok) {
          let detail = `${response.status} ${response.statusText}`;
          try {
            const payload = await response.json();
            detail = payload.detail || detail;
          } catch {}
          throw new Error(detail);
        }
        return response.json();
      }

      function renderHealth(status, model, provider, error) {
        if (error) {
          healthBox.className = "status-note error";
          navHealth.className = "nav-health error";
          healthBox.textContent = `离线：${error}`;
          navHealth.textContent = "API 离线";
          return;
        }
        healthBox.className = "status-note ok";
        navHealth.className = "nav-health ok";
        healthBox.textContent = `在线：${status} / ${provider || "unknown"} / ${model || "unknown"}`;
        navHealth.textContent = "API 在线";
      }

      async function loadLlmOptions() {
        try {
          const data = await apiFetch("/llm-options");
          const providers = Array.isArray(data.providers) ? data.providers : [];
          if (providers.length) {
            llmProviderInput.innerHTML = providers
              .map((item) => `<option value="${escapeHtml(item.id)}">${escapeHtml(item.label || item.id)}</option>`)
              .join("");
          }
          const defaultsByProvider = {};
          const modelsByProvider = {};
          providers.forEach((item) => {
            defaultsByProvider[item.id] = item.default_model || "";
            modelsByProvider[item.id] = Array.isArray(item.models) ? item.models : [item.default_model].filter(Boolean);
          });
          const savedProvider = localStorage.getItem("marathon_llm_provider");
          const savedModel = localStorage.getItem("marathon_llm_model");
          llmProviderInput.value = savedProvider || data.default?.provider || "ollama";
          llmProviderInput.dataset.defaults = JSON.stringify(defaultsByProvider);
          llmProviderInput.dataset.models = JSON.stringify(modelsByProvider);
          renderModelOptions(savedModel || data.default?.model || defaultsByProvider[llmProviderInput.value] || "");
        } catch (error) {
          llmProviderInput.value = localStorage.getItem("marathon_llm_provider") || "ollama";
          llmProviderInput.dataset.models = JSON.stringify({
            ollama: ["qwen2.5:latest"],
            ds: ["deepseek-v4-pro"],
          });
          llmProviderInput.dataset.defaults = JSON.stringify({
            ollama: "qwen2.5:latest",
            ds: "deepseek-v4-pro",
          });
          renderModelOptions(localStorage.getItem("marathon_llm_model") || "");
        }
      }

      function renderModelOptions(preferredModel = "") {
        const modelsByProvider = JSON.parse(llmProviderInput.dataset.models || "{}");
        const defaultsByProvider = JSON.parse(llmProviderInput.dataset.defaults || "{}");
        const provider = llmProviderInput.value || "ollama";
        const models = modelsByProvider[provider] || [defaultsByProvider[provider] || "qwen2.5:latest"];
        const selected = preferredModel && models.includes(preferredModel)
          ? preferredModel
          : (defaultsByProvider[provider] || models[0] || "");
        llmModelInput.innerHTML = models
          .map((model) => `<option value="${escapeHtml(model)}">${escapeHtml(model)}</option>`)
          .join("");
        llmModelInput.value = selected;
        syncProviderButtons();
      }

      function syncProviderButtons() {
        providerButtons.forEach((button) => {
          button.classList.toggle("active", button.dataset.providerChoice === llmProviderInput.value);
        });
      }

      function formatTokenUsage(tokenUsage) {
        if (!tokenUsage) return "-";
        const total = tokenUsage.total_tokens ?? 0;
        const prompt = tokenUsage.prompt_tokens ?? 0;
        const completion = tokenUsage.completion_tokens ?? 0;
        return `总 ${total} / 提示 ${prompt} / 输出 ${completion}`;
      }

      function formatAuditScores(auditScores) {
        if (!auditScores) return "-";
        const parts = [
          ["一致性", auditScores.consistency],
          ["安全", auditScores.safety],
          ["ROI", auditScores.roi],
        ];
        return parts.map(([label, value]) => `${label} ${value ?? "-"}`).join(" · ");
      }

      function renderQuestions(questions) {
        if (!Array.isArray(questions) || !questions.length) return "-";
        return questions.slice(0, 3).map((item) => `• ${item}`).join("\n");
      }

      function getStructuredReport(response) {
        return response?.structured_report || {};
      }

      function getStructuredPlan(response) {
        return response?.structured_training_plan || getStructuredReport(response).structured_training_plan || {};
      }

      function getCalendar(response) {
        const report = getStructuredReport(response);
        return response?.monthly_training_calendar || report.monthly_training_calendar || {};
      }

      function numberValue(value, fallback = 0) {
        const parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : fallback;
      }

      function formatLoad(value) {
        const parsed = numberValue(value, 0);
        return String(Math.round(parsed));
      }

      function formatDuration(value) {
        const parsed = numberValue(value, 0);
        return parsed > 0 ? `${Math.round(parsed)} min` : "-";
      }

      function getTrainingLoadSummary(response) {
        const report = getStructuredReport(response);
        const calendar = getCalendar(response);
        const plan = getStructuredPlan(response);
        return (
          response?.training_load_summary ||
          report.training_load_summary ||
          calendar.training_load_summary ||
          plan.training_load_summary ||
          {}
        );
      }

      function getDailyCards(response) {
        const report = getStructuredReport(response);
        return response?.daily_schedule_cards || report.daily_schedule_cards || [];
      }

      function getWeekPlanDays(response) {
        const plan = getStructuredPlan(response);
        const rows = [];
        (plan.week_plans || []).forEach((week) => {
          (week.days || []).forEach((day, index) => {
            rows.push({
              ...day,
              week_index: week.week_index,
              day_index: day.day_index || index + 1,
              phase: week.phase,
              load_level: week.load_level,
              week_goal: week.week_goal,
            });
          });
        });
        return rows;
      }

      function cleanEvidenceLabel(value) {
        const raw = String(value || "").trim();
        if (!raw) return "训练依据";
        const map = {
          action_library: "动作库证据",
          kb_fallback: "训练资料支持",
          plan_only: "计划规则",
          saved_plan: "已保存计划",
          training_explanation: "训练解释",
          source: "来源",
        };
        return map[raw] || raw
          .replace(/参考知识库生成/g, "")
          .replace(/知识库生成/g, "")
          .replace(/参考知识库/g, "训练资料")
          .trim() || "训练依据";
      }

      function getProfileDraft() {
        const draft = {};
        document.querySelectorAll("[data-profile-field]").forEach((input) => {
          draft[input.dataset.profileField] = input.value.trim();
        });
        return draft;
      }

      function profileDraftToApi(draft) {
        return {
          goal: draft.goal || "",
          experience_level: draft.experience || "",
          weekly_mileage: draft.weeklyMileage || "",
          target_race_date: draft.raceDate || "",
          available_days: draft.availableDays || "",
          max_session_minutes: draft.longRun || "",
        };
      }

      function profileApiToDraft(profile) {
        return {
          goal: profile.goal || "",
          experience: profile.experience_level || profile.experience || "",
          weeklyMileage: profile.weekly_mileage || "",
          raceDate: profile.target_race_date || "",
          availableDays: Array.isArray(profile.available_days)
            ? profile.available_days.join("、")
            : profile.available_days || "",
          longRun: profile.max_session_minutes || profile.long_run || "",
        };
      }

      function fillProfileDraft(draft) {
        document.querySelectorAll("[data-profile-field]").forEach((input) => {
          input.value = draft[input.dataset.profileField] || "";
        });
      }

      function profileDraftToPrompt(draft) {
        const lines = [
          "请基于以下跑者画像生成训练计划，并明确说明关键训练安排的原因：",
          `- 目标：${draft.goal || "未填写"}`,
          `- 经验：${draft.experience || "未填写"}`,
          `- 当前周跑量：${draft.weeklyMileage || "未填写"}`,
          `- 比赛日期：${draft.raceDate || "未填写"}`,
          `- 可训练日：${draft.availableDays || "未填写"}`,
          `- 最长训练：${draft.longRun || "未填写"}`,
          "请输出结构化周计划、训练日历、强度区间、关键解释和证据来源。",
        ];
        return lines.join("\n");
      }

      async function saveProfileDraft() {
        const draft = getProfileDraft();
        localStorage.setItem("marathon-profile-draft", JSON.stringify(draft));
        try {
          await apiFetch("/profile", {
            method: "POST",
            body: JSON.stringify({
              user_id: "default_user",
              profile: profileDraftToApi(draft),
            }),
          });
          profileStatus.textContent = "已同步";
        } catch {
          profileStatus.textContent = "已本地保存";
        }
      }

      async function loadProfileDraft() {
        try {
          const payload = await apiFetch("/profile");
          fillProfileDraft(profileApiToDraft(payload.profile || {}));
          profileStatus.textContent = "来自 API";
          return;
        } catch {}

        const raw = localStorage.getItem("marathon-profile-draft");
        if (!raw) return;
        try {
          const draft = JSON.parse(raw);
          fillProfileDraft(draft);
          profileStatus.textContent = "已载入";
        } catch {
