---
import "../styles/journal.css";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>登录 - 马拉松助手</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23090b10'/%3E%3Cpath d='M14 42c11-18 20-24 36-24M20 44h27' stroke='%2322d3ee' stroke-width='6' stroke-linecap='round' fill='none'/%3E%3Ccircle cx='20' cy='22' r='5' fill='%23f6f7fb'/%3E%3C/svg%3E" />
  </head>
  <body class="theme-ink">
    <div class="login-shell">
      <header class="journal-topbar" style="position:static;">
        <div class="journal-brand">
          <div class="journal-brand-mark">M</div>
          <div class="journal-brand-copy">
            <strong>马拉松助手</strong>
          </div>
        </div>
      </header>

      <div class="login-center">
        <article class="journal-card journal-card-pad login-card">

          <div class="login-hero">
            <p class="journal-section-kicker">账号</p>
            <h1 id="heroTitle">欢迎回来</h1>
            <p class="login-subtitle" id="heroSubtitle">输入账号密码登录</p>
          </div>

          <!-- 模式切换 -->
          <div class="login-tab-row">
            <button class="login-tab is-active" id="tabLogin" type="button">登录</button>
            <button class="login-tab" id="tabRegister" type="button">注册</button>
          </div>

          <!-- ── 登录面板 ───────────────────────────────── -->
          <div id="panelLogin">
            <label class="journal-field">
              <span>邮箱</span>
              <input class="journal-input" id="loginEmail" type="email" placeholder="your@email.com" autocomplete="email" />
            </label>
            <label class="journal-field" style="margin-top:12px;">
              <span>密码</span>
              <input class="journal-input" id="loginPassword" type="password" placeholder="请输入密码" autocomplete="current-password" />
            </label>
            <div id="loginError" class="login-error" hidden></div>
            <div style="margin-top:16px;">
              <button class="journal-btn primary login-btn-full" id="loginBtn" type="button">登录</button>
            </div>
          </div>

          <!-- ── 注册面板 ───────────────────────────────── -->
          <div id="panelRegister" hidden>

            <!-- 步骤 1：填写邮箱 + 密码 -->
            <div id="regStep1">
              <label class="journal-field">
                <span>邮箱</span>
                <input class="journal-input" id="regEmail" type="email" placeholder="your@email.com" autocomplete="email" />
              </label>
              <label class="journal-field" style="margin-top:12px;">
                <span>密码</span>
                <input class="journal-input" id="regPassword" type="password" placeholder="至少 6 位" autocomplete="new-password" />
              </label>
              <label class="journal-field" style="margin-top:12px;">
                <span>确认密码</span>
                <input class="journal-input" id="regPasswordConfirm" type="password" placeholder="再次输入密码" autocomplete="new-password" />
              </label>
              <div id="regStep1Error" class="login-error" hidden></div>
              <div style="margin-top:16px;">
                <button class="journal-btn primary login-btn-full" id="sendCodeBtn" type="button">发送验证码</button>
              </div>
            </div>

            <!-- 步骤 2：输入验证码 -->
            <div id="regStep2" hidden>
              <p class="login-hint" id="regCodeHint"></p>
              <label class="journal-field">
                <span>邮箱验证码</span>
                <input
                  class="journal-input login-code-input"
                  id="regCode"
                  type="text"
                  inputmode="numeric"
                  pattern="[0-9]*"
                  maxlength="6"
                  placeholder="6 位数字"
                  autocomplete="one-time-code"
                />
              </label>
              <div id="regStep2Error" class="login-error" hidden></div>
              <div class="journal-action-row end" style="margin-top:16px;">
                <button class="journal-btn" id="resendBtn" type="button" disabled>
                  重新发送 (<span id="countdown">60</span>s)
                </button>
                <button class="journal-btn primary" id="registerBtn" type="button">完成注册</button>
              </div>
            </div>

          </div>

        </article>
      </div>
    </div>

    <script>
      const API_CANDIDATES = [
        "http://127.0.0.1:8000",
        "http://127.0.0.1:8001",
        "http://127.0.0.1:8010",
        "http://127.0.0.1:8011",
      ];
      const AUTH_KEY = "journal-ink-auth-v1";

      let detectedBase = null;
      let regEmail = "";
      let regPassword = "";
      let resendTimer = null;

      // 已登录则直接跳首页
      try {
        const existing = JSON.parse(localStorage.getItem(AUTH_KEY) || "null");
        if (existing?.token) window.location.replace("/");
      } catch {}

      // ── API base 探测 ───────────────────────────
      async function getBase() {
        if (detectedBase) return detectedBase;
        for (const base of API_CANDIDATES) {
          try {
            const r = await fetch(`${base}/health`, { signal: AbortSignal.timeout(2500) });
            if (r.ok) { detectedBase = base; return base; }
          } catch {}
        }
        return API_CANDIDATES[0];
      }

      // ── UI 辅助 ─────────────────────────────────
      function showError(id, msg) {
        const el = document.getElementById(id);
        if (!el) return;
        el.textContent = msg;
        el.hidden = false;
      }
      function hideError(id) {
        const el = document.getElementById(id);
        if (el) { el.hidden = true; el.textContent = ""; }
      }
      function setBusy(btnId, busy, idle, loading) {
        const btn = document.getElementById(btnId);
        if (!btn) return;
        btn.disabled = busy;
        btn.textContent = busy ? loading : idle;
      }
      function saveAndRedirect(data, email) {
        localStorage.setItem(AUTH_KEY, JSON.stringify({
          token: data.api_token,
          user_id: data.user_id,
          display_name: data.display_name,
          email,
        }));
        const next = new URLSearchParams(window.location.search).get("next");
        window.location.replace(next && next.startsWith("/") && !next.startsWith("//") ? next : "/");
      }

      // ── 标签切换 ────────────────────────────────
      document.getElementById("tabLogin").addEventListener("click", () => switchTab("login"));
      document.getElementById("tabRegister").addEventListener("click", () => switchTab("register"));

      function switchTab(tab) {
        const isLogin = tab === "login";
        document.getElementById("tabLogin").classList.toggle("is-active", isLogin);
        document.getElementById("tabRegister").classList.toggle("is-active", !isLogin);
        document.getElementById("panelLogin").hidden = !isLogin;
        document.getElementById("panelRegister").hidden = isLogin;
        document.getElementById("heroTitle").textContent = isLogin ? "欢迎回来" : "创建账号";
        document.getElementById("heroSubtitle").textContent = isLogin ? "输入账号密码登录" : "用邮箱验证码注册，仅需一次";
        hideError("loginError");
        hideError("regStep1Error");
        hideError("regStep2Error");
      }

      // ── 登录 ────────────────────────────────────
      async function doLogin() {
        const email = document.getElementById("loginEmail").value.trim();
        const password = document.getElementById("loginPassword").value;
        if (!email) { showError("loginError", "请输入邮箱"); return; }
        if (!password) { showError("loginError", "请输入密码"); return; }
        hideError("loginError");
        setBusy("loginBtn", true, "登录", "登录中…");
        try {
          const base = await getBase();
          const r = await fetch(`${base}/auth/login`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, password }),
          });
          const data = await r.json();
          if (!data.success) { showError("loginError", data.message || "登录失败"); return; }
          saveAndRedirect(data, email);
        } catch {
          showError("loginError", "无法连接服务器，请确认后端已启动");
        } finally {
          setBusy("loginBtn", false, "登录", "登录中…");
        }
      }

      // ── 注册：发送验证码 ─────────────────────────
      async function sendCode() {
        const email = document.getElementById("regEmail").value.trim();
        const pwd = document.getElementById("regPassword").value;
        const confirm = document.getElementById("regPasswordConfirm").value;
        if (!email) { showError("regStep1Error", "请输入邮箱"); return; }
        if (pwd.length < 6) { showError("regStep1Error", "密码至少 6 位"); return; }
        if (pwd !== confirm) { showError("regStep1Error", "两次密码不一致"); return; }
        hideError("regStep1Error");
        setBusy("sendCodeBtn", true, "发送验证码", "发送中…");
        try {
          const base = await getBase();
          const r = await fetch(`${base}/auth/send-code`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ target: email, channel: "email", purpose: "register" }),
          });
          const data = await r.json();
          if (!data.success) { showError("regStep1Error", data.message || "发送失败"); return; }
          regEmail = email;
          regPassword = pwd;
          document.getElementById("regStep1").hidden = true;
          document.getElementById("regStep2").hidden = false;
          document.getElementById("regCodeHint").textContent = `验证码已发送至 ${email}，请检查收件箱`;
          document.getElementById("regCode").focus();
          startCountdown(60);
        } catch {
          showError("regStep1Error", "无法连接服务器，请确认后端已启动");
        } finally {
          setBusy("sendCodeBtn", false, "发送验证码", "发送中…");
        }
      }

      // ── 注册：验证码 + 完成注册 ──────────────────
      async function doRegister() {
        const code = document.getElementById("regCode").value.trim();
        if (code.length < 4) { showError("regStep2Error", "请输入完整验证码"); return; }
        hideError("regStep2Error");
        setBusy("registerBtn", true, "完成注册", "注册中…");
        try {
          const base = await getBase();
          const r = await fetch(`${base}/auth/verify`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              target: regEmail,
              channel: "email",
              purpose: "register",
              code,
              password: regPassword,
            }),
          });
          const data = await r.json();
          if (!data.success) { showError("regStep2Error", data.message || "注册失败"); return; }
          saveAndRedirect(data, regEmail);
        } catch {
          showError("regStep2Error", "注册失败，请稍后重试");
        } finally {
          setBusy("registerBtn", false, "完成注册", "注册中…");
        }
      }

      // ── 倒计时 ──────────────────────────────────
      function startCountdown(sec) {
        let left = sec;
        const span = document.getElementById("countdown");
        const btn = document.getElementById("resendBtn");
        clearInterval(resendTimer);
        btn.disabled = true;
        btn.textContent = `重新发送 (${left}s)`;
        resendTimer = setInterval(() => {
          left--;
          btn.textContent = `重新发送 (${left}s)`;
          if (left <= 0) {
            clearInterval(resendTimer);
            btn.disabled = false;
            btn.textContent = "重新发送";
          }
        }, 1000);
      }

      // ── 事件绑定 ────────────────────────────────
      document.getElementById("loginBtn").addEventListener("click", doLogin);
      document.getElementById("sendCodeBtn").addEventListener("click", sendCode);
      document.getElementById("registerBtn").addEventListener("click", doRegister);
      document.getElementById("resendBtn").addEventListener("click", () => {
        document.getElementById("regStep2").hidden = true;
        document.getElementById("regStep1").hidden = false;
        sendCode();
      });
      document.getElementById("loginEmail").addEventListener("keydown", (e) => { if (e.key === "Enter") doLogin(); });
      document.getElementById("loginPassword").addEventListener("keydown", (e) => { if (e.key === "Enter") doLogin(); });
      document.getElementById("regCode").addEventListener("keydown", (e) => { if (e.key === "Enter") doRegister(); });
    </script>
  </body>
</html>
