# ============================================================
# 马拉松助手 — 环境变量清单
# 复制此文件为 .env 并填入实际值后启动服务。
# ============================================================

# ---- LLM Provider ----
# 主 LLM provider: ollama / ds (DeepSeek) / openai
LLM_PROVIDER=ollama
LLM_TIMEOUT_SEC=60

# ---- Ollama (本地) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
# 嵌入模型 (用于 FAISS 向量库)
# EMBEDDING_MODEL=bge-m3

# ---- DeepSeek ----
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_MODEL=deepseek-v4-pro

# ---- OpenAI Compatible ----
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxxx
# OPENAI_MODEL=gpt-5.5

# ---- 知识图谱 (GraphRAG) ----
# 生产环境必须设置真实 token，为空则知识图谱初始化为空图并降级运行
GRAPHRAG_API_KEY=

# ---- API 认证 ----
# 留空则不启用 API token 校验 (开发模式)
# MARATHON_API_TOKEN=your-secret-token
# 专家模式 token (可访问专家诊断面板)
# MARATHON_EXPERT_API_TOKEN=expert-secret-token

# ---- 数据加密 ----
# Fernet 密钥，用于加密 OAuth token 和用户画像
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MARATHON_FERNET_KEY=

# ---- 数据路径 ----
# 数据根目录 (默认: 项目根/data)
# MARATHON_DATA_DIR=/path/to/data
# 运行时数据 (SQLite、Google 凭据等)
# MARATHON_RUNTIME_DATA_DIR=/path/to/runtime

# ---- 速率限制 ----
# 每分钟最大请求数 (仅限 POST/PUT/PATCH/DELETE)
# MARATHON_RATE_LIMIT_PER_MINUTE=600

# ---- CORS ----
# 开发模式允许所有来源
# MARATHON_DEV_PERMISSIVE_CORS=1
# 生产环境指定允许的来源 (逗号分隔)
# MARATHON_ALLOWED_ORIGINS=https://your-domain.com

# ---- 日志 ----
# 设为 0 可在日志中脱敏客户端 IP
# MARATHON_LOG_CLIENT_IP=1

# ---- 信任代理头 ----
# 部署在反向代理后时设为 1，使用 X-Forwarded-For 作为客户端 IP
# MARATHON_TRUST_PROXY_HEADERS=1

# ---- 前端 ----
# Astro 开发服务器端口 (默认 4321)
# ASTRO_PORT=4321
# 后端 API 地址 (前端代理目标)
# MARATHON_API_BASE_URL=http://localhost:8000
